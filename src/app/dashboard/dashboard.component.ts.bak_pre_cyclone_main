  private justDragged = false;

  routeToDept(deptName: string): void {
    if (this.justDragged) {
      this.justDragged = false;
      return;
    }
    if (deptName === 'E Logs') {
      this.router.navigate(['/equipmentusage']);
      return;
    }

    this.allValid = false;
    const rightsList = this.rights || [];

    for (let i = 0; i < rightsList.length; i++) {
      const row = rightsList[i];
      if (this.rightsDepartmentMatches(row.department, deptName, row)) {
        if (deptName === 'master' || deptName === 'E Logs' || this.rightsRowAllowsDeptAccess(row)) {
          this.allValid = true;
          break;
        }
      }
      if (deptName === 'Plant Head' && this.isYesFlag(this.plant_head)) {
        this.allValid = true;
        break;
      }
      if (deptName === 'Q-Head' && this.isYesFlag(this.quality_head)) {
        this.allValid = true;
        break;
      }
      if ((deptName === 'R AND D' || deptName === 'NPD') && this.isYesFlag(this.quality_head)) {
        this.allValid = true;
        break;
      }
      if (deptName === 'Day Store' && rightsList[i].department === 'Store') {
        this.allValid = true;
        break;
      }
    }

    if (deptName === 'Plant Head' && this.isYesFlag(this.plant_head)) this.allValid = true;
    if ((deptName === 'R AND D' || deptName === 'NPD') && this.isYesFlag(this.quality_head)) this.allValid = true;
    if (deptName === 'master') this.allValid = true;

    if (!this.allValid) {
      alertify.error('Access Denied');
      return;
    }

    const navMap: Record<string, string> = {
      'Plant Head': '/plant_head',
      'master': '/master',
      'Exports': '/Exports',
      'Management': '/management',
      'Admin': '/admin',
      'Account': '/accounts',
      'Marketing': '/marketing',
      'Purchase': '/purchase',
      'Human Resource': '/hr',
      'Regulatory': '/regulatory',
      'Security': '/security',
      'Planning': '/planning',
      'Production': '/fproduction',
      'Packing': '/packing',
      'Quality Control': '/qc',
      'Quality Assurance': '/qa',
      'Engineering': '/engineering',
      'IT': '/it',
      'EHS': '/ehs',
      'Store': '/store',
      'Enginering Store': '/engi-store',
      'Day Store': '/daystore',
      'Dispatch': '/dispatch',
      'R AND D': '/rnd',
      'NPD': '/npd',
      'Reception': '/reception',
      'Q-Head': '/qhead',
    };
 
    const path = navMap[deptName];
    if (path) {
      if (deptName === 'master') {
        const plant_id = localStorage.getItem('plant_id');
           this.router.navigate(['/master']);
      } else if (deptName === 'Day Store') {
        this.setDept('Store');
        this.router.navigate([path]);
      } else {
        if (deptName !== 'Plant Head' && deptName !== 'master') this.setDept(deptName);
        this.router.navigate([path]);
      }
    } else {
      alertify.error('Please Contact Admin..');
    }
    this.allValid = false;
  }

  setDept(dept: string): void {
    localStorage.setItem('department', dept);
