@import "../../hr/dashboard/dashboard.component.css";

/* Master hub — compact tiles, full titles, department grade separation */
.grade-section {
  margin-bottom: 14px;
}

.grade-section:last-child {
  margin-bottom: 0;
}

.grade-section__head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 8px;
  padding: 6px 10px;
  border-radius: 8px;
  background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  border: 1px solid #cbd5e1;
}

.grade-section__icon {
  width: 26px;
  height: 26px;
  border-radius: 7px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  color: #ffffff;
  font-size: 11px;
  flex-shrink: 0;
}

.grade-section__title {
  font-size: 12px;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: 0.02em;
  flex: 1;
  min-width: 0;
  white-space: normal;
  line-height: 1.3;
}

.grade-section__count {
  min-width: 22px;
  height: 22px;
  padding: 0 6px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 1px solid #cbd5e1;
  color: #475569;
  font-size: 10px;
  font-weight: 700;
  flex-shrink: 0;
}

.tiles-grid--compact {
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 8px;
}

.tile-card--compact {
  padding: 8px 10px;
  gap: 8px;
  border-radius: 10px;
  align-items: center;
}

.tile-card--compact::before {
  width: 3px;
}

.icon-wrap--compact {
  width: 36px;
  height: 36px;
  min-width: 36px;
  border-radius: 9px;
  font-size: 14px;
  box-shadow: 0 6px 14px rgba(15, 23, 42, 0.16);
}

.tile-title--full {
  font-size: 12px;
  font-weight: 700;
  line-height: 1.35;
  white-space: normal;
  overflow: visible;
  text-overflow: unset;
  word-break: break-word;
}

.compact-nav-item span {
  white-space: normal;
  overflow: visible;
  text-overflow: unset;
  line-height: 1.3;
}

.compact-sidebar {
  width: 100%;
}

.compact-layout {
  grid-template-columns: 220px minmax(0, 1fr);
  gap: 12px;
}

.compact-sidebar__tabs {
  gap: 6px;
}

.compact-nav-item {
  padding: 7px 9px;
  font-size: 11px;
  gap: 7px;
}

.compact-main {
  padding: 10px 12px 12px;
}

.section-label {
  font-size: 12px;
  margin-bottom: 8px;
}

@media (max-width: 1100px) {
  .tiles-grid--compact {
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }
}

@media (max-width: 768px) {
  .tiles-grid--compact {
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 7px;
  }

  .tile-card--compact {
    grid-template-columns: auto 1fr;
    text-align: left;
    padding: 8px;
  }

  .icon-wrap--compact {
    margin: 0;
  }
}
