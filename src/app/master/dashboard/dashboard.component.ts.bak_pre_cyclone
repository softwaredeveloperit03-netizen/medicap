    }
  }

  ngOnInit(): void {
    this.loadProductRouteBySoftwareType();
    const savedPalette = localStorage.getItem('master_dashboard_palette');
    if (savedPalette) {
      const found = this.paletteOptions.find((p) => p.name === savedPalette);
      if (found) {
        this.selectedPalette = found;
      }
    }
    try {
      const savedDept = localStorage.getItem('master_dashboard_department');
      if (savedDept === 'all') {
        this.selectedDepartmentId = 'all';
      } else if (savedDept && this.departments.some((d) => d.id === savedDept)) {
        this.selectedDepartmentId = savedDept;
      }
    } catch {
      /* ignore */
    }
    this.route.queryParamMap.subscribe((params) => {
      const fromQuery = params.get('dept');
      if (fromQuery === 'all') {
        this.selectedDepartmentId = 'all';
        try {
          localStorage.setItem('master_dashboard_department', 'all');
        } catch {
          /* ignore */
        }
      } else if (fromQuery && this.departments.some((d) => d.id === fromQuery)) {
        this.selectedDepartmentId = fromQuery;
        try {
          localStorage.setItem('master_dashboard_department', fromQuery);
        } catch {
          /* ignore */
        }
      }
    });
