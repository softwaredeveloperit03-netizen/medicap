  /** Call before navigating to a linked master so Close can return to this department tab */
  registerMasterReturn(deptId: string): void {
    this.masterHubReturn.setReturnDepartment(deptId);
  }

  private normalizeSoftwareType(value: any): 'API' | 'Formulation' | '' {
    const s = String(value || '').trim().toLowerCase();
    if (s === 'api') {
      return 'API';
    }
    if (s === 'formulation') {
      return 'Formulation';
    }
    return '';
  }

  private setProductCardRouteBySoftwareType(type: 'API' | 'Formulation' | ''): void {
    const productCard = this.managementCards.find((c) => c.id === 'product');
    if (!productCard) {
      return;
    }
    productCard.route =
      type === 'Formulation' ? this.productFormulationRoute : this.productDefaultRoute;
  }

  private loadProductRouteBySoftwareType(): void {
    const plantId = String(localStorage.getItem('plant_id') || '').trim();
    this.service
      .get('qa/custimize.php?type=getSoftware_restrication_dep&dep_name=Master&module=Form Customisation')
      .subscribe({
        next: (response: any) => {
          const rows = Array.isArray(response) ? response : [];
          const filtered = rows
            .filter((r) => String(r?.param_label || '').trim() === 'Software Type')
            .filter((r) => !plantId || String(r?.plant_id || '').trim() === plantId)
            .sort((a, b) => (Number(b?.id) || 0) - (Number(a?.id) || 0));
          const selectedType = filtered.length
            ? this.normalizeSoftwareType(filtered[0]?.param_value)
            : '';
          this.setProductCardRouteBySoftwareType(selectedType);
        },
        error: () => {
          this.setProductCardRouteBySoftwareType('');
        },
      });
  }

  /** Leaving Master hub via header Close — do not force return to hub from other modules */
  onLeaveMasterHub(): void {
    this.masterHubReturn.clearReturnDepartment();
  }

  @HostListener('window:resize')
  onResize(): void {
    if (this.windowWidth() >= this.sidebarBreakpointPx) {
      this.mobileSidebarOpen = false;
    }
  }

  private windowWidth(): number {
    return typeof window !== 'undefined' ? window.innerWidth : this.sidebarBreakpointPx;
  }

  get isNarrowViewport(): boolean {
    return this.windowWidth() < this.sidebarBreakpointPx;
  }

  get currentDepartment(): MasterDepartment | undefined {
    return this.departments.find((d) => d.id === this.selectedDepartmentId);
  }

  /** Sidebar departments that have at least one master card (excludes hidden forms tab). */
  get visibleDepartments(): MasterDepartment[] {
    return this.departments.filter(
      (d) => d.id !== 'forms' && this.countForDepartment(d.id) > 0
    );
  }

  countForDepartment(deptId: string): number {
    return this.managementCards.filter((c) => c.departmentId === deptId).length;
  }

  selectDepartment(deptId: string): void {
    this.selectedDepartmentId = deptId;
    if (this.isNarrowViewport) {
      this.mobileSidebarOpen = false;
    }
    this.router.navigate([], {
      relativeTo: this.route,
      queryParams: { dept: deptId },
      queryParamsHandling: 'merge',
    });
    try {
      localStorage.setItem('master_dashboard_department', deptId);
    } catch {
      /* ignore */
    }
  }

  toggleMobileSidebar(): void {
    this.mobileSidebarOpen = !this.mobileSidebarOpen;
  }

  closeMobileSidebar(): void {
    this.mobileSidebarOpen = false;
  }

  showAllTabs(): void {
    this.selectedDepartmentId = 'all';
    this.searchQuery = '';
    this.router.navigate([], {
      relativeTo: this.route,
      queryParams: { dept: 'all' },
      queryParamsHandling: 'merge',
    });
    try {
      localStorage.setItem('master_dashboard_department', 'all');
    } catch {
      /* ignore */
    }
  }

  getFilteredCards(): DashCard[] {
    const q = (this.searchQuery || '').trim().toLowerCase();
    return this.managementCards.filter((c) => {
      const matchDept = this.selectedDepartmentId === 'all' || c.departmentId === this.selectedDepartmentId;
      const matchSearch =
        !q ||
        c.title.toLowerCase().includes(q) ||
        (c.description && c.description.toLowerCase().includes(q)) ||
        c.category.toLowerCase().includes(q);
      return matchDept && matchSearch;
    });
  }

  /** Group filtered cards by department for the All Tabs view. */
  getGroupedSections(): GroupedCardsSection[] {
    const cards = this.getFilteredCards();
    if (this.selectedDepartmentId !== 'all') {
      const dept = this.currentDepartment;
      return dept ? [{ department: dept, cards }] : [];
    }
    const sections: GroupedCardsSection[] = [];
    for (const dept of this.departments) {
      const deptCards = cards.filter((c) => c.departmentId === dept.id);
      if (deptCards.length > 0) {
        sections.push({ department: dept, cards: deptCards });
      }
    }
    return sections;
  }

  trackByCardId(_index: number, card: DashCard): string {
    return card.id;
  }

  trackByDeptId(_index: number, dept: MasterDepartment): string {
    return dept.id;
  }

  trackBySectionId(_index: number, section: GroupedCardsSection): string {
    return section.department.id;
  }

