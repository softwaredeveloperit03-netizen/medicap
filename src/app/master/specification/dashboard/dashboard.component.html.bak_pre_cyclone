<div class="spec-dash">
  <div class="spec-dash__card">
    <div class="spec-dash__header">
      <h2 class="spec-dash__title">{{ dashboardTitle }}</h2>
      <a class="spec-dash__close" routerLink="/master">
        <i class="fas fa-times" aria-hidden="true"></i>
        Close
      </a>
    </div>

    <div class="spec-dash__body">
      <div class="spec-dash__docs-row">
        <app-floating-docs-popup></app-floating-docs-popup>
        <div class="spec-dash__cats">
          <button
            *ngFor="let cat of getCategories()"
            type="button"
            class="spec-dash__chip"
            [class.spec-dash__chip--on]="cat === selectedCategory"
            (click)="selectedCategory = cat"
          >
            {{ cat }}
          </button>
        </div>
      </div>

      <div class="spec-dash__tools">
        <label class="spec-dash__search">
          <i class="fas fa-search" aria-hidden="true"></i>
          <input
            type="text"
            [(ngModel)]="searchQuery"
            placeholder="Search by name or category"
            aria-label="Search specification module"
          />
        </label>
      </div>

      <div class="spec-dash__links">
        <a class="spec-dash__link" routerLink="/calibration">Calibration</a>
        <a class="spec-dash__link" routerLink="/training">Training</a>
        <a class="spec-dash__link" routerLink="/preventiveimain">PM Intimation</a>
        <a class="spec-dash__link" routerLink="/hrfordepthead">Dept Head</a>
        <a class="spec-dash__link" routerLink="/indend/raw">Purchase Requisition</a>
        <a class="spec-dash__link" routerLink="/qa/qms">QMS</a>
        <a class="spec-dash__link" routerLink="/breakdown">Breakdown</a>
      </div>

      <div class="spec-dash__section">
        <div class="spec-dash__section-head">
          <h3 class="spec-dash__section-title">{{ sectionLabel }}</h3>
          <span class="spec-dash__count">{{ filteredCards.length }}</span>
        </div>

        <div class="spec-dash__grid">
          <a class="spec-dash__tile" *ngFor="let c of filteredCards" [routerLink]="c.route">
            <span class="spec-dash__icon" [style.background]="c.gradient">
              <i class="fas" [ngClass]="c.icon" aria-hidden="true"></i>
            </span>
            <span class="spec-dash__tile-text">
              <span class="spec-dash__tile-title">{{ c.title }}</span>
              <span class="spec-dash__tile-desc">{{ c.description }}</span>
            </span>
          </a>

          <div class="spec-dash__empty" *ngIf="filteredCards.length === 0">
            No modules match your search.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
