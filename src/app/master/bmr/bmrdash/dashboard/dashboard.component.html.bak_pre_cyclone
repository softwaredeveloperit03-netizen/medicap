  <div class="component">
    <div class="subsection">
      <div class="purchase-block">
        <div style="text-align:end" class="exit-section">
          <div class="header-block" style="margin:10px 0px">
            <h3>eBMR Master</h3>
          </div>
          <a class="name-board1" [routerLink]="['..']" [relativeTo]="route" title="Back to BMR / WO BMR hub"><i class="fas fa-times"></i>
          </a>
        </div>
      </div>
  
      <div class="master-block" style="margin: 0px 10px 10px 10px !important;">
        <div class="section">
          <div class="line-container">
            <div class="heading">
              <h3>eBMR Master Section</h3>
            </div>
          </div>
          <!-- Main-dashboard -->
          <div class="card-block">
            <div class="icon-container" routerLink="/prod-f-ebmr/ebmr/stage">
              <i class="fas fa-flask"></i>
              <span>Product Specific</span>
            </div>
            
            <div class="icon-container" routerLink="standard">
              <i class="fas fa-file-alt"></i>
              <span>Standard</span>
            </div>
            
            <div class="icon-container" routerLink="/master/checklist/bmr">
              <i class="fas fa-clipboard-check"></i>
              <span>BMR Checklist</span>
            </div>
            
            <div class="icon-container" routerLink="/master/checklist/ipqc">
              <i class="fas fa-tasks"></i>
              <span>Improcess Check Checklist</span>
            </div>                       
            <div class="icon-container" routerLink="bmr">
              <i class="fas fa-tasks"></i>
              <span>New eBMR</span>
            </div>                       
          </div>
        </div>
      </div>
    </div>
