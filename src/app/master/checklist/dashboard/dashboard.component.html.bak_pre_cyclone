<div class="module">
  <div class="subdiv">
    <div class="purchase-container">
      <div style="text-align:end" class="close-block" style="flex-direction: column;">
        <div class="heading-container">
          <h3>Checklists</h3>
        </div>
        <div routerLink="/master" class="name-board2"><i class="fas fa-times"></i>
      </div>
    </div>

    <div class="master-block" style="margin: 0px 10px 10px 10px !important;">
      <div class="section">
        <div class="line-container">
          <div class="heading">
            <h3>Checklists Section</h3>
          </div>
        </div>

        <div class="card-block" style="    
        display: grid;
        grid-template-columns: repeat(6, 150px);
        grid-gap: 35px;
        overflow-x: auto;
        max-width: 100%;">
          <div class="icon-container" routerLink="form">
            <i class="fas fa-clipboard-list"></i>
            <span>New Checklist</span>
          </div>

          <div class="icon-container" routerLink="approve" *ngIf="isapprover == 'Yes'">
            <i class="fas fa-clipboard-check"></i>
            <span>Checklist Approval</span>
          </div>

          <div class="icon-container" routerLink="Log">
            <i class="fas fa-clipboard-check"></i>
            <span>Checklist Log</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
