<div class="card">
    <div class="card-header" style="text-align: center">
        <div class="clr-row" style="margin-bottom: -10px;">
            <div class="clr-col-lg-5" style="color: aliceblue;margin-top: -2px;text-align: left;">Company/ Unit Type :
                <strong> {{company_type}}</strong>
            </div>
            <div class="clr-col-lg-7" style="text-align: right;padding-right: 0px;margin-top: -7px;">
                <button class="btn btn-sm btn-danger" style="background-color:blueviolet"
                    (click)="select_panel(0)">Logs/ Edit</button>
                <button class="btn btn-sm btn-danger" style="background-color:brown" (click)="select_panel(1)">Material
                    Types</button>
                <button class="btn btn-sm btn-danger" style="background-color:blue" (click)="select_panel(2)">FG
                    Types</button>
                <button class="btn btn-sm btn-danger" style="background-color:green" (click)="select_panel(3)"
                    routerLink="/master">Other Masters</button>

                <button class="btn btn-sm btn-danger" routerLink="/master">{{'common.close' | translate}}</button>
            </div>
        </div>
    </div>

    <div class="card-block" *ngIf="material_type">
        <div class="card-text">
            <h2>Material Master</h2>
            <form #materialTypeForm="ngForm">
                <div class="clr-row">
                    <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
                        <label>Material Type:</label>
                        <select name="material_type" ngModel required>
                            <option>Raw Material</option>
                            <option>Packing Material</option>
                            <option>General Material</option>
                            <option>Chemicals</option>
                            <option>Cultures amd Media</option>
                        </select>
                    </div>
                    <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
                        <label>Short Code:</label>
                        <input type="text" name="short_code" ngModel required maxlength="2">
                        <span style="color: red;" *ngIf="short_code.invalid && short_code.touched">Please
                            Enter Short Code</span>
                    </div>
                    <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
                        <label>Material Sub Type:</label>
                        <input type="text" name="material_subtype"  #material_subtype="ngModel" required>
                        <span style="color: red;" *ngIf="material_subtype.invalid && material_subtype.touched">Please
                            Enter Material Sub Type</span>
                    </div>


                    <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
                        <label>Sampling Criteria:</label>
                        <select name="sampling_criteria" ngModel required>
                            <option>√n +1</option>
                            <option>10%</option>
                            <option>100%</option>
                            <option>MIL-STD-105E(Military Standrad)</option>
                        </select>
                        <span style="color: red;" *ngIf="material_subtype.invalid && material_subtype.touched">Please
                            Select Sampling Criteria</span>
                    </div>
                    <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
                        <label>Sampling Qty:</label>
                        <select name="sampling_qty" ngModel required>
                            <option>Test Specific</option>
                            <option>Fixed</option>

                        </select>
                    </div>
                    <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
                        <label>Control/ Reserve Sample:</label>
                        <select name="control_sample_type" ngModel required>
                            <option>Applicable</option>
                            <option>Not Applicable</option>
                        </select>
                    </div>
                    <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12"
                        *ngIf="control_sample_type=='Applicable'">
                        <label>Control/ Reserve Sample Creteria:</label>
                        <select name="control_reverse_creteria" ngModel required>
                            <option>Two Times (of single analysis)</option>
                            <option>Three Times (of single analysis)</option>
                        </select>
                    </div>
                    <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
                        <label>Retest:</label>
                        <select name="retest_type" ngModel required>
                            <option>Applicable</option>
                            <option>Not Applicable</option>
                        </select>
                    </div>
                    <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12"
                        *ngIf="retest_type=='Applicable'">
                        <label>Retest Months:</label>
                        <select name="restest_months" ngModel required>
                            <option>3 Months</option>
                            <option>6 Months</option>
                            <option>12 Months</option>
                            <option>18 Months</option>
                            <option>24 Months</option>
                            <option>36 Months</option>

                        </select>
                    </div>
                    <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
                        <label>Weighing Criteria:</label>
                        <select name="weighing_criteria" ngModel required>
                            <option>√n +1</option>
                            <option>10%</option>
                            <option>100%</option>
                            <option>MIL-STD-105E(Military Standrad)</option>
                        </select>
                    </div>
                    

                </div>
            </form>
            <div class="card-footer"><button class="btn btn-primary" (click)="saveMaterialType(materialTypeForm)">{{'common.save' | translate}}</button></div>
        </div>
        <div class="card-text datagrid-wrapper">
            <clr-datagrid [clrDgLoading]="loading" >

                <clr-dg-column>Sr No. </clr-dg-column>
                <clr-dg-column clrDgField="material_type">Material Type</clr-dg-column>
                <clr-dg-column clrDgField="material_subtype">Material Subtype </clr-dg-column>
                <clr-dg-column clrDgField="sampling_plan">Sampling Plan </clr-dg-column>
                <clr-dg-column clrDgField="sampling_qty_type">Sampling Qty.</clr-dg-column>
                <clr-dg-column clrDgField="control_sample_type">Control/Reserve Sample </clr-dg-column>
                <clr-dg-column clrDgField="control_sample_criteria">Ctrl/Res Sample Criteria </clr-dg-column>
                <clr-dg-column>{{'common.table.action' | translate}}</clr-dg-column>

                <clr-dg-row *clrDgItems="let crit of criterias;let i=index" [clrDgItem]="crit">
                    <clr-dg-cell>{{i+1}}</clr-dg-cell>
                    <clr-dg-cell>{{crit.material_type}}</clr-dg-cell>
                    <clr-dg-cell>{{crit.material_subtype}}</clr-dg-cell>
                    <clr-dg-cell>{{crit.sampling_plan}}</clr-dg-cell>
                    <clr-dg-cell>{{crit.sampling_qty_type}}</clr-dg-cell>
                    <clr-dg-cell>{{crit.control_sample_type}}</clr-dg-cell>
                    <clr-dg-cell>{{crit.control_sample_criteria}}</clr-dg-cell>
                    <clr-dg-cell>
                        <button class="btn btn-sm btn-warning-outline btn-icon" (click)="editMaterial(i)">
                            <clr-icon shape="trash" class="is-warning"></clr-icon>
                        </button>
                    </clr-dg-cell>
                </clr-dg-row>
                <clr-dg-footer>
                    <clr-dg-pagination #pagination [clrDgPageSize]="10">
                        <clr-dg-page-size [clrPageSizeOptions]="[10,20,50,100]">Users per page</clr-dg-page-size>
                        {{pagination.firstItem + 1}} - {{pagination.lastItem + 1}}
                        of {{pagination.totalItems}} users
                    </clr-dg-pagination>
                </clr-dg-footer>
            </clr-datagrid>

            <!-- <div class="card-footer"><button class="btn btn-primary" (click)="saveCountries(countryform)">{{'common.save' | translate}}</button></div> -->
        </div>
    </div>

