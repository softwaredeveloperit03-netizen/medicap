  constructor(
    private service: DataAccessService,
    private cdr: ChangeDetectorRef,
    private route: ActivatedRoute
  ) {
    this.loggedInDept = localStorage.getItem('department');
  }

  ngOnInit(): void {
    const used = new Set(this.allCards.map(c => c.category));
    this.categories = ['All', ...this.categoryOrder.filter(c => used.has(c))];
    this.route.queryParamMap.subscribe(params => {
      const category = this.normalizeCategoryParam(params.get('category') || '');
      if (category && this.categories.includes(category)) {
        this.selectedCategory = category;
      } else if (!category) {
        this.selectedCategory = 'All';
      }
      this.updateFilteredCards();
    });
    this.get_rights();
    this.getPurchaseNotifications();
    const savedPalette = localStorage.getItem('purchase_dashboard_palette');
    if (savedPalette) {
      const found = this.paletteOptions.find(p => p.name === savedPalette);
      if (found) {
        this.selectedPalette = found;
        this.cdr.markForCheck();
      }
    }
  }

  private normalizeCategoryParam(category: string): string {
    const c = category.trim();
    const aliases: Record<string, string> = {
      'Indent': 'Purchase Requisition',
      'Purchase Order': 'Purchase',
    };
    return aliases[c] || c;
  }

  get_rights(): void {
    const empId = localStorage.getItem('emp_id');
    if (!empId) { return; }
    this.service.get(
      'hr/employee.php?type=getrights&emp_id=' +
      encodeURIComponent(empId) +
      '&dep_name=' +
      encodeURIComponent(this.loggedInDept || '')
    ).subscribe((response: any) => {
      this.rights = response;
      const r = Array.isArray(response) && response[0] ? response[0] : {};
      this.dept_head = r.dept_head || 'No';
      this.trainig_cordinator = r.trainig_cordinator || 'No';
      this.qms_approver = r.qms_approver || 'No';
      this.cdr.markForCheck();
    });
  }

  getPurchaseNotifications(): void {
    this.service.get('purchase/indent.php?type=getCheckedIndendsForNotification').subscribe((res: any) => {
      this.unreadindent = res['Pending_indent'] || 0;
      if (this.unreadindent > 0 && typeof alertify !== 'undefined') { alertify.warning(res['text']); }
      this.syncBadgesAndUpdate();
    });
    this.service.get('purchase/po/raw.php?type=getAllPendingPOForNotification').subscribe((res: any) => {
      this.unreadPo = res['Pending_Po'] || 0;
      if (this.unreadPo > 0 && typeof alertify !== 'undefined') { alertify.warning(res['text']); }
      this.syncBadgesAndUpdate();
    });
    this.service.get('purchase/quotation.php?type=getPendingQuotationsForNotification').subscribe((res: any) => {
      this.unreadQuotations = res['Pending_quatation'] || 0;
      if (this.unreadQuotations > 0 && typeof alertify !== 'undefined') { alertify.warning(res['text']); }
      this.syncBadgesAndUpdate();
    });
    this.service.get('purchase/vendor.php?type=getPendingVendorsNotification').subscribe((res: any) => {
      this.unreadVendor = res['Pending_Vendor'] || 0;
      if (this.unreadVendor > 0 && typeof alertify !== 'undefined') { alertify.warning(res['text']); }
      this.syncBadgesAndUpdate();
    });
    this.service.get('notification.php?type=ExpiryNotification').subscribe((res: any) => {
      this.unreadExpiry = res['Pending_expiry'] || 0;
      if (this.unreadExpiry > 0 && typeof alertify !== 'undefined') { alertify.warning(res['text']); }
      this.syncBadgesAndUpdate();
    });
  }

  private syncBadgesAndUpdate(): void {
    const byId: Record<string, number> = {
      'quotation-log': this.unreadQuotations,
      'indent-processing': this.unreadindent,
      'po-review': this.unreadPo,
      'vendor-approval': this.unreadVendor,
    };
    this.allCards.forEach(c => {
      const n = byId[c.id];
      c.badge = n != null && n > 0 ? n : undefined;
    });
    this.updateFilteredCards();
  }

  updateFilteredCards(): void {
    const q = (this.searchQuery || '').trim().toLowerCase();
    this.filteredCards = this.allCards.filter(c => {
      const matchCategory = this.selectedCategory === 'All' || c.category === this.selectedCategory;
      const matchSearch = !q || c.title.toLowerCase().indexOf(q) !== -1 || (c.description && c.description.toLowerCase().indexOf(q) !== -1) || c.category.toLowerCase().indexOf(q) !== -1;
      return matchCategory && matchSearch;
    });
    this.buildGroupedCards();
    this.cdr.markForCheck();
  }

  /** Group the filtered cards into separated grid sections, ordered by categoryOrder. */
  private buildGroupedCards(): void {
    const order = this.categoryOrder;
    const groups = new Map<string, DeptCard[]>();
    this.filteredCards.forEach(card => {
      if (!groups.has(card.category)) {
        groups.set(card.category, []);
      }
      groups.get(card.category)!.push(card);
    });
    this.groupedCards = Array.from(groups.keys())
      .sort((a, b) => {
        const ia = order.indexOf(a);
        const ib = order.indexOf(b);
        return (ia === -1 ? order.length : ia) - (ib === -1 ? order.length : ib);
      })
      .map(category => ({ category, cards: groups.get(category)! }));
  }

  trackByCategory(_index: number, group: { category: string }): string {
    return group.category;
  }

  onSearchChange(): void {
    this.updateFilteredCards();
  }

  selectCategory(cat: string): void {
    this.selectedCategory = cat;
    this.updateFilteredCards();
  }

  trackByCardId(_index: number, card: DeptCard): string {
    return card.id;
  }

  togglePalette(): void {
    this.showPalette = !this.showPalette;
    this.cdr.markForCheck();
  }

  setPalette(palette: { name: string; swatch: string; background: string; cardShadow: string }): void {
    this.selectedPalette = palette;
    this.showPalette = false;
    try {
      localStorage.setItem('purchase_dashboard_palette', palette.name);
    } catch (e) {}
    this.cdr.markForCheck();
  }
