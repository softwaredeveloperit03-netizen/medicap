<div class="component qa-legacy-dash">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>IPQA</h3>
        <div routerLink="/qa" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>IPQA Section</h3>
            </div>
          </div>
          <div class="block-container">
            <div class="item-block" *ngIf="isapprover == 'Yes'" routerLink="dispensing">
            <i class="fas fa-prescription-bottle"></i>
            <span>Dispensing Approvals</span>
          </div>
          
          <div class="item-block" routerLink="/qa/ipqa/inprocess-sampling/receive">
            <i class="fas fa-flask"></i>
            <span>Inprocess Sampling</span>
          </div>
          
          <div class="item-block" routerLink="lineclearance">
            <i class="fas fa-clipboard-check"></i>
            <span>Line Clearance</span>
          </div>
          
          <div class="item-block" *ngIf="ischecker == 'Yes'" routerLink="inprocesschecks">
            <i class="fas fa-tasks"></i>
            <span>Inprocess Checks</span>
          </div>
          
          <div class="item-block" routerLink="/qa/damage">
            <i class="fas fa-exclamation-triangle"></i>
            <span>Damage Inspection</span>
          </div>
          
          <div class="item-block" routerLink="material">
            <i class="fas fa-cube"></i>
            <span>Additional Material</span>
          </div>
          
          </div>
        </div>
      </div>
    </div>
  </div>
</div>