            <div class="item-block" routerLink="log">
              <i class="fas fa-book"></i>
              <span>Line Clearance Log</span>
            </div> -->
            
            <div class="item-block" routerLink="checklist">
              <i class="fas fa-list-alt"></i>
              <span>New Area Checkl</span>
            </div>
            
            <div class="item-block" *ngIf="ischecker == 'Yes'" routerLink="checklist-approval">
              <i class="fas fa-clipboard-check"></i>
              <span>Area Chl Master Aprvl</span>
            </div>
            
            <div class="item-block" routerLink="checklist-log">
              <i class="fas fa-book"></i>
              <span>Area Chl Master Log</span>
            </div>         

          </div>
        </div>
      </div>
    </div>
