<div class="component qa-legacy-dash">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Audit / Self Inspection</h3>
        <div routerLink="/qa" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>Audit / Self Inspection Section</h3>
            </div>
          </div>
          <div class="block-container">
            <div class="item-block" routerLink="plan">
              <i class="fas fa-clipboard-list"></i>
              <span>Self Inspection Plan</span>
            </div>
            
            <div class="item-block" routerLink="team">
              <i class="fas fa-users"></i>
              <span>Self Inspection Team</span>
            </div>
            
            <div class="item-block" routerLink="annoucement">
              <i class="fas fa-bullhorn"></i>
              <span>Self Inspectn Announc</span>
            </div>
            
            <div class="item-block" *ngIf="ischecker=='Yes'" routerLink="Auditcheck">
              <i class="fas fa-tasks"></i>
              <span>Self Inspectn Checklist</span>
            </div>
            
            <div class="item-block" routerLink="log">
              <i class="fas fa-file-alt"></i>
              <span>Self Inspectn Report</span>
            </div>
            
            <div class="item-block" routerLink="log">
              <i class="fas fa-book"></i>
              <span>Self Insp Log Book</span>
            </div>
            


          
          </div>
        </div>
      </div>
    </div>
  </div>
</div>