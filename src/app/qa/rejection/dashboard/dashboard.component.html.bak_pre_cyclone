<div class="component qa-legacy-dash">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Rejection Management</h3>
        <div routerLink="/qa" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>Rejection Management Section</h3>
            </div>
          </div>
          <div class="block-container">

            <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="../rawpacking-approval">
              <i class="fas fa-times-circle"></i>
              <span>Raw Packg Rej Apprvl</span>
            </div>
            
            <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="../online-approval">
              <i class="fas fa-check-circle"></i>
              <span>Online Rej Apprvl</span>
            </div>
            
            <div class="item-block" routerLink="../rawpackingreport">
              <i class="fas fa-chart-bar"></i>
              <span>Raw/Packg Rej Report</span>
            </div>
            
            <div class="item-block" routerLink="../onlinereport">
              <i class="fas fa-chart-line"></i>
              <span>Online Rej Report</span>
            </div>
            
            <div class="item-block" routerLink="../destruction">
              <i class="fas fa-trash-alt"></i>
              <span>Destruction Report</span>
            </div>
            
            <div class="item-block" routerLink="../return">
              <i class="fas fa-undo"></i>
              <span>Return Report</span>
            </div>
          
          
          </div>

