@import "../../hr/dashboard/dashboard.component.css";

.icon-wrap {
  position: relative;
}

.tile-badge {
  position: absolute;
  top: -8px;
  right: -8px;
  min-width: 22px;
  height: 22px;
  padding: 0 6px;
  border-radius: 11px;
  background: #ef4444;
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
  line-height: 22px;
  text-align: center;
  box-shadow: 0 2px 6px rgba(239, 68, 68, 0.5);
  border: 2px solid #ffffff;
  z-index: 2;
}
