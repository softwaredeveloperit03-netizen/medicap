<div class="card" *ngIf="!isView">
  <div class="card-header" style="text-align: center">
    <div class="clr-row" style="margin-bottom: -10px;">
      <div class="clr-col-lg-3" style="color: aliceblue;margin-top: -2px;text-align: left;">Product Management</div>
      <div class="clr-col-lg-9" style="text-align: right;padding-right: 0px;margin-top: -7px;">
        <button class="btn btn-sm btn-success" routerLink="new" *ngIf="isUser">New Product</button>
        <button class="btn btn-sm btn-success" routerLink="approve" *ngIf="isApprover">Products for Approval</button>
        <button class="btn btn-sm btn-success" routerLink="mrphistory">MRP Change History</button>
        <button class="btn btn-sm btn-success" routerLink="profile">Product Profile</button>
        <button class="btn btn-sm btn-danger" routerLink="/">{{'common.close' | translate}}</button>
      </div>
    </div>
  </div>
  <div class="card-block">
    <div class="card-text">
