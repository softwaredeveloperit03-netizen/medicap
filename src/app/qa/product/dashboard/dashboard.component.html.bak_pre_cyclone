      <div class="clr-row">
        <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12">
            <label>Dosage Form:</label>
            <select name="dosage_form" [(ngModel)]="dosage_form" required>
                <option></option>
                <option *ngFor="let dosage of dosages">{{ dosage.dosage_form }}</option>
            </select>
        </div>
        <div class="clr-col-lg-3 clr-col-md-4 clr-col-sm-12">
            <label>Grade:</label>
            <select name="grade" [(ngModel)]="grade" required>
                <option></option>
                <option *ngFor="let grade of grades">{{ grade.grade }}</option>
            </select>
        </div>
        <div class="clr-col-lg-3 clr-col-md-4 clr-col-sm-12">
            <label>Generic name:</label>
            <input type="text" name="generic_name" [(ngModel)]="generic_name">
        </div>
        <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12">
            <label>{{'common.status' | translate}}</label>
            <select name="status" [(ngModel)]="status" required>
                <option>Approve</option>
                <option>{{'common.pending' | translate}}</option>
                <option>Reject</option>
            </select>
        </div>
        <div class="clr-col-lg-1 clr-col-md-3 clr-col-sm-12">
            <button class="btn btn-danger" (click)="getProductsLog()">{{'common.search' | translate}}</button>
        </div>
      </div>
      <div style="overflow-x: auto;height: 50vh;margin-top: 1.2rem;">
        <table class="table table-border" style="margin-top: 0px;">
          <thead>
            <tr>
              <th style="text-align: left;vertical-align: middle;">Sr.</th>
              <th style="text-align: left;vertical-align: middle;">Dosage Form</th>
              <th style="text-align: left;vertical-align: middle;">Product Code</th>
              <th style="text-align: left;vertical-align: middle;">Product Name</th>
              <th style="text-align: left;vertical-align: middle;">Grade</th>
              <th style="text-align: left;vertical-align: middle;">Generic Name</th>
              <th style="text-align: left;vertical-align: middle;">MRP</th>
              <th style="text-align: left;vertical-align: middle;">{{'common.status' | translate}}</th>
              <th style="width: 18%; vertical-align: middle;">{{'common.table.action' | translate}}</th>
            </tr>
          </thead>
          <tbody>
            <tr *ngFor="let result of results; let i = index">
              <td style="text-align: left;">{{ i + 1 }}.</td>
              <td style="text-align: left;">{{ result.dosage_form }}</td>
              <td style="text-align: left;">{{ result.product_code }}</td>
              <td style="text-align: left;">{{ result.product_name }}</td>
              <td style="text-align: left;">{{ result.grade }}</td>
              <td style="text-align: left;">{{ result.generic_name }}</td>
              <td style="text-align: left;">{{ result.mrp }}</td>
              <td style="text-align: left;">{{ result.status }}</td>
              <td>
                  <button class="btn btn-sm btn-success-outline btn-icon" (click)="view(i)"><clr-icon shape="eye" class="is-success"></clr-icon></button>
                  <!-- <button class="btn btn-sm btn-danger-outline btn-icon" (click)="isedit(i)"><clr-icon shape="note" class="is-warning"></clr-icon></button> -->
                  <button class="btn btn-sm btn-info-outline btn-icon" (click)="download(result.id)"><clr-icon shape="download" class="is-info"></clr-icon></button>
              </td>
            </tr>
            <tr *ngIf="results?.length == 0">
              <td colspan="7">{{'common.noRecords' | translate}}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="card-footer">
    <button class="btn btn-primary" (click)="downloadReport()">{{'common.download' | translate}}</button>
  </div>
</div>

<div class="card" *ngIf="isView">
  <div class="card-header" style="text-align: center">
      <div class="clr-row" style="margin-bottom: -10px;">
        <div class="clr-col-lg-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Product Details: {{selectedResult['product_code']}}</div>
        <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
          <button class="btn btn-sm" (click)="isView=false" style="background-color: red;color: white;">{{'common.close' | translate}}</button>
        </div>
      </div>
  </div>
  <div class="card-block">
      <div class="card-text">
          <table class="table">
              <tr>
                  <td style="text-align:left; border:1px solid black;width:20%"><b>Brand Name:</b></td>
                  <td style="text-align:left; border:1px solid black;width: 30%;">{{selectedResult['product_name']}}</td>
                  <td style="text-align:left; border:1px solid black;width: 20%;"><b>Grade:</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['grade']}}</td>
              </tr>
              <tr>
                   <td style="text-align:left; border:1px solid black;"><b>Generic Name:</b></td>
                   <td style="text-align:left; border:1px solid black;" colspan="3">{{selectedResult['generic_name']}}</td>
              </tr>
              <tr>
                   <td style="text-align:left; border:1px solid black;"><b> Type of Dose:</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['dosage_type']}}</td>
                   <td style="text-align:left; border:1px solid black;"><b>Dosage Form:</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['dosage_form']}}</td>
              </tr>
              <tr>
                   <td style="text-align:left; border:1px solid black;"><b>Shelf Life: (Months)</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['shelf_life']}}</td>
                   <td style="text-align:left; border:1px solid black;"><b>Min.Shelf Life: (Months)</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['min_shelf']}}</td>
              </tr>
              <tr *ngIf="selectedResult['manufactured_under'] == 'Self'">
                  <td style="text-align:left; border:1px solid black;"><b>Manufactured Under:</b></td>
                  <td style="text-align:left; border:1px solid black;">{{selectedResult['manufactured_under']}}</td>
                  <td style="text-align:left; border:1px solid black;"><b>HSN:</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['hsn']}}</td>
             </tr>
              <tr *ngIf="selectedResult['manufactured_under'] !== 'Self'">
                   <td style="text-align:left; border:1px solid black;"><b>Manufactured Under:</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['manufactured_under']}}</td>
                   <td style="text-align:left; border:1px solid black;"><b>Manufactured for Client</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['manufactured_for']}}</td>
              </tr>
              <tr *ngIf="selectedResult['manufactured_under'] !== 'Self'">
                   <td style="text-align:left; border:1px solid black;"><b>HSN:</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['hsn']}}</td>
              </tr>
              <tr>
                  <td style="text-align:left; border:1px solid black;"><b>Retest After: (Months)</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['retest_period']}}</td>
                   <td style="text-align:left; border:1px solid black;"><b>Approxx Testing Time:(min)</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['testing_time']}}</td>
              </tr>
              <tr>
                  <td style="text-align:left; border:1px solid black;"><b>GST:</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['gst']}}</td>
                   <td style="text-align:left; border:1px solid black;"><b>MRP:</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['mrp']}}</td>
              </tr>
              <tr>
                   <td style="text-align:left; border:1px solid black;"><b>Therapetic Category:</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['thera']}}</td>
                   <td style="text-align:left; border:1px solid black;"><b>Packing Style:</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['packing_style']}}</td>
              </tr>
              <tr>
                   <td style="text-align:left; border:1px solid black;"><b>Storage Condition:</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['storage_condition']}}</td>
                   <td style="text-align:left; border:1px solid black;"><b>Apperance:</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['apperance']}}</td>
              </tr>
              <tr>
                   <td style="text-align:left; border:1px solid black;"><b>Label Claim:</b></td>
                   <td style="text-align:left; border:1px solid black;">{{selectedResult['label_claim']}}</td>
                   <td style="text-align:left; border:1px solid black;"><b>Cess:</b></td>
                    <td style="text-align:left; border:1px solid black;">{{selectedResult['cess']}}</td>
              </tr>


          </table>
          

          <h3>Attachments:</h3>
          <table class="table">
              <tr>
                  <td style="text-align: left;">Product License:</td>
                  <td>
                      <button class="btn btn-sm" (click)="open(selectedResult['product_lic'])">VIEW FILE</button>
                  </td>
              </tr>
              <tr>
                  <td style="text-align: left;">FSC:</td>
                  <td>
                      <button class="btn btn-sm" (click)="open(selectedResult['fsc'])">VIEW FILE</button>
                  </td>
              </tr>
              <tr>
                  <td style="text-align: left;">COPP:</td>
                  <td>
                      <button class="btn btn-sm" (click)="open(selectedResult['copp'])">VIEW FILE</button>
                  </td>
              </tr>
              <tr>
                  <td style="text-align: left;">Artwork:</td>
                  <td>
                      <button class="btn btn-sm" (click)="open(selectedResult['artwork'])">VIEW FILE</button>
                  </td>
              </tr>
          </table>

          <table class="table">
              <tr>
                  <th style="text-align: left;">Entry By</th>
                  <th style="text-align: left;">Approve By</th>
              </tr>
              <tr>
                  <td style="text-align: left;">{{ selectedResult['entry_by'] }}</td>
                  <td style="text-align: left;">{{ selectedResult['approve_by'] }}</td>
              </tr>
              <tr>
                  <td style="text-align: left;">{{ selectedResult['entry_date'] }}</td>
                  <td style="text-align: left;">{{ selectedResult['approve_date'] }}</td>
              </tr>
          </table>
      </div>
  </div>
  <div class="card-footer">
      <button class="btn btn-primary" (click)="download()">{{'common.download' | translate}}</button>
      <button class="btn btn-danger" (click)="isView = false">{{'common.close' | translate}}</button>
  </div>
</div>