<div class="component qa-legacy-dash">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Contrl Sample</h3>
        <div routerLink="/qa" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>Control Sample Section</h3>
            </div>
          </div>
          <div class="block-container" style="    
          display: grid;
          grid-template-columns: repeat(6, 150px);
          grid-gap: 35px;
          overflow-x: auto;
          max-width: 100%;">
            <div class="item-block" routerLink="masters">
              <i class="fas fa-cogs"></i>
              <span>Masters</span>
            </div>
            
            <div class="item-block" routerLink="raw">
              <i class="fas fa-archive"></i>
              <span>Raw Material Register</span>
            </div>
            
            <div class="item-block" routerLink="packing">
              <i class="fas fa-box"></i>
              <span>Packing Material Reg</span>
            </div>
            
            <div class="item-block" routerLink="finish">
              <i class="fas fa-dolly"></i>
              <span>Finish Products Reg</span>
            </div>
            
            <div class="item-block" routerLink="withdrawal">
              <i class="fas fa-file-import"></i>
              <span>Withdrawal</span>
            </div>
            
            <div class="item-block" *ngIf="ischecker=='Yes' || isapprover=='Yes'" routerLink="review">
              <i class="fas fa-search"></i>
              <span>Ctrl Sample Review</span>
            </div>
            
            <div class="item-block" routerLink="/qc/controlsample/review">
              <i class="fas fa-search"></i>
              <span>Ctrl Sample Review</span>
            </div>
            
            <div class="item-block" routerLink="expired">
              <i class="fas fa-calendar-times"></i>
              <span>Expired Ctrl Sample</span>
            </div>
            
            <div class="item-block" routerLink="distroy">
              <i class="fas fa-trash-alt"></i>
              <span>Destroy Sample Log</span>
            </div>
            
          </div>
        </div>
      </div>
    </div>
  </div>
</div>