  <div class="component qa-legacy-dash">
    <div class="subsection">
      <div class="purchase-block" >
        <div style="text-align:end" class="exit-section">
          <div class="header-block" style="margin:10px 0px">
            <h3>On Job Training</h3>
          <div routerLink="/qa/training" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>
  
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>On Job Training Section</h3>
              </div>
            </div>
            <div class="block-container">
              <div *ngIf="isuser == 'Yes'" class="item-block" routerLink="new">
                <i class="fas fa-file"></i>
                <span>On Job training New</span>
              </div>
              
              <div class="item-block" routerLink="annoncement">
                <i class="fas fa-bullhorn"></i>
                <span>On Job training Assessment</span>
              </div>
              
              <div class="item-block" routerLink="attendance">
                <i class="fas fa-user-check"></i>
                <span>Review / Approval</span>
              </div>
              
              <!-- <div class="item-block" routerLink="evaluation">
                <i class="fas fa-poll"></i>
                <span>On Job training Evaluation</span>
              </div> -->
              
              <div class="item-block" routerLink="report">
                <i class="fas fa-file-alt"></i>
                <span>On Job training Report</span>
              </div>            
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

