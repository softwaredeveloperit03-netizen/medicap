<div class="component qa-legacy-dash">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>On Job Training</h3>
          <div routerLink="/qa/training" class="name-board2"><i class="fas fa-times"></i></div>
        </div>
        <!-- sub1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="clr-col-lg-3">
            <label>Training Type</label>
            <select name="trainingType" [(ngModel)]="trainingType" (change)="onChangeTraining(trainingType)">
              <option>Need Based Training</option>
              <option>On Job Training</option>
              <option>Document Training Training</option>
              <option>QMS Training</option>
              <option>Retraining Training</option>
              <option>Daily Training</option>
              <option>Induction Training</option>
            </select>
          </div>
          <div class="category">
            <div class="block-container">
              <div class="item-block" routerLink="new">
                <i class="fas fa-file-alt"></i>
                <span>New Training</span>
              </div>
              <div class="item-block" routerLink="announcement">
                <i class="fas fa-file-alt"></i>
                <span>Training Announcement</span>
              </div>
              <div class="item-block" routerLink="attendance">
                <i class="fas fa-file-alt"></i>
                <span>Training Attendance</span>
              </div>
              <div class="item-block" routerLink="evaluation">
                <i class="fas fa-file-alt"></i>
                <span>Training Evaluation</span>
              </div>
              <div class="item-block" routerLink="report">
                <i class="fas fa-file-alt"></i>
                <span>Training Report</span>
              </div>              
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>