<div class="component qa-legacy-dash">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>External Trainers</h3>
        <div routerLink="/qa/training/training-activity" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>External Trainers Section</h3>
            </div>
          </div>
          <div class="block-container">
            <div *ngIf="isuser == 'Yes'" class="item-block" routerLink="new">
              <i class="far fa-file"></i>
              <span>New</span>
            </div>
            
            <div *ngIf="isapprover == 'Yes'" class="item-block" routerLink="approval">
              <i class="fas fa-check-double"></i>
              <span>Approval</span>
            </div>
            
            <div class="item-block" routerLink="log">
              <i class="fas fa-clipboard-list"></i>
              <span>External Trainers List</span>
            </div>            
          </div>
        </div>
      </div>
    </div>
  </div>
</div>