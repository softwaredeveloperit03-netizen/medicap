  <!-- ======================================= -->
  <div class="component qa-legacy-dash">
    <div class="subsection">
      <div class="purchase-block" style="margin:10px 0px">
        <div style="text-align:end" class="exit-section">
          <div class="header-block" style="margin:10px 0px">
            <h3>QMS Training</h3>
          <div routerLink="/qa/training" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>
  
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="clr-col-lg-3">
            <label>Training Type</label>
            <select name="trainingType" [(ngModel)]="trainingType" (change)="onChangeTraining(trainingType)">
              <option>Need Based Training</option>
              <option>On Job Training</option>
              <option>Document Training Training</option>
              <option>QMS Training</option>
              <option>Retraining Training</option>
              <option>Daily Training</option>
              <option>Induction Training</option>
            </select>
          </div>
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>QMS Training Section</h3>
              </div>
            </div>
            <div class="block-container">
              <div class="item-block" routerLink="new" *ngIf="isuser == 'Yes'">
                <i class="fas fa-file-alt"></i>
                <span>QMS Training New</span>
              </div>
              <div class="item-block" routerLink="annoncement">
                <i class="fas fa-bullhorn"></i>
                <span>QMS Training Announcement</span>
              </div>
              <div class="item-block" routerLink="attendance">
                <i class="far fa-calendar-check"></i>
                <span>QMS Training Attendance</span>
              </div>
              <div class="item-block" routerLink="evaluation">
                <i class="fas fa-clipboard-check"></i>
                <span>QMS Training Evaluation</span>
              </div>
              <div class="item-block" routerLink="log">
                <i class="far fa-file-alt"></i>
                <span>QMS Training Report</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>