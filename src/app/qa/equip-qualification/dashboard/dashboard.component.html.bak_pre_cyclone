<div class="component qa-legacy-dash">
    <div class="subsection">
      <div class="purchase-block" >
        <div style="text-align:end" class="exit-section">
          <div class="header-block" style="margin:10px 0px">
            <h3>Equipment Qualification</h3>
          <div routerLink="/qa" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>
  
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Equipment Qualification Section</h3>
              </div>
            </div>
            <div class="block-container"  style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">

                <div class="item-block" routerLink="qualifi">
                    <i class="fas fa-microscope"></i>
                    <span>Equipment For Qualif.</span>
                  </div>
                  
                  <div class="item-block" routerLink="urs">
                    <i class="fas fa-clipboard-list"></i>
                    <span>User Requirem Spec.</span>
                  </div>
                  
                  <div class="item-block" routerLink="dq">
                    <i class="fas fa-file-alt"></i>
                    <span>Design Qualif.</span>
                  </div>
                  
                  <div class="item-block" routerLink="factory">
                    <i class="fas fa-warehouse"></i>
                    <span>Factory Acceptance</span>
                  </div>
                  
                  <div class="item-block" routerLink="site">
                    <i class="fas fa-building"></i>
                    <span>Site Acceptance</span>
                  </div>
                  
                  <div class="item-block" routerLink="qualification-request">
                    <i class="fas fa-flask"></i>
                    <span>Qualif. Request (IQ)</span>
                  </div>
                  
                  <div class="item-block" routerLink="iq">
                    <i class="fas fa-tools"></i>
                    <span>Installation Qualif.</span>
                  </div>
                  
                  <div class="item-block" routerLink="oq">
                    <i class="fas fa-cogs"></i>
                    <span>Operational Qualif.</span>
                  </div>
                  
                  <div class="item-block" routerLink="pq">
                    <i class="fas fa-chart-line"></i>
                    <span>Performance Qualif.</span>
                  </div>
                  
                  <div class="item-block" *ngIf="isuser == 'Yes'" routerLink="re">
                    <i class="fas fa-sync-alt"></i>
                    <span>Requalification</span>
                  </div>
                  
                  <div class="item-block" *ngIf="isuser == 'Yes'" routerLink="qr">
                    <i class="fas fa-file-contract"></i>
                    <span>Qualif. Records</span>
                  </div>
                  
                  <!-- <div class="item-block" routerLink="equipment-vendor">
                    <i class="fas fa-truck"></i>
                    <span>Equipment Vendor</span>
                  </div> -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>