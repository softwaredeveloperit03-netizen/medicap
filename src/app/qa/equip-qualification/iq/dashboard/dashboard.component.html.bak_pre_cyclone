<div class="component qa-legacy-dash">
    <div class="subsection">
      <div class="purchase-block" >
        <div style="text-align:end" class="exit-section">
          <div class="header-block" style="margin:10px 0px">
            <h3>Equipment Installation Qualification</h3>
          <div routerLink="/qa/equip-qualification" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>
  
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Equipment Installation Qualification Section</h3>
              </div>
            </div>
            <div class="block-container"  style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">
            <div class="item-block" routerLink="new">
                <i class="fas fa-plus"></i>
                <span>New Qualification</span>
              </div>
              
              <div class="item-block" routerLink="checking" *ngIf="ischecker=='Yes'">
                <i class="fas fa-check"></i>
                <span>Checking Qualificaton</span>
              </div>
              
              <div class="item-block" routerLink="approval">
                <i class="fas fa-tasks"></i>
                <span>Inprocess Qualificaton</span>
              </div>
              
              <div class="item-block" routerLink="log">
                <i class="fas fa-file-alt"></i>
                <span>Report</span>
              </div>
              
  
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>