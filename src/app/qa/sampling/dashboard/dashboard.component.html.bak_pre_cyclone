<!-- ============================================ -->
<div class="component qa-legacy-dash">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Finish Product Sampling</h3>
          <div routerLink="/qa/approval" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Finish Product Sampling Section</h3>
              </div>
            </div>
            <div class="block-container" style="    
          display: grid;
          grid-template-columns: repeat(6, 150px);
          grid-gap: 35px;
          overflow-x: auto;
          max-width: 100%;">
              <div class="item-block" *ngIf="plant_id!=67" routerLink="receive">
                <i class="fas fa-bell"></i>
                <span>Receive Intimation</span>
              </div>

              <div class="item-block" *ngIf="plant_id==67" routerLink="spreceive">
                <i class="fas fa-bell"></i>
                <span>Receive Intimation</span>
              </div>

              <div class="item-block" routerLink="withdraw">
                <i class="fas fa-dolly"></i>
                <span>Withdraw Sample Qty</span>
              </div>

              <div class="item-block" *ngIf="ischecker=='Yes' || isapprover=='Yes'" routerLink="approval">
                <i class="fas fa-clipboard-check"></i>
                <span>AQA Test Report Appr</span>
              </div>

              <div class="item-block" *ngIf="ischecker=='Yes' || isapprover=='Yes'" routerLink="qa-approval">
                <i class="fas fa-clipboard-check"></i>
                <span>QA Approval</span>
              </div>

              <div class="item-block" routerLink="log">
                <i class="fas fa-book"></i>
                <span>Logbook</span>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>