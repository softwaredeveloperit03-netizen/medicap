<div class="component qa-legacy-dash">
    <div class="subsection">
        <div class="purchase-block">
            <div style="text-align:end" class="exit-section">
                <div class="header-block" style="margin:10px 0px">
                    <h3>Change Control Permanent</h3>
                    <div routerLink="/qa" class="name-board2"><i class="fas fa-times"></i>
                    </div>
                </div>

                <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
                    <div class="category">
                        <div class="line-section">
                            <div class="header-div">
                                <h3>Change Control Permanent Section</h3>
                            </div>
                        </div>
                        <div class="block-container" style="    
                        display: grid;
                        grid-template-columns: repeat(6, 150px);
                        grid-gap: 35px;
                        overflow-x: auto;
                        max-width: 100%;">

                            <div class="item-block" *ngIf="isuser == 'Yes'" routerLink="oinitiate">
                                <i class="fas fa-file"></i>
                                <span>Initiate CC</span>
                            </div>

                            <div class="item-block" *ngIf="ischecker=='Yes'" routerLink="Ochecking">
                                <i class="fas fa-clipboard-check"></i>
                                <span>CC for Dept Checkg</span>
                            </div>

                            <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="opreapproval">
                                <i class="fas fa-clipboard-check"></i>
                                <span>Pre Approval Of CC</span>
                            </div>

                            <div class="item-block" *ngIf="qms_approver=='Yes'" routerLink="ocustomer">
                                <i class="fas fa-user-check"></i>
                                <span>QA Review</span>
