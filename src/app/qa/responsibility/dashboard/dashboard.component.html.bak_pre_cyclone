<div class="component qa-legacy-dash">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Job Responsibilities</h3>
        <div routerLink="/qa" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>Job Responsibilities Section</h3>
            </div>
          </div>
          <div class="block-container">
            <div class="item-block" *ngIf="isuser == 'Yes'" routerLink="standard">
            <i class="fas fa-user-check"></i>
            <span>Standard Responsibilities</span>
          </div>
          
          <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="approval">
            <i class="fas fa-user-check"></i>
            <span>Emp. Responsibilities</span>
            <span>Approval</span>

          </div>
          
          <div class="item-block" routerLink="log">
            <i class="fas fa-book"></i>
            <span>Employees Respo. Log</span>
          </div>

          <div class="item-block" routerLink="new-emp">
            <i class="fas fa-book"></i>
            <span>New Emplyees</span>
          </div>
          <div class="item-block" routerLink="existing-emp">
            <i class="fas fa-book"></i>
            <span>Existing Emplyees</span>
          </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>