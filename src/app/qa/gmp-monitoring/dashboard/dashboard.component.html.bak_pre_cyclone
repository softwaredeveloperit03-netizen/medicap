<div class="component qa-legacy-dash">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>GMP Monitoring</h3>
        <div routerLink="/qa" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>GMP Monitoring Section</h3>
            </div>
          </div>
          <div class="block-container"><div class="item-block" *ngIf="ischecker=='Yes'" routerLink="master-checklist">
            <i class="fas fa-tasks"></i>
            <span>GMP Mon Master Chl</span>
          </div>
          
          <div class="item-block" routerLink="revision">
            <i class="fas fa-sync-alt"></i>
            <span>GMP Mon Revision</span>
          </div>
          
          <div class="item-block" routerLink="monitoring">
            <i class="fas fa-chart-line"></i>
            <span>GMP Monitoring</span>
          </div>
          
          <div class="item-block" routerLink="memo">
            <i class="fas fa-file-alt"></i>
            <span>GMP Memo</span>
          </div>
          
          <div class="item-block" routerLink="report">
            <i class="fas fa-file-chart-line"></i>
            <span>GMP Mon Reports</span>
          </div>
          
          <div class="item-block" routerLink="compliance">
            <i class="fas fa-file-signature"></i>
            <span>GMP Mon Compliance</span>
          </div>
          
          </div>
        </div>
      </div>
    </div>
  </div>
</div>