<div class="component qa-legacy-dash">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Deviation Management</h3>
        <div routerLink="/qa" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>Deviation Management Section</h3>
            </div>
          </div>
          <div class="block-container" style="    
          display: grid;
          grid-template-columns: repeat(6, 150px);
          grid-gap: 35px;
          overflow-x: auto;
          max-width: 100%;">
            <div class="item-block" routerLink="/qa/qms/deviation">
              <!-- Font Awesome icon for Initiating Deviation -->
              <i class="fas fa-pencil-alt"></i>
              <span>Initiate Deviation</span>
            </div>            

            <div class="item-block" routerLink="/qa/qms/deviation/riskassessment">
              <!-- Font Awesome icon for Risk Assessment -->
              <i class="fas fa-audit"></i>
              <span>Risk Assessment</span>
            </div>
            
            <div class="item-block" routerLink="condition">
              <!-- Font Awesome icon for Conditional & Final Approval -->
              <i class="fas fa-clipboard-check"></i>
              <span>Conditl & Final Apprvl</span>
            </div>
            
            <div class="item-block" routerLink="newlog">
              <!-- Font Awesome icon for Deviations Log -->
              <i class="fas fa-exclamation-triangle"></i>
              <span>Deviations Log</span>
            </div>            
          </div>
        </div>
      </div>
    </div>
  </div>
</div>