<div class="component qa-legacy-dash">
    <div class="subsection">
      <div class="purchase-block">
        <div style="text-align:end" class="exit-section">
          <div class="header-block" style="margin:10px 0px">
            <h3>Change Control Temporary</h3>
          <div routerLink="/qa" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>
  
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Change Control Temporary  Section</h3>
              </div>
            </div>
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">
            <div class="item-block" *ngIf="isuser == 'Yes'" routerLink="icc">
              <i class="fas fa-plus"></i>
              <span>Initiate CC</span>
            </div>
            
            <div class="item-block" routerLink="attachment">
              <i class="fas fa-upload"></i>
              <span>Upload Attachments</span>
            </div>
            
            <div class="item-block" *ngIf="ischecker=='Yes'" routerLink="checking">
              <i class="fas fa-tasks"></i>
              <span>CC for Dept Checking</span>
            </div>
            
            <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="preapproval">
              <i class="fas fa-check-double"></i>
              <span>Pre Approval Of CC</span>
            </div>
            
            <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="prechecking">
              <i class="fas fa-check-double"></i>
              <span>Pre Approval Check</span>
            </div>
            
            <div class="item-block" *ngIf="qms_approver=='Yes'" routerLink="review">
              <i class="fas fa-clipboard-check"></i>
              <span>Concerned Dept Rev</span>
            </div>
            
            <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="postapproval">
              <i class="fas fa-check-double"></i>
              <span>Post Approval of CC</span>
            </div>
            
            <div class="item-block" routerLink="postapproval1">
              <i class="fas fa-check-double"></i>
              <span>Approved By QA Head</span>
            </div>
            
            <div class="item-block" routerLink="extension">
              <i class="fas fa-calendar-plus"></i>
              <span>Extension of CC</span>
            </div>
            
            <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="extapproval">
              <i class="fas fa-clipboard-check"></i>
              <span>Extension Approval</span>
            </div>
            
            <div class="item-block" routerLink="additional">
              <i class="fas fa-clipboard-list"></i>
              <span>Additonal Eval/Plan</span>
            </div>
            
            <div class="item-block" routerLink="implementation">
              <i class="fas fa-tasks"></i>
              <span>Post Implementation</span>
            </div>
            
            <div class="item-block" routerLink="closing">
              <i class="fas fa-check-circle"></i>
              <span>Closure of CC</span>
            </div>
            
            <div class="item-block" routerLink="log">
              <i class="fas fa-book"></i>
              <span>Logbook</span>
            </div>
            

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>