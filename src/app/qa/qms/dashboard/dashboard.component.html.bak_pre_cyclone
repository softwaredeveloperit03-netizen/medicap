 

<div class="module">
  <div class="subdiv">
    <div class="purchase-container" >
      <div style="text-align:end" class="close-block">
        <div class="heading-container" style="margin:10px 0px">
          <h3>QMS</h3>
        </div>
        <div routerLink="/" class="name-board1"><i class="fas fa-times"></i>
        </div>
      </div>
      <div class="master-block" style="margin: 0px 10px 10px 10px !important;">
        <div class="section">
          <div class="line-container">
            <div class="heading">
              <h3>QMS Section</h3>
            </div>
          </div>
          <div class="card-block">
            <!-- <div class="icon-container" routerLink="deviation"> -->
            <div class="icon-container" routerLink="deviation">
              <i class="fas fa-exclamation-triangle"></i> <!-- Font Awesome icon for Deviation -->
              <span>Deviation</span>
            </div>

            <!-- <div class="icon-container" routerLink="change-control"> -->
            <div class="icon-container" routerLink="change-control"  >
              <i class="fas fa-edit"></i> <!-- Font Awesome icon for Change Control -->
              <span>Change Control</span>
            </div>

   

            <div
              *ngIf="['Quality Assurance', 'Store' ,'Regulatory', 'R AND D', 'Quality Control', 'Microbiology', 'Engineering', 'Human Resource'].includes(Department)"
              class="item-block" [routerLink]="['/change-control']">
              <i class="fas fa-tasks"></i>
              <span>Change Control Closure</span>
            </div>

            <div class="item-block" routerLink="sops">
              <i class="fas fa-file-alt"></i>
              <span>SOP</span>
            </div>
            <!-- <div class="item-block" routerLink="risk">
              <i class="fas fa-file-alt"></i>
              <span>Risk</span>
            </div> -->
            <div class="item-block" routerLink="capa">
              <i class="fas fa-file-alt"></i>
              <span>CAPA</span>
            </div>
            <div class="item-block" routerLink="incident">
              <i class="fas fa-file-alt"></i>
              <span>Incident</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>