/* CC Travel Bar - compact, professional */
.cc-travel-wrap {
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 0.65rem 1rem;
  margin-bottom: 1rem;
}

.cc-travel-search-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.cc-travel-label {
  font-size: 0.8rem;
  font-weight: 600;
  color: #475569;
  margin: 0;
  white-space: nowrap;
}

.cc-travel-input {
  flex: 1;
  min-width: 180px;
  max-width: 320px;
  padding: 0.4rem 0.65rem;
  font-size: 0.85rem;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.cc-travel-input:focus {
  outline: none;
  border-color: #0e4270;
  box-shadow: 0 0 0 2px rgba(14, 66, 112, 0.2);
}

.cc-travel-btn {
  padding: 0.4rem 0.75rem;
  font-size: 0.8rem;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #0e4270 0%, #1565a0 100%);
  border: none;
  border-radius: 6px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  white-space: nowrap;
}

.cc-travel-btn:hover {
  filter: brightness(1.08);
}

.cc-travel-message {
  font-size: 0.8rem;
  color: #64748b;
  margin-top: 0.4rem;
  margin-bottom: 0.35rem;
}

.cc-travel-bar-block {
  margin-top: 0.5rem;
}

.cc-travel-bar-track {
  position: relative;
  height: 10px;
  background: #e2e8f0;
  border-radius: 10px;
  overflow: visible;
}

.cc-travel-bar-fill {
  height: 100%;
  border-radius: 10px;
  background: linear-gradient(90deg, #22c55e 0%, #16a34a 100%);
  transition: width 0.6s ease-out;
  box-shadow: 0 0 8px rgba(34, 197, 94, 0.4);
}

.cc-travel-arrow {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 0;
  height: 0;
  border-left: 8px solid #0e4270;
  border-top: 6px solid transparent;
  border-bottom: 6px solid transparent;
  transition: left 0.5s ease-out;
  filter: drop-shadow(0 1px 2px rgba(0,0,0,0.2));
  z-index: 2;
}

.cc-travel-steps {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem 0.75rem;
  margin-top: 0.5rem;
  row-gap: 0.35rem;
}

.cc-travel-step {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.75rem;
  padding: 0.2rem 0.4rem;
  border-radius: 4px;
  background: #f1f5f9;
  border: 1px solid #e2e8f0;
}

.cc-travel-step.done {
  background: #dcfce7;
  border-color: #86efac;
  color: #166534;
}

.cc-travel-step.pending {
  background: #fefce8;
  border-color: #fde047;
  color: #854d0e;
}

.cc-travel-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}

.cc-travel-step.done .cc-travel-dot {
  background: #22c55e;
  box-shadow: 0 0 6px rgba(34, 197, 94, 0.6);
  animation: cc-pulse-done 1.2s ease-in-out infinite;
}

.cc-travel-step.pending .cc-travel-dot {
  background: #eab308;
  animation: cc-pulse-pending 1.2s ease-in-out infinite;
}

.cc-travel-step-label {
  font-weight: 600;
}

.cc-travel-step-meta {
  font-size: 0.7rem;
  opacity: 0.9;
}

.cc-travel-step-meta.pending-txt {
  font-style: italic;
}

@keyframes cc-pulse-done {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.85; transform: scale(1.15); }
}

@keyframes cc-pulse-pending {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.2); }
}
