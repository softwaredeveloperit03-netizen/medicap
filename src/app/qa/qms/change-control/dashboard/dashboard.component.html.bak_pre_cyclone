<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Change Control</h3>
          <div routerLink="/qa/qms" class="name-board2"><i class="fas fa-times"></i></div>
        </div>

        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <!-- CC Travel Bar: Search + Progress -->
            <div class="cc-travel-wrap">
              <div class="cc-travel-search-row">
                <label class="cc-travel-label">CC Number</label>
                <input type="text" class="cc-travel-input" placeholder="Enter CC No. (e.g. CCF/QAD/25-26/001)" [(ngModel)]="ccSearch" (keyup.enter)="loadTravelHistory()" />
                <button type="button" class="cc-travel-btn" (click)="loadTravelHistory()">
                  <i class="fas fa-search"></i> Search
                </button>
              </div>
              <div class="cc-travel-message" *ngIf="travelMessage">{{ travelMessage }}</div>
              <div class="cc-travel-bar-block" *ngIf="travelStages && travelStages.length">
                <div class="cc-travel-bar-track">
                  <div class="cc-travel-bar-fill" [style.width.%]="travelProgressPercent"></div>
                  <div class="cc-travel-arrow" [style.left.%]="travelProgressPercent"></div>
                </div>
                <div class="cc-travel-steps">
                  <div class="cc-travel-step" *ngFor="let s of travelStages; let i = index" [class.done]="s.completed" [class.pending]="!s.completed">
                    <span class="cc-travel-dot"></span>
                    <span class="cc-travel-step-label">{{ s.label }}</span>
                    <span class="cc-travel-step-meta" *ngIf="s.date">{{ s.date | date:'dd/MM/yyyy' }}<span *ngIf="s.user"> · {{ s.user }}</span></span>
                    <span class="cc-travel-step-meta pending-txt" *ngIf="!s.completed && !s.date">Pending</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="line-section">
              <div class="header-div">
                <h3>Change Control</h3>
              </div>
            </div>
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">
              <!-- *ngIf="isuser == 'Yes'"  -->
              <div class="item-block" routerLink="new">
                <i class="fas fa-plus-circle"></i>
                <span>Initiaton Of CC</span>
              </div>

              <div *ngIf="Department=='Quality Assurance'" class="item-block" routerLink="consernAndReview">
                <i class="fas fa-tasks"></i>
                <span>CC IMPACT ASSESSMENT</span>
              </div>


              <div class="item-block" routerLink="deptConAndRev">
                <i class="fas fa-tasks"></i>
                <span>Dept Consent & Review</span>
              </div>

              <div *ngIf="Department=='Quality Assurance'" class="item-block" routerLink="assessmentByQa">
                <i class="fas fa-tasks"></i>
                <span> QA Manager</span>
                <span> After Dept Review </span>
              </div>
              
              <div *ngIf="Department=='Quality Assurance'" class="item-block" routerLink="actionAndReviewByQA">
                <i class="fas fa-tasks"></i>
                <span>Reviewed By QA</span>
              </div>

              <!--  <div *ngIf="Department=='Regulatory'" class="item-block"
               routerLink="impactRegulatory">
                <i class="fas fa-tasks"></i>
                <span>Impact On Regulatory Affairs And</span>
                <span>Marketing Auth. / Customer</span>
              </div>

           
              <div *ngIf="Department=='Quality Assurance'" class="item-block"
               routerLink="qaAssementChecklist">
                <i class="fas fa-tasks"></i>
                <span>QA Assessment Checklist</span>
              </div>

              <div *ngIf="Department=='Quality Assurance'" class="item-block"
               routerLink="closinChecklist">
                <i class="fas fa-tasks"></i>
                <span>Closin Checklist</span>
              </div> -->
      

              <div class="item-block" routerLink="log">
                <i class="fas fa-clipboard-list"></i>
                <span>Log</span>
              </div> 

            </div>
          </div>
        </div>
        <!-- section1 -->

      </div>
    </div>
  </div>
</div>