          <button class="btn btn-sm btn-success" *ngIf="isuser == 'Yes'" routerLink="new">{{'common.new' | translate}}</button>
          <button class="btn btn-sm btn-danger" routerLink="/qa/soft-restriction">{{'common.close' | translate}}</button>
        </div>
      </div>
    </div>
