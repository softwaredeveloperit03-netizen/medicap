/* Align Software Restriction dashboard cards in a clean grid */
.block-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 16px;
  width: 100%;
  align-items: stretch;
}

.item-block {
  min-height: 120px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 8px;
  padding: 10px 8px;
  border-radius: 10px;
  cursor: pointer;
}

.item-block i {
  font-size: 22px;
}

.item-block span {
  display: block;
  font-size: 13px;
  line-height: 1.3;
  white-space: normal;
  word-break: break-word;
}
