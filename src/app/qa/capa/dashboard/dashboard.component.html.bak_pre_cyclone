<div class="component qa-legacy-dash">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>CAPA</h3>
          <div routerLink="/qa" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>CAPA Section</h3>
              </div>
            </div>
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">

              <div class="item-block" *ngIf="isuser == 'Yes'" routerLink="new">
                <i class="fas fa-plus-circle"></i>
                <span>New CAPA</span>
              </div>

              <div class="item-block" *ngIf="ischecker=='Yes'" routerLink="checking">
                <i class="fas fa-check-circle"></i>
                <span>Initiatg Dept. Head Checkg</span>
              </div>

              <div class="item-block" routerLink="review1">
                <i class="fas fa-clipboard-check"></i>
                <span>QA Assessment</span>
              </div>

              <div class="item-block" *ngIf="qms_approver=='Yes'" routerLink="review2">
                <i class="fas fa-clipboard-check"></i>
                <span>QA Asses Rev By HQA</span>
              </div>

              <div class="item-block" *ngIf="qms_approver=='Yes'" routerLink="review3">
                <i class="fas fa-clipboard-check"></i>
                <span>QA Asses Rev By Q Hd</span>
              </div>

              <div class="item-block" routerLink="closing">
                <i class="fas fa-file-alt"></i>
                <span>CAPA Closing</span>
              </div>

              <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="closing1">
                <i class="fas fa-file-alt"></i>
                <span>CAPA Closg Aprvl By Dept</span>
              </div>

              <div class="item-block" routerLink="verification">
                <i class="fas fa-file-check"></i>
                <span>CAPA Closing Veriftn</span>
              </div>

              <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="verification1">
                <i class="fas fa-file-check"></i>
                <span>CAPA Closg Verif Aprvl</span>
              </div>

              <div class="item-block" routerLink="log">
                <i class="fas fa-book"></i>
                <span>CAPA Log</span>
              </div>


            </div>

          </div>




        <div class="line-section">
          <div class="header-div">
            <h3>EFFECTIVENESS PLAN:</h3>
          </div>
        </div>
        <div class="block-container" style="    
        display: grid;
        grid-template-columns: repeat(6, 150px);
        grid-gap: 35px;
        overflow-x: auto;
        max-width: 100%;">

          <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="plan-dept-head">
            <i class="fas fa-tasks"></i>
            <span>Effectvs Plan HOD Apprvl</span>
          </div>

          <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="head-approval">
            <i class="fas fa-user-check"></i>
            <span>QA Head Approval</span>
          </div>

          <div class="item-block" routerLink="plan-verification">
            <i class="fas fa-tasks"></i>
            <span>Effectvs Plan Veriftn</span>
          </div>

          <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="plan-head-approval">
            <i class="fas fa-user-check"></i>
            <span>Effects Plan QAH Apprvl</span>
          </div>

          <div class="item-block" routerLink="closure-plan">
            <i class="fas fa-tasks"></i>
            <span>Closr of Effectvs Plan</span>
          </div>

          <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="closure-approval">
            <i class="fas fa-user-check"></i>
            <span>Closr Apprvl by H QA</span>
          </div>

        </div>



  </div>
</div>
</div>
