<div class="ehs-dash dashboard-shell" [style.background]="selectedPalette.background">
  <div class="compact-layout">
    <aside class="compact-sidebar">
      <div class="compact-sidebar__head">
        <span class="compact-sidebar__title">Categories</span>
        <span class="compact-sidebar__count">{{ filteredItems.length }}</span>
      </div>
      <div class="compact-sidebar__tabs">
        <button
          *ngFor="let cat of categories"
          type="button"
          class="compact-chip"
          [class.active]="cat === selectedCategory"
          (click)="selectCategory(cat)"
        >
          <i class="fas" [ngClass]="getCategoryIconClass(cat)" aria-hidden="true"></i>
          {{ cat }}
        </button>
      </div>
    </aside>

    <div class="compact-main">
      <div class="dash-header">
        <div class="dash-header__row">
          <div class="title-block">
            <h2><i class="fas fa-shield-alt" aria-hidden="true"></i> EHS Department</h2>
            <p class="title-sub">Environment, health &amp; safety modules</p>
          </div>
          <div class="header-actions-row">
            <div class="search-box">
              <i class="fas fa-search" aria-hidden="true"></i>
              <input
                type="text"
                [ngModel]="searchQuery"
                (ngModelChange)="onSearchChange($event)"
                placeholder="Search modules..."
                aria-label="Search EHS modules"
                maxlength="100"
              />
            </div>
            <a class="close-btn" routerLink="/" aria-label="Close">
              <i class="fas fa-times"></i>
              Close
            </a>
          </div>
        </div>
      </div>

      <div class="compact-main__body">
        <div class="toolbar-row">
          <h3 class="section-label">EHS Section</h3>
          <div class="quick-links">
            <a class="quick-link-btn" routerLink="/qa/qms">QMS</a>
            <a class="quick-link-btn" routerLink="/hrfordepthead" *ngIf="dept_head === 'Yes'">Dept Head</a>
          </div>
        </div>

        <div class="tiles-grid">
          <a
            *ngFor="let item of filteredItems; trackBy: trackByItemId"
            class="tile-card"
            [routerLink]="item.route"
            [ngStyle]="{ 'box-shadow': selectedPalette.cardShadow }"
          >
            <div class="icon-wrap" [style.background]="item.gradient">
              <i [class]="item.icon" aria-hidden="true"></i>
            </div>
            <div class="tile-body">
              <div class="tile-title">{{ item.name }}</div>
              <p class="tile-description">{{ item.category }} module</p>
            </div>
            <span class="tile-badge" *ngIf="getPendingCount(item.id) > 0">{{ getPendingCount(item.id) }}</span>
          </a>

          <div class="empty-state" *ngIf="filteredItems.length === 0">
            <i class="fas fa-search"></i>
            <p>No modules match your search. Try another keyword or category.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <button class="palette-fab" type="button" (click)="togglePalette()" title="Change theme" aria-label="Change theme">
    <i class="fas fa-palette"></i>
  </button>

  <div class="palette-drawer" *ngIf="showPalette">
    <button
      *ngFor="let palette of paletteOptions"
      type="button"
      class="palette-chip"
      [class.active]="palette === selectedPalette"
      [style.background]="palette.swatch"
      [title]="palette.name"
      (click)="setPalette(palette)"
      [attr.aria-label]="'Theme ' + palette.name"
    >
      <span class="sr-only">{{ palette.name }}</span>
    </button>
  </div>
</div>
