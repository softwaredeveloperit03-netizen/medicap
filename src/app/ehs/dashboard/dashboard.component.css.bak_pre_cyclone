/* EHS dashboard — sidebar + compact chip cards (matches regulatory layout) */
:host {
  display: block;
  --text-primary: #0f172a;
  --text-secondary: #475569;
  --card-bg: #ffffff;
  --ehs-header-start: #0f766e;
  --ehs-header-mid: #0d9488;
  --ehs-header-end: #14b8a6;
  --ehs-sidebar-active: rgba(20, 184, 166, 0.22);
  --ehs-sidebar-active-border: rgba(45, 212, 191, 0.55);
}

.ehs-dash.dashboard-shell {
  box-sizing: border-box;
  padding: 12px 16px 48px;
  background-size: cover;
  color: var(--text-primary);
}

.ehs-dash *,
.ehs-dash *::before,
.ehs-dash *::after {
  box-sizing: border-box;
}

.compact-layout {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  gap: 14px;
  align-items: start;
}

.compact-sidebar {
  display: flex;
  flex-direction: column;
  background: #0f172a;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 12px;
  padding: 12px 10px;
  box-shadow: 4px 0 20px rgba(0, 0, 0, 0.08);
  position: sticky;
  top: 12px;
}

.compact-sidebar__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.22);
  margin-bottom: 10px;
  color: #f8fafc;
}

.compact-sidebar__title {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.compact-sidebar__count {
  min-width: 22px;
  height: 22px;
  border-radius: 999px;
  padding: 0 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.14);
  color: #f8fafc;
  font-size: 10px;
  font-weight: 700;
}

.compact-sidebar__tabs {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.compact-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  text-align: left;
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.2;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  border: 1px solid rgba(148, 163, 184, 0.35);
  background: rgba(255, 255, 255, 0.06);
  color: #e2e8f0;
}

.compact-chip i {
  width: 14px;
  text-align: center;
  font-size: 11px;
  opacity: 0.9;
}

.compact-chip.active,
.compact-chip:hover {
  background: var(--ehs-sidebar-active);
  border-color: var(--ehs-sidebar-active-border);
  color: #fff;
}

.compact-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
}

.dash-header {
  padding: 14px 18px;
  background: linear-gradient(135deg, var(--ehs-header-start) 0%, var(--ehs-header-mid) 42%, var(--ehs-header-end) 100%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.dash-header__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.title-block h2 {
  margin: 0;
  font-size: 1.35rem;
  font-weight: 700;
  line-height: 1.2;
  color: #fff;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.title-sub {
  margin: 4px 0 0;
  font-size: 0.75rem;
  line-height: 1.3;
  color: rgba(255, 255, 255, 0.88);
}

.header-actions-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  flex: 1 1 320px;
  min-width: 0;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1 1 280px;
  max-width: 420px;
  min-width: 200px;
  background: #fff;
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: 8px;
  padding: 0 12px;
  height: 40px;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.1);
}

.ehs-dash .search-box input {
  flex: 1;
  width: auto !important;
  min-width: 0;
  height: auto !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  outline: none;
  font-size: 13px;
  background: transparent !important;
  color: var(--text-primary);
  box-shadow: none !important;
}

.search-box i {
  color: #64748b;
  flex-shrink: 0;
}

.close-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 40px;
  padding: 0 18px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  border: none;
  color: #fff;
  text-decoration: none;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(239, 68, 68, 0.35);
}

.close-btn:hover {
  color: #fff;
}

.compact-main__body {
  display: block;
  padding: 12px 14px 14px;
}

.toolbar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 10px;
  padding-bottom: 8px;
  border-bottom: 1px solid #e2e8f0;
}

.section-label {
  margin: 0;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
}

.quick-links {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.quick-link-btn {
  display: inline-flex;
  align-items: center;
  height: 30px;
  padding: 0 12px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
  white-space: nowrap;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #fff;
  text-decoration: none;
}

.tiles-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 8px;
  align-items: start;
}

.tile-card {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10px;
  height: 64px;
  padding: 8px 10px;
  background: var(--card-bg);
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  text-decoration: none;
  color: inherit;
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}

.tile-card:hover {
  transform: translateY(-1px);
  border-color: #cbd5e1;
  box-shadow: 0 6px 14px rgba(15, 23, 42, 0.08) !important;
}

.icon-wrap {
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  border-radius: 8px;
  display: grid;
  place-items: center;
  color: #fff;
  font-size: 14px;
}

.tile-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1px;
}

.tile-title {
  font-weight: 700;
  font-size: 12px;
  line-height: 1.25;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tile-description {
  margin: 0;
  font-size: 10px;
  line-height: 1.3;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tile-badge {
  position: absolute;
  top: 6px;
  right: 6px;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: 999px;
  background: #ef4444;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.empty-state {
  grid-column: 1 / -1;
  text-align: center;
  padding: 32px 16px;
  background: #f8fafc;
  border: 1px dashed #cbd5e1;
  border-radius: 12px;
  color: var(--text-secondary);
}

.empty-state i {
  display: block;
  font-size: 22px;
  margin-bottom: 8px;
  color: #94a3b8;
}

.palette-fab {
  position: fixed;
  right: 22px;
  bottom: 26px;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: none;
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  color: #fff;
  box-shadow: 0 12px 28px rgba(15, 118, 110, 0.35);
  cursor: pointer;
  font-size: 17px;
  display: grid;
  place-items: center;
  z-index: 100;
}

.palette-drawer {
  position: fixed;
  left: 50%;
  bottom: 82px;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
  padding: 10px 14px;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 999px;
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
  z-index: 99;
}

.palette-chip {
  width: 28px;
  height: 28px;
  padding: 0;
  border-radius: 50%;
  border: 2px solid transparent;
  cursor: pointer;
}

.palette-chip.active {
  border-color: #1f2937;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@media (max-width: 1024px) {
  .compact-layout {
    grid-template-columns: 1fr;
  }

  .compact-sidebar {
    position: static;
  }

  .compact-sidebar__tabs {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .compact-chip {
    width: auto;
    flex: 0 0 auto;
  }
}

@media (max-width: 768px) {
  .dash-header__row,
  .header-actions-row {
    flex-direction: column;
    align-items: stretch;
  }

  .search-box {
    max-width: none;
    width: 100%;
  }

  .close-btn {
    width: 100%;
  }
}

@media (max-width: 520px) {
  .tiles-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
