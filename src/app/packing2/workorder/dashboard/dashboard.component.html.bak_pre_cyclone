<div class="card" *ngIf="!isView">
    <div class="card-header" style="text-align: center">
      <div class="clr-row" style="margin-bottom: -10px;">
        <div class="clr-col-lg-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Work Order / Data Sheet</div>
        <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
          <button class="btn btn-sm btn-danger" routerLink="/packing">{{'common.close' | translate}}</button>
        </div>
      </div>
    </div>
    <div class="card-block">
        <div class="card-text">
            <div class="clr-row">
                <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
                    <div class="card clickable"style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
                    routerLink="/packing/configuration">
                      <div class="card-block" style="text-align: center; border-top: solid 3px rgb(0, 51, 102); border-radius: 7px;">
                        <img width="50px" height="50px" src="assets/indend.png">
                        <p class="card-text"><b>Packing Configuration</b></p>
                      </div>
                    </div>
                </div>

                <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
                    <div class="card clickable"style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
                    routerLink="new">
                      <div class="card-block" style="text-align: center; border-top: solid 3px rgb(0, 51, 102); border-radius: 7px;">
                        <img width="50px" height="50px" src="assets/indend.png">
                        <p class="card-text"><b>New Work Order</b></p>
                      </div>
                    </div>
                </div>
            </div>
            <table class="table">
                <tr>
                    <th>Sr.</th>
                    <th>{{'common.category' | translate}}</th>
                    <th>Client Type</th>
                    <th>Client Name</th>
                    <th>Product Name</th>
                    <th>Batch Size</th>
                    <th>Pack Size</th>
                    <th>{{'common.table.action' | translate}}</th>
                </tr>
                <tr *ngFor="let result of results; let i = index">
                    <td>{{ i + 1 }}.</td>
                    <td>{{ result.category }}</td>
                    <td>{{ result.client_type }}</td>
                    <td>{{ result.client_name }}</td>
                    <td>{{ result.product_name}}</td>
                    <td>{{ result.batch_size }}</td>
                    <td>{{ result.pack_size }}</td>
                    <td>
                        <button class="btn btn-sm btn-info" (click)="view(i)">{{'common.view' | translate}}</button>
                    </td>
                </tr>
                <tr *ngIf="results?.length == 0">
                    <td colspan="7">No. Records Found!</td>
                </tr>
            </table>
        </div>
    </div>
</div>

<div class="card" *ngIf="isView">
    <div class="card-header">Work Order / Data Sheet</div>
    <div class="card-block">
        <div class="card-text">
            <table class="table">
                <tr *ngIf="selectedResult['client_type'] !== 'Own'">
                    <td style="text-align: left;">Client Code</td>
                    <td style="text-align: left;">{{selectedResult['client_code']}}</td>
                    <td style="text-align: left;">Client Name</td>
                    <td style="text-align: left;">{{selectedResult['client_name']}}</td>
                </tr>
                <tr>
                    <td style="text-align: left;">Product Name</td>
                    <td style="text-align: left;">{{selectedResult['product_name']}}</td>
                    <td style="text-align: left;">Pack Size</td>
                    <td style="text-align: left;">{{selectedResult['pack_size']}}</td>
                </tr>
            </table>
            <h3>Packing Configuration:</h3>
            <div class="clr-row">
                <div class="clr-col-lg-4">
                    <label>Packing Style:</label>
                </div>
                <div class="clr-col-lg-4">
                    <label>Primary Qty: {{selectedResult['primary_qty']}}</label>
                </div>
                <div class="clr-col-lg-4">
                    <label>Shipper Qty: {{selectedResult['shipper_qty']}}</label>
                </div>
            </div>
            <h3>Primary Packing Materials:</h3>
            <table class="table">
                <tr>
                    <th>Sr.</th>
                    <th style="text-align: left;">Material Code</th>
                    <th>Qty</th>
                    <th>Overages</th>
                    <th>Total Qty</th>
                    <th style="text-align: left;">Role</th>
                    <th style="text-align: left;">Printing Status</th>
                </tr>
                <tr *ngFor="let comp of primarymaterialList; let i = index">
                    <td>{{ i + 1 }}.</td>
                    <td style="text-align: left;">{{ comp.material_code }}</td>
                    <td>{{ comp.qty }}</td>
                    <td>{{ comp.overages }}</td>
                    <td>{{ comp.totalqty }} {{ comp.unit }}</td>
                    <td style="text-align: left;">{{ comp.role }}</td>
                    <td style="text-align: left;">{{ comp.print }}</td>
                </tr>
                <tr *ngIf="primarymaterialList.length == 0">
                    <td colspan="7">{{'common.noRecords' | translate}}</td>
                </tr>
            </table>
            <h3>Secondary Packing Materials:</h3>
            <table class="table">
                <tr>
                    <th>Sr.</th>
                    <th style="text-align: left;">Material Code</th>
                    <th>Qty</th>
                    <th>Overages</th>
                    <th>Total Qty</th>
                    <th style="text-align: left;">Role</th>
                    <th style="text-align: left;">Printing Status</th>
                </tr>
                <tr *ngFor="let comp of secondarymaterialList; let i = index">
                    <td>{{ i + 1 }}.</td>
                    <td style="text-align: left;">{{ comp.material_code }}</td>
                    <td>{{ comp.qty }}</td>
                    <td>{{ comp.overages }}</td>
                    <td>{{ comp.totalqty }} {{ comp.unit }}</td>
                    <td style="text-align: left;">{{ comp.role }}</td>
                    <td style="text-align: left;">{{ comp.print }}</td>
                </tr>
                <tr *ngIf="secondarymaterialList.length == 0">
                    <td colspan="7">{{'common.noRecords' | translate}}</td>
                </tr>
            </table>
            <h3>Tertiary Packing Materials:</h3>
            <table class="table">
                <tr>
                    <th>Sr.</th>
                    <th style="text-align: left;">Material Code</th>
                    <th>Qty</th>
                    <th>Overages</th>
                    <th>Total Qty</th>
                    <th style="text-align: left;">Role</th>
                    <th style="text-align: left;">Printing Status</th>
                </tr>
                <tr *ngFor="let comp of tertiarymaterialList; let i = index">
                    <td>{{ i + 1 }}.</td>
                    <td style="text-align: left;">{{ comp.material_code }}</td>
                    <td>{{ comp.qty }}</td>
                    <td>{{ comp.overages }}</td>
                    <td>{{ comp.totalqty }} {{ comp.unit }}</td>
                    <td style="text-align: left;">{{ comp.role }}</td>
                    <td style="text-align: left;">{{ comp.print }}</td>
                </tr>
                <tr *ngIf="tertiarymaterialList.length == 0">
                    <td colspan="7">{{'common.noRecords' | translate}}</td>
                </tr>
            </table>
            <h3>Other Packing Materials:</h3>
            <table class="table">
                <tr>
                    <th>Sr.</th>
                    <th style="text-align: left;">Material Code</th>
                    <th>Qty</th>
                    <th>Overages</th>
                    <th>Total Qty</th>
                    <th style="text-align: left;">Role</th>
                    <th style="text-align: left;">Printing Status</th>
                </tr>
                <tr *ngFor="let comp of othermaterialList; let i = index">
                    <td>{{ i + 1 }}.</td>
                    <td style="text-align: left;">{{ comp.material_code }}</td>
                    <td>{{ comp.qty }}</td>
                    <td>{{ comp.overages }}</td>
                    <td>{{ comp.totalqty }} {{ comp.unit }}</td>
                    <td style="text-align: left;">{{ comp.role }}</td>
                    <td style="text-align: left;">{{ comp.print }}</td>
                </tr>
                <tr *ngIf="othermaterialList.length == 0">
                    <td colspan="7">{{'common.noRecords' | translate}}</td>
                </tr>
            </table>
        </div>
    </div>
    <div class="card-footer">
      <button class="btn btn-danger" (click)="isView = false">{{'common.close' | translate}}</button>
    </div>
</div>