<div class="container-fluid">
    <div class="card">
       <div class="card-header" style="text-align: center">
        <div class="clr-row" style="margin-bottom: -10px;">
          <div class="clr-col-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Incident Report</div>
          <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
            <button class="btn btn-sm" routerLink="/production" style="background-color: red;color: white;">
              <clr-icon shape="window-close" class="is-solid"></clr-icon> CLOSE
            </button>
          </div>
        </div>
       </div>
      <div class="card-block">
        <div class="card-text">
          <div class="clr-row">
            <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12">
              <div class="card clickable" routerLink="form">
                <div class="card-block" style="text-align: center">
                  <img width="50px" height="50px" src="assets/report.png">
                  <p class="card-text"><b>New Incident</b></p>
                </div>
              </div>
            </div>


            <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12" *ngIf="isChecker || isApprover">
              <div class="card clickable" routerLink="checker">
                <div class="card-block" style="text-align: center">
                  <img width="50px" height="50px" src="assets/assessment.png">
                  <p class="card-text"><b>Incident for Checking</b></p>
                </div>
              </div>
            </div>

            <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12">
              <div class="card clickable" routerLink="log">
                <div class="card-block" style="text-align: center">
                  <img width="50px" height="50px" src="assets/log-book.png">
                  <p class="card-text"><b>Incident Log</b></p>
                </div>
              </div>
            </div>

            <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12">
              <div class="card clickable" routerLink="trend">
                <div class="card-block" style="text-align: center">
                  <img width="50px" height="50px" src="assets/log-book.png">
                  <p class="card-text"><b>Incident Trend</b></p>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
</div>
