<div class="container-fluid">
    <div class="card">
        <div class="card-header">Dispensing of Material</div>
        <div class="card-block">
            <div class="card-text">
                <div class="clr-row">

                  <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12" *ngIf="service.isChecker || service.isApprover">
                    <div class="card clickable" routerLink="/dispensing/allocation">
                      <div class="card-block" style="text-align: center">
                        <img width="75px" height="75px" src="assets/requisition.png">
                        <p class="card-text"><b>Awaiting Dispensing Requests</b></p>
                      </div>
                    </div>
                  </div>

                  <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12" *ngIf="service.isUser">
                    <div class="card clickable" routerLink="/dispensing/dispense">
                      <div class="card-block" style="text-align: center">
                        <img width="75px" height="75px" src="assets/new.png">
                        <p class="card-text"><b>Dispensing Form</b></p>
                      </div>
                    </div>
                  </div>

                  <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12">
                    <div class="card clickable" routerLink="/dispensing/clearance-approval">
                      <div class="card-block" style="text-align: center">
                        <img width="75px" height="75px" src="assets/approval.png">
                        <p class="card-text"><b>Line Clearance Approval</b></p>
                      </div>
                    </div>
                  </div>

                  <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12" *ngIf="service.isChecker">
                    <div class="card clickable" routerLink="/dispensing/checking">
                      <div class="card-block" style="text-align: center">
                        <img width="75px" height="75px" src="assets/log.png">
                        <p class="card-text"><b>Dispensing for Checking</b></p>
                      </div>
                    </div>
                  </div>

                  <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12" *ngIf="service.isApprover">
                    <div class="card clickable" routerLink="/dispensing/approval">
                      <div class="card-block" style="text-align: center">
                        <img width="75px" height="75px" src="assets/log.png">
                        <p class="card-text"><b>Dispensing for Approval</b></p>
                      </div>
                    </div>
                  </div>

                  <!-- <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12">
                    <div class="card clickable" routerLink="/dispensing/receive">
                      <div class="card-block" style="text-align: center">
                        <img width="75px" height="75px" src="assets/log.png">
                        <p class="card-text"><b>Receive Dispensing Masterial</b></p>
                      </div>
                    </div>
                  </div> -->

                  <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12">
                    <div class="card clickable" routerLink="/dispensing/log">
                      <div class="card-block" style="text-align: center">
                        <img width="75px" height="75px" src="assets/log.png">
                        <p class="card-text"><b>Dispensing Log</b></p>
                      </div>
                    </div>
                  </div>

                </div>
            </div>
        </div>
    </div>
</div>