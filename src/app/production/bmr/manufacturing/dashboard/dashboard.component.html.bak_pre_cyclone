<div class="card">
    <div class="card-header" style="text-align: center">
      <div class="clr-row" style="margin-bottom: -10px;">
        <div class="clr-col-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Batch Manufacturing</div>
        <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
          <button class="btn btn-sm btn-danger" routerLink="/production/bmr">{{'common.close' | translate}}</button>
        </div>
      </div>
    </div>
    <div class="card-block">
      <div class="card-text">
        <div class="clr-row">
          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12">
            <div class="card clickable" routerLink="start">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/plan.png">
                <p class="card-text"><b>Start Production</b></p>
              </div>
            </div>
          </div>



          


          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12">
            <div class="card clickable" routerLink="dispensing">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/shortages.png">
                <p class="card-text"><b>Dispensing Request</b></p>
              </div>
            </div>
          </div>
          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12">
            <div class="card clickable" routerLink="inprocess">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/completed.png">
                <p class="card-text"><b>Manufacturing Procedure</b></p>
              </div>
            </div>
          </div>
  
          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12">
            <div class="card clickable" routerLink="upload">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/yield.png">
                <p class="card-text"><b>Upload BMR</b></p>
              </div>
            </div>
          </div>


          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12">
            <div class="card clickable" routerLink="requisition">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/shortages.png">
                <p class="card-text"><b>Additional Material Requisition</b></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>