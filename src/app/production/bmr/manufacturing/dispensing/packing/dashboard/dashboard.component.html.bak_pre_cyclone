<div class="card">
    <div class="card-header" style="text-align: center">
        <div class="clr-row" style="margin-bottom: -10px;">
          <div class="clr-col-lg-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Packing Material Requisition / Dispensing</div>
          <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
            <button class="btn btn-sm btn-danger" routerLink="/manufacturing/plant9/packing">{{'common.close' | translate}}</button>
          </div>
        </div>
    </div>
    <div class="card-block">
        <div class="card-text">

            <div class="clr-row">
                <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
                    <div class="card clickable" routerLink="request">
                        <div class="card-block" style="text-align: center">
                            <img width="70px" height="70px" src="assets/requisition.png">
                            <p class="card-text"><b>Dispensing Requisition</b></p>
                        </div>
                    </div>
                </div>

                <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
                    <div class="card clickable" routerLink="activity">
                        <div class="card-block" style="text-align: center">
                            <img width="70px" height="70px" src="assets/material.png">
                            <p class="card-text"><b>Dispensing Activity</b></p>
                        </div>
                    </div>
                </div>

                <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
                    <div class="card clickable" routerLink="receiving">
                        <div class="card-block" style="text-align: center">
                            <img width="70px" height="70px" src="assets/receiving.png">
                            <p class="card-text"><b>Dispensed Material Receiving</b></p>
                        </div>
                    </div>
                </div>

                <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
                    <div class="card clickable" routerLink="status">
                        <div class="card-block" style="text-align: center">
                            <img width="70px" height="70px" src="assets/log.png">
                            <p class="card-text"><b>Dispensed Status</b></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>