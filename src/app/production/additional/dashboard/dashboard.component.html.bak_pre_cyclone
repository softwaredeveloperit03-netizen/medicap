<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Additional Material Requistion</h3>
        <div routerLink="/fproduction" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>Additional Material Requistion Section</h3>
            </div>
          </div>
          <div class="block-container">
            <div class="item-block" routerLink="approval" *ngIf="isapprover == 'Yes'">
              <i class="fas fa-clipboard-check"></i>
              <span>Requisition Aprvl</span>
            </div>
            
            <div class="item-block" routerLink="log">
              <i class="fas fa-book"></i>
              <span>Requisition Log</span>
            </div>
            
            <div class="item-block" routerLink="receving">
              <i class="fas fa-box"></i>
              <span>Addtnl Requi. Rcvng</span>
            </div>            
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>


