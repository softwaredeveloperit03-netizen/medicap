        <div class="master-block">
          <div class="section">
            <div class="line-container">
              <div class="heading">
                <h3>Human Resource</h3>
              </div>
            </div>
            <div class="card-block" style="    
              display: grid;
              grid-template-columns: repeat(6, 150px);
              grid-gap: 35px;
              overflow-x: auto;
              max-width: 100%;">
            
              <div class="item-block" routerLink="/plant_head/hr/emp_list">
                <i class="fas fa-file-signature"></i>
                <span>Employee List</span>
              </div>
              <div class="item-block" routerLink="/plant_head/hr/attendance">
                <i class="fas fa-file-signature"></i>
                <span>Employee Attendance</span>
              </div>

              <div class="item-block" routerLink="/plant_head/hr/apprisal">
                <i class="fas fa-file-signature"></i>
                <span>Appraisal Requests</span>
              </div>
 
  
              <div class="item-block" routerLink="/plant_head/hr/shiftappr">
                <i class="fas fa-user-check"></i>
                <span>Shift Approval Request</span>
              </div>

              <div class="item-block" routerLink="/plant_head/hr/requisition">
                <i class="fas fa-users"></i>
                <span>Manpower Req. Approval</span>
              </div>  
  
              <div class="item-block" routerLink="/management/manage_approval">
                <i class="fas fa-user-tie"></i>
                <span>Recruitment Approval</span>
              </div>
   
              <div class="item-block" routerLink="shift">
                <i class="fas fa-calendar-alt"></i>
                <span>Shift Management</span>
              </div>
  
              <div class="item-block" routerLink="resignation" *ngIf="dept_head=='Yes'">
                <i class="fas fa-file-alt"></i>
                <span>Employee Resignation</span>
              </div>

              <div class="item-block" routerLink="leaveapp">
                <i class="fas fa-calendar-check"></i>
                <span>Leave Approval</span>
              </div>

              <div class="item-block" routerLink="leaveLog">
                <i class="fas fa-calendar-check"></i>
                <span>Leave Log</span>
              </div>

              <div class="item-block" routerLink="goveAgency">
                <i class="fas fa-calendar-check"></i>
                <span>Interview Approval</span>
              </div>

              <div class="item-block" routerLink="holiday">
                <i class="fas fa-calendar-check"></i>
                <span>Holiday</span>
              </div>
   
           
  
            </div>
          </div>
        </div>
  
  
  
      </div>
    </div>
  </div>