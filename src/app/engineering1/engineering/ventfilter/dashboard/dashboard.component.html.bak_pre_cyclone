<div class="component eng-legacy-dash">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Vent Filter</h3>
        <div routerLink="/engineering" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>Vent Filter Section</h3>
            </div>
          </div>
          <div class="block-container">
            <div class="item-block" routerLink="critical">
              <i class="fas fa-filter"></i>
              <span>List of vent fltr - Criti</span>
            </div>
            
            <div class="item-block" routerLink="non-critical">
              <i class="fas fa-utensils"></i>
              <span>List of vent fltr-Non criti</span>
            </div>
            
            <div class="item-block" routerLink="replacement">
              <i class="fas fa-file-alt"></i>
              <span>Vent Filter replac Rec</span>
            </div>
            
            <div *ngIf="isuser == 'Yes'" class="item-block" routerLink="insectocutor">
              <i class="fas fa-vial"></i>
              <span>Integrity test report</span>
            </div>
            
            <div *ngIf="isuser == 'Yes'" class="item-block" routerLink="schedule">
              <i class="fas fa-calendar-alt"></i>
              <span>Schedule Vent fltr replac</span>
            </div>
            
                              
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>
