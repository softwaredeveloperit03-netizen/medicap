<div class="card">
    <div class="card-header" style="text-align: center">
        <div class="clr-row" style="margin-bottom: -10px;">
            <div class="clr-col-lg-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Thermic Fluid Boiler
            </div>
            <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
                <button class="btn btn-sm btn-danger" routerLink="/engineering">{{'common.close' | translate}}</button>
            </div>
        </div>
    </div>
    <div class="card-block">
        <div class="card-text">
            <div class="clr-row">
                <div *ngIf="isuser == 'Yes'" class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-4">
                    <div class="card clickable" routerLink="maintenance" style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px">
                        <div class="card-block" style="text-align: center; border-top: solid 3px rgb(153, 51, 102); border-radius: 7px">
                            <img width="50px" height="50px" src="assets/maintenance.png">
                            <p class="card-text"><b>BOILER LOCATIONS</b></p>
                        </div>
                    </div>
                </div>
                <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-4 clr-col-4">
                    <div class="card clickable" routerLink="operation" style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px">
                        <div class="card-block" style="text-align: center; border-top: solid 3px rgb(153, 51, 102); border-radius: 7px">
                            <img width="50px" height="50px" src="assets/maintenance.png">
                            <p class="card-text"><b>OPERATION OF THERMIC FLUID BOILER</b></p>
                        </div>
                    </div>
                </div>
                <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-4 clr-col-4">
                    <div class="card clickable" routerLink="preventive" style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px">
                        <div class="card-block" style="text-align: center; border-top: solid 3px rgb(153, 51, 102); border-radius: 7px">
                            <img width="50px" height="50px" src="assets/maintenance-history.png">
                            <p class="card-text"><b>PREVENTIVE MAINTENANCE</b></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div> 
</div>