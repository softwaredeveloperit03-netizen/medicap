<div class="component eng-legacy-dash">
    <div class="subsection">
        <div class="purchase-block">
            <div style="text-align:end" class="exit-section">
                <div class="header-block" style="margin:10px 0px">
                    <h3>Operational Qualification</h3>
                    <div routerLink="/engineering/equip-qualification" class="name-board2"><i class="fas fa-times"></i>
                    </div>
                </div>
                <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
                    <div class="category">
                        <div class="line-section">
                            <div class="header-div">
                                <h3>Operational Qualification Section</h3>
                            </div>
                        </div>
                        <div class="block-container" style="    
                        display: grid;
                        grid-template-columns: repeat(6, 150px);
                        grid-gap: 35px;
                        overflow-x: auto;
                        max-width: 100%;">
                            <div class="item-block" *ngIf="isuser == 'Yes'" routerLink="InitialOq">
                                <i class="fas fa-user-check"></i> <!-- Font Awesome icon for Operator Checks -->
                                <span>Initial OQ Protocol</span>
                            </div>
                            <div class="item-block" *ngIf="ischecker == 'Yes'" routerLink="operator-check">
                                <i class="fas fa-user-check"></i> <!-- Font Awesome icon for Operator Checks -->
                                <span>Performance Check</span>
                            </div>
                            <div class="item-block" routerLink="trials">
                                <i class="fas fa-flask"></i> <!-- Font Awesome icon for Trials No Load -->
                                <span>Trials No Load.</span>
                            </div>
                            <div class="item-block" routerLink="manufacture">
                                <i class="fas fa-industry"></i> <!-- Font Awesome icon for Manufacture Certificates -->
                                <span>Utility Functioning</span>
                            </div>
                            <div class="item-block"  routerLink="varification-sop">
                                <i class="fas fa-file"></i>
                                <!-- Font Awesome icon for Operation Verification SOP Checks -->
                                <span>Calibration Review</span>
                            </div>
                            <div class="item-block" routerLink="calibration">
                                <i class="fas fa-ruler"></i>
                                <span>Manufacture Certif.</span>
                            </div>
                            <div class="item-block" routerLink="utility">
                                <i class="fas fa-cogs"></i> <!-- Font Awesome icon for Utility Functioning -->
                                <span>OQ Test & Check</span>
                            </div>
                            <div class="item-block" routerLink="calibration">
                                <i class="fas fa-ruler"></i> <!-- Font Awesome icon for Calibration Review -->
                                <span>Checklist of all QA</span>
                            </div>
                            <div class="item-block" routerLink="standard">
                                <i class="fas fa-file-alt"></i>
                                <!-- Font Awesome icon for Standard Operating Procedure -->
                                <span>Deviation OQ</span>
                            </div>
                            <div class="item-block" routerLink="final-report">
                                <i class="fas fa-file-alt"></i> <!-- Font Awesome icon for Final Report -->
                                <span>Final OQ Report</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>