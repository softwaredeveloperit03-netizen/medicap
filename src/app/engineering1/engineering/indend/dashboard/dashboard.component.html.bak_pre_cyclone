<div class="module">
  <div class="subdiv">
    <div class="purchase-container" >
      <div style="text-align:end" class="close-block">
        <div class="heading-container" style="margin:10px 0px">
          <h3>Purchase Requisition / Requisition Of Material</h3>
        </div>
        <div routerLink="/engineering" class="name-board1"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="master-block" style="margin: 0px 10px 10px 10px !important;">
        <div class="section">
          <div class="line-container">
            <div class="heading">
              <h3>Purchase Requisition / Requisition Section</h3>
            </div>
          </div>
          <div class="card-block">
            <div class="icon-container" routerLink="new" *ngIf="isuser == 'Yes'">
              <i class="fas fa-file-alt"></i> <!-- Font Awesome icon for New Purchase Requisition -->
              <span>New Purchase Requisition</span>
            </div>
            
            <div class="icon-container" routerLink="approval" *ngIf="isapprover == 'Yes'">
              <i class="fas fa-check-circle"></i> <!-- Font Awesome icon for Purchase Requisition for Approval -->
              <span>Purchase Requisition for Approval</span>
            </div>
            
            <div class="icon-container" routerLink="log">
              <i class="fas fa-clipboard-list"></i> <!-- Font Awesome icon for Purchase Requisitions Log -->
              <span>Purchase Requisitions Log</span>
            </div>            
          </div>
        </div>
      </div>
    </div>
  </div>
</div>