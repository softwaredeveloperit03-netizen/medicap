  dispatchReportFun() {
    const ids = this.dispatchData.map((item) => item.id);
    const values = this.dispatchData.map(
      (item) => parseInt(item.primary_qty, 10) || 0
    ); // Parse primary_qty or default to 0 if not available
    const colors = this.dispatchData.map(
      () =>
        `rgba(${Math.floor(Math.random() * 255)}, ${Math.floor(
          Math.random() * 255
        )}, ${Math.floor(Math.random() * 255)}, 0.2)`
    );
    const borderColor = colors.map((color) => color.replace('0.2', '1'));

    const ctx = (
      document.getElementById('dispatchReport') as HTMLCanvasElement
    ).getContext('2d');
    if (ctx) {
      new Chart(ctx, {
        type: 'pie',
        data: {
          labels: ids,
          datasets: [
            {
              label: 'Product Primary Quantity',
              data: values,
              backgroundColor: colors,
              borderColor: borderColor,
              borderWidth: 1,
            },
          ],
        },
        options: {
          responsive: true,
          plugins: {
            legend: {
              position: 'top',
            },
            title: {
              display: true,
              text: 'Product Distribution by Primary Quantity',
            },
          },
        },
      });
    }
  }

  purchseReport() {
    // Extract ids and financial metrics
    const labels = this.purchaseData.map((item) => `${item.vendor_name}`);
    const grossTotalData = this.purchaseData.map((item) =>
      parseFloat(item.gross_total)
    );
    const gstTotalData = this.purchaseData.map((item) =>
      parseFloat(item.gst_total)
    );
    const netTotalData = this.purchaseData.map((item) =>
      parseFloat(item.net_total)
    );

    // Create the chart
    new Chart('purchaseReport', {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Gross Total',
            data: grossTotalData,
            backgroundColor: 'rgba(255, 99, 132, 0.2)',
            borderColor: 'rgba(255, 99, 132, 1)',
            borderWidth: 1,
          },
          {
            label: 'Tax Total',
            data: gstTotalData,
            backgroundColor: 'rgba(54, 162, 235, 0.2)',
            borderColor: 'rgba(54, 162, 235, 1)',
            borderWidth: 1,
          },
          {
            label: 'Net Total',
            data: netTotalData,
            backgroundColor: 'rgba(75, 192, 192, 0.2)',
            borderColor: 'rgba(75, 192, 192, 1)',
            borderWidth: 1,
          },
        ],
      },
      options: {
        responsive: true,
        scales: {
          x: {
            beginAtZero: true,
          },
          y: {
            beginAtZero: true,
          },
        },
      },
    });
  }

  shortageReportFun() {
    // Prepare data for the bar chart
    const labels = this.shortageReport.map((item) => item.material_name);
    const qtyData = this.shortageReport.map((item) => parseFloat(item.qty));
    // Create the bar chart
    new Chart('materialQtyChart', {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Available Qty',
            data: qtyData,
            backgroundColor: 'rgba(75, 192, 192, 0.2)',
            borderColor: 'rgba(75, 192, 192, 1)',
            borderWidth: 1,
          },
        ],
      },
      options: {
        responsive: true,
        scales: {
          x: {
            beginAtZero: true,
          },
          y: {
            beginAtZero: true,
          },
        },
      },
    });
  }

  costingReportFun() {
    const labels = this.constingReport.map(
      (item) => item.product_code || item.product_name || `Product ${item.id}`
    );
    const unitCostData = this.constingReport.map((item) =>
      parseFloat(item.unit_cost)
    );
    const packCostData = this.constingReport.map((item) =>
      parseFloat(item.pack_cost)
    );

    new Chart('productCostChart', {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Cost/Unit',
            data: unitCostData,
            backgroundColor: 'rgba(75, 192, 192, 0.2)',
            borderColor: 'rgba(75, 192, 192, 1)',
            borderWidth: 1,
          },
          {
            label: 'Cost/Pack',
            data: packCostData,
            backgroundColor: 'rgba(153, 102, 255, 0.2)',
            borderColor: 'rgba(153, 102, 255, 1)',
            borderWidth: 1,
          },
        ],
      },
      options: {
        responsive: true,
        scales: {
          x: {
            beginAtZero: true,
            grid: {
              color: '#ddd', // X-axis grid color
            },
          },
          y: {
            beginAtZero: true,
            grid: {
              color: '#ddd', // Y-axis grid color
            },
          },
        },
      },
    });
  }
