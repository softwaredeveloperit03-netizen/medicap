  getFilteredCards(): ManagementCard[] {
    const q = (this.searchQuery || '').trim().toLowerCase();
    return this.managementCards.filter((c) => {
      if (c.showWhen === 'dept_head' && this.dept_head !== 'Yes') {
        return false;
      }
      const matchSidebar =
        this.selectedSidebarModule === 'ALL' ||
        (this.selectedSidebarModule === 'MANAGEMENT_REPORTS' && this.managementReportsIds.has(c.id)) ||
        (this.selectedSidebarModule === 'MANAGEMENT_OPERATIONS' && this.managementOperationsIds.has(c.id)) ||
        (this.selectedSidebarModule === 'MANAGEMENT_MASTER' && this.managementMasterIds.has(c.id));
      const matchCategory = this.selectedCategory === 'All' || c.category === this.selectedCategory;
      const matchSearch = !q || c.title.toLowerCase().includes(q) || c.category.toLowerCase().includes(q) || (c.description && c.description.toLowerCase().includes(q));
      return matchSidebar && matchCategory && matchSearch;
    });
  }

  getOtherManagementSidebarCards(): ManagementCard[] {
    const self = this;
    const cardsById = new Map(this.managementCards.map(function(c) { return [c.id, c] as [string, ManagementCard]; }));
    return Array.from(this.managementOtherIds)
      .map(function(id) { return cardsById.get(id); })
      .filter(function(c): c is ManagementCard {
        if (!c) { return false; }
        if (c.showWhen === 'dept_head' && self.dept_head !== 'Yes') { return false; }
        return true;
      });
  }

  selectSidebarModule(module: 'ALL' | 'MANAGEMENT_REPORTS' | 'MANAGEMENT_OPERATIONS' | 'MANAGEMENT_MASTER'): void {
    this.selectedSidebarModule = module;
    this.selectedCategory = 'All';
