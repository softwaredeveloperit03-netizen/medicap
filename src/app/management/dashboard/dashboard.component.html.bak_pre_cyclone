<div class="dashboard-shell dashboard-shell--pro" [style.background]="selectedPalette.background">
  <ng-container *ngIf="getFilteredCards() as cards">
    <div class="compact-layout">
      <aside class="compact-sidebar">
        <div class="compact-sidebar__head">
          <span class="compact-sidebar__title">Management Modules</span>
          <span class="compact-sidebar__count">{{ cards.length }}</span>
        </div>
        <nav class="compact-sidebar__tabs" aria-label="Management modules">
          <button
            type="button"
            class="compact-nav-item compact-nav-item--all compact-nav-item--menu"
            [class.active]="selectedSidebarModule === 'ALL'"
            (click)="showAllTabs()"
          >
            <i class="fas fa-layer-group" aria-hidden="true"></i>
            <span>All Tabs</span>
          </button>

          <button
            type="button"
            class="compact-nav-item compact-nav-item--menu"
            [class.active]="selectedSidebarModule === 'MANAGEMENT_REPORTS'"
            (click)="selectSidebarModule('MANAGEMENT_REPORTS')"
          >
            <i class="fas fa-chart-line" aria-hidden="true"></i>
            <span>Management Reports</span>
          </button>

          <button
            type="button"
            class="compact-nav-item compact-nav-item--menu"
            [class.active]="selectedSidebarModule === 'MANAGEMENT_OPERATIONS'"
            (click)="selectSidebarModule('MANAGEMENT_OPERATIONS')"
          >
            <i class="fas fa-cogs" aria-hidden="true"></i>
            <span>Management Operations</span>
          </button>

          <button
            type="button"
            class="compact-nav-item compact-nav-item--menu"
            [class.active]="selectedSidebarModule === 'MANAGEMENT_MASTER'"
            (click)="selectSidebarModule('MANAGEMENT_MASTER')"
          >
            <i class="fas fa-folder-tree" aria-hidden="true"></i>
            <span>Management Master</span>
          </button>

          <a
            *ngFor="let card of getOtherManagementSidebarCards(); trackBy: trackByCardId"
            class="compact-nav-item"
            [routerLink]="card.route"
            [title]="card.title"
          >
            <i class="fas" [ngClass]="card.icon" aria-hidden="true"></i>
            <span>{{ card.title }}</span>
          </a>

          <a class="compact-nav-item" routerLink="/indend/raw" title="Purchase Requisition">
            <i class="fas fa-boxes" aria-hidden="true"></i>
            <span>Purchase Requisition</span>
          </a>
          <a class="compact-nav-item" routerLink="/qa/qms" title="QMS">
            <i class="fas fa-clipboard-check" aria-hidden="true"></i>
            <span>QMS</span>
          </a>
          <a class="compact-nav-item" routerLink="/preventiveimain" title="PM Intimation">
            <i class="fas fa-tools" aria-hidden="true"></i>
            <span>PM Intimation</span>
          </a>
          <a class="compact-nav-item" routerLink="/breakdown" title="Breakdown">
            <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
            <span>Breakdown</span>
          </a>
          <a class="compact-nav-item" routerLink="/hrfordepthead" title="HR Dept">
            <i class="fas fa-user-tie" aria-hidden="true"></i>
            <span>Dept. Head</span>
          </a>
          <a class="compact-nav-item" routerLink="/training" title="Training">
            <i class="fas fa-user-tie" aria-hidden="true"></i>
            <span>Training</span>
          </a>
        </nav>
      </aside>

      <div class="compact-main">
        <div class="dash-header dash-header--single-line">
          <div class="title-block">
            <h2>Management Department</h2>
          </div>
          <div class="header-actions-row">
            <div class="search-box dash-header__search">
              <i class="fas fa-search"></i>
              <input
                type="text"
                [(ngModel)]="searchQuery"
                placeholder="Search by name or category"
                aria-label="Search modules"
              />
            </div>
            <app-floating-docs-popup
              class="dash-header__docs"
              [showSoftwareFlow]="false"
              [showOperationGuide]="false"
            ></app-floating-docs-popup>
            <a class="close-btn" routerLink="/" aria-label="Close">
              <i class="fas fa-times"></i>
              Close
            </a>
          </div>
        </div>

        <h3 class="section-label">Management Section</h3>
        <div class="tiles-grid">
          <a
            *ngFor="let card of cards; trackBy: trackByCardId"
            class="tile-card"
            [routerLink]="card.route"
            [ngStyle]="{'box-shadow': selectedPalette.cardShadow}"
          >
            <div class="icon-wrap" [style.background]="card.gradient">
              <i class="fas" [ngClass]="card.icon"></i>
              <span class="badge-count" *ngIf="card.badgeCount && card.badgeCount() > 0">{{ card.badgeCount() }}</span>
            </div>
            <div class="tile-body">
              <div class="tile-title">{{ card.title }}</div>
              <p class="tile-description" *ngIf="card.description">{{ card.description }}</p>
            </div>
          </a>

          <div class="empty-state" *ngIf="cards.length === 0">
            <i class="fas fa-search"></i>
            <p>No modules match your search. Try another keyword or category.</p>
          </div>
        </div>
      </div>
    </div>
  </ng-container>

  <button class="palette-fab" type="button" (click)="togglePalette()" title="Change theme" aria-label="Change theme">
    <i class="fas fa-palette"></i>
  </button>

  <div class="palette-drawer" *ngIf="showPalette">
    <button
      *ngFor="let palette of paletteOptions"
      type="button"
      class="palette-chip"
      [class.active]="palette === selectedPalette"
      [style.background]="palette.swatch"
      [title]="palette.name"
      (click)="setPalette(palette)"
      [attr.aria-label]="'Theme ' + palette.name"
    >
      <span class="sr-only">{{ palette.name }}</span>
    </button>
  </div>
</div>
