<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Deviation Management</h3> <!-- Change Heading -->
          <div routerLink="/rnd/qa" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <!-- section1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;"><!-- Repeate this container -->
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Deviation Management Section</h3><!-- Change sub- Heading -->
              </div>
            </div>
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">
              <div class="item-block" routerLink="new" *ngIf="isuser == 'Yes'">
                <i class="fas fa-plus-circle"></i>
                <span>New Deviation</span>
              </div>
              
              <div class="item-block" routerLink="checking" *ngIf="ischecker == 'Yes'">
                <i class="fas fa-clipboard-check"></i>
                <span>Deviation For Check.</span>
              </div>
              
              <div class="item-block" routerLink="review" >
                <i class="fas fa-edit"></i>
                <span>Deviations For Review</span>
              </div>
              
              <div class="item-block" routerLink="log">
                <i class="fas fa-list-alt"></i>
                <span>Deviations Log</span>
              </div>
              
              <div class="item-block" routerLink="capa">
                <i class="fas fa-check-double"></i>
                <span>Recom. Dev. For CAPA</span>
              </div>
              


            </div>
          </div>
        </div>
        <!-- section1 -->


      </div>
    </div>
  </div>
</div>
