<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Incident Report</h3> <!-- Change Heading -->
          <div routerLink="/rnd/qa" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <!-- section1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;"><!-- Repeate this container -->
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Incident Report Section</h3><!-- Change sub- Heading -->
              </div>
            </div>
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">
              <div class="item-block" routerLink="form" *ngIf="isuser == 'Yes'">
                <i class="fas fa-file-alt"></i>
                <span>New Incident</span>
              </div>
              
              <div class="item-block" routerLink="checker" *ngIf="ischecker == 'Yes'">
                <i class="fas fa-check-double"></i>
                <span>Incident for Check.</span>
              </div>
              
              <div class="item-block" routerLink="verify">
                <i class="fas fa-clipboard-check"></i>
                <span>Incident for Verif.</span>
              </div>
              
              <div class="item-block" routerLink="review">
                <i class="fas fa-edit"></i>
                <span>Incidents for Review</span>
              </div>
              
              <div class="item-block" routerLink="approval" *ngIf="isapprover == 'Yes'">
                <i class="fas fa-check-circle"></i>
                <span>Incident for Approval</span>
              </div>
              
              <div class="item-block" routerLink="log">
                <i class="fas fa-book"></i>
                <span>Incident Log</span>
              </div>
              
              <div class="item-block" routerLink="trend">
                <i class="fas fa-chart-line"></i>
                <span>Incident Trend</span>
              </div>
              


            </div>
          </div>
        </div>
        <!-- section1 -->


      </div>
    </div>
  </div>
</div>
