<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Raw Material Testing</h3> <!-- Change Heading -->
          <div routerLink="/rnd/qc/testing" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <!-- section1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;"><!-- Repeate this container -->
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Raw Material Testing Section</h3><!-- Change sub- Heading -->
              </div>
            </div>
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">
            <div class="item-block" routerLink="allocation" >
              <i class="fas fa-tasks"></i> <!-- Icon for ALLOCATION OF TESTING -->
              <span>ALLOCATION OF TESTING</span>
            </div>
            
            <div class="item-block" routerLink="awaiting">
              <i class="fas fa-hourglass-half"></i> <!-- Icon for AWAITING TESTS -->
              <span>AWAITING TESTS</span>
            </div>
            
            <div class="item-block" routerLink="checking" *ngIf="ischecker == 'Yes'">
              <i class="fas fa-search"></i> <!-- Icon for Testing for Checking -->
              <span>Testing for Checking</span>
            </div>
            
            <div class="item-block" routerLink="approval" *ngIf="isapprover == 'Yes'">
              <i class="fas fa-check-circle"></i> <!-- Icon for Testing for Approval -->
              <span>Testing for Approval</span>
            </div>
            
            <div class="item-block" routerLink="ar">
              <i class="fas fa-file-alt"></i> <!-- Icon for A. R. REPORT -->
              <span>A. R. REPORT</span>
            </div>
            
            <div class="item-block" routerLink="rds">
              <i class="fas fa-database"></i> <!-- Icon for Raw Data Sheet -->
              <span>Raw Data Sheet</span>
            </div>
            
            <div class="item-block" routerLink="coa">
              <i class="fas fa-certificate"></i> <!-- Icon for COA REPORT -->
              <span>COA REPORT</span>
            </div>
            
            <div class="item-block" routerLink="rejected">
              <i class="fas fa-times-circle"></i> <!-- Icon for Rejected Testing -->
              <span>Rejected Testing</span>
            </div>
            


            </div>
          </div>
        </div>
        <!-- section1 -->

      </div>
    </div>
  </div>
</div>


