<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Stability Testing</h3> <!-- Change Heading -->
          <div routerLink="/rnd/qc/testing" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <!-- section1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;"><!-- Repeate this container -->
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Stability Testing Section</h3><!-- Change sub- Heading -->
              </div>
            </div>
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">
            <div class="item-block" routerLink="allocation"  *ngIf="isuser == 'Yes'">
              <i class="fas fa-tasks"></i>
              <span>Allocation of Testing</span>
            </div>
            
            <div class="item-block" routerLink="awaiting"  *ngIf="isuser == 'Yes'">
              <i class="fas fa-clock"></i>
              <span>Awaiting Tests</span>
            </div>
            
            <div class="item-block" routerLink="approval"  *ngIf="isapprover == 'Yes'">
              <i class="fas fa-check-circle"></i>
              <span>Approval Pending</span>
            </div>
            
            <div class="item-block" routerLink="log">
              <i class="fas fa-book"></i>
              <span>Log</span>
            </div>   
            </div>
          </div>
        </div>
        <!-- section1 -->

      </div>
    </div>
  </div>
</div>

