<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Water Analysis</h3> <!-- Change Heading -->
          <div routerLink="/rnd/qc" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <!-- section1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;"><!-- Repeate this container -->
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Water Analysis Section</h3><!-- Change sub- Heading -->
              </div>
            </div>
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">

              <div class="item-block" routerLink="water-points">
                <i class="fas fa-tint"></i>
                <span>Sampling Points</span>
              </div>
              <div class="item-block" routerLink="plan">
                <i class="fas fa-tasks"></i>
                <span>Sampling Plan</span>
              </div>
              <div class="item-block" routerLink="sampling-allocation">
                <i class="fas fa-tasks"></i>
                <span>Plan Allocation</span>
              </div>
              <div class="item-block" routerLink="sampling">
                <i class="fas fa-tint"></i><span>Water Sampling</span>
              </div>
              <div class="item-block" routerLink="testing">
                <i class="fas fa-vial"></i>
                <span>Testing</span>
              </div>
              <div *ngIf="ischecker == 'Yes'" class="item-block" routerLink="testing-checking">
                <i class="fas fa-vial"></i>
                <span>Testing Checking</span>
              </div>
              <div class="item-block" routerLink="water">
                <i class="fas fa-microscope"></i>
                <span>Microbiological Analysis</span>
              </div>
              <div class="item-block" routerLink="report">
                <i class="fas fa-file-alt"></i>
                <span>Test Reports</span>
              </div>
              <div class="item-block" routerLink="trend">
                <i class="fas fa-chart-line"></i>
                <span>Trends</span>
              </div>


            </div>
          </div>
        </div>
        <!-- section1 -->

      </div>
    </div>
  </div>
</div>