New Design -->

<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Packing Material Sampling</h3> <!-- Change Heading -->
          <div routerLink="/rnd/qc/sampling" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <!-- section1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;"><!-- Repeate this container -->
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Packing Material Sampling Section</h3><!-- Change sub- Heading -->
              </div>
            </div>
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">
            <div class="item-block" routerLink="allocation">
              <i class="fas fa-tasks"></i> <!-- Icon for Sampling Allocation -->
              <span>Sampling Allocation</span>
            </div>
            
            <div class="item-block" routerLink="sample">
              <i class="fas fa-plus-circle"></i> <!-- Icon for New Sampling -->
              <span>New Sampling</span>
            </div>
            
            <div class="item-block" routerLink="checking"  *ngIf="ischecker == 'Yes'">   
              <i class="fas fa-search"></i> <!-- Icon for Samplings for Checking -->
              <span>Samplings for Checking</span>
            </div>
            
            <div class="item-block" routerLink="approval" *ngIf="isapprover == 'Yes'">
              <i class="fas fa-check-circle"></i> <!-- Icon for Samplings for Approval -->
              <span>Samplings for Approval</span>
            </div>
            
            <div class="item-block" routerLink="log">
              <i class="fas fa-book"></i> <!-- Icon for Samplings Report -->
              <span>Samplings Report</span>
            </div>
            
            <div class="item-block" routerLink="label">
              <i class="fas fa-print"></i> <!-- Icon for Label Printing -->
              <span>Label Printing</span>
            </div>
            
            </div>
          </div>
        </div>
        <!-- section1 -->

      </div>
    </div>
  </div>
</div>