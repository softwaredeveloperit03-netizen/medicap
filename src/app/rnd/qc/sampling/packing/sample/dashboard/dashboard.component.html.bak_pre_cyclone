<div class="container-fluid" *ngIf="!isNew">
    <div class="card">
        <div class="card-header" style="text-align: center">
            <div class="clr-row" style="margin-bottom: -10px;">
              <div class="clr-col-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Awaiting Sampling Requests</div>
              <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
                <button class="btn btn-sm" routerLink="/rnd/qc/sampling/packing" style="background-color: red;color: white;">
                  CLOSE
                </button>
              </div>
            </div>
          </div>
        <div class="card-block">
            <div class="card-text">
                <div class="clr-row">
                    <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-xs-12">
                        <div class="card clickable" routerLink="area">
                            <div class="card-block" style="text-align: center">
                              <img width="50px" height="50px" src="assets/checkpoint.png">
                              <p class="card-text"><b>Proceed for Sampling</b></p>
                            </div>
                        </div>
                    </div>
                    <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-xs-12">
                        <div class="card clickable" routerLink="line">
                            <div class="card-block" style="text-align: center">
                              <img width="50px" height="50px" src="assets/clearance.png">
                              <p class="card-text"><b>QA Line Clearance</b></p>
                            </div>
                        </div>
                    </div>
                    <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-xs-12">
                        <div class="card clickable" routerLink="sample">
                            <div class="card-block" style="text-align: center">
                              <img width="50px" height="50px" src="assets/sampling.png">
                              <p class="card-text"><b>Start Sampling</b></p>
                            </div>
                        </div>
                    </div>
                </div>
                <table class="table">
                    <tr>
                        <th style="text-align: left; background-color: rgb(14, 67, 112); color: white;">Material Name</th>
                        <th style="text-align: left; background-color: rgb(14, 67, 112); color: white;">Material Type</th>
                        <th style="text-align: left; background-color: rgb(14, 67, 112); color: white;">Material Code</th>
                        <th style="text-align: left; background-color: rgb(14, 67, 112); color: white;">Batch No.</th>
                        <th style="text-align: left; background-color: rgb(14, 67, 112); color: white;">Containers</th>
                        <th style="text-align: left; background-color: rgb(14, 67, 112); color: white;">GRN No.</th>
                        <th style="text-align: left; background-color: rgb(14, 67, 112); color: white;">GRN Date</th>
                        <th style="text-align: left; background-color: rgb(14, 67, 112); color: white;">Sampling Person</th>
                        <th style="text-align: left; background-color: rgb(14, 67, 112); color: white;">Current Stage</th>
                        <!-- <th>{{'common.table.action' | translate}}</th> -->
                    </tr>
                    <tr *ngFor="let result of results; let i = index">
                        <td style="text-align: left;">{{ result.material_name }}</td>
                        <td style="text-align: left;">{{ result.material_subtype }}</td>
                        <td style="text-align: left;">{{ result.material_code }}</td>
                        <td style="text-align: left;">{{ result.batch_no }}</td>
                        <td style="text-align: left;">{{ result.containers }}</td>
                        <td style="text-align: left;">{{ result.grn_no }}</td>
                        <td style="text-align: left;">{{ result.grn_date }}</td>
                        <td style="text-align: left;">{{ result.sampling_person }}</td>
                        <td style="color: red;font-weight: 800;">{{ result.current_status }}</td>
                        <!-- <td>
                            <button class="btn btn-sm btn-info" (click)="view(i)" *ngIf="result.specification_no !== ''">PROCEED</button>
                            <button class="btn btn-sm btn-info" routerLink="/specifications" *ngIf="result.specification_no == ''">ADD SPECIFICATION</button>
                        </td> -->
                    </tr>
                    <tr *ngIf="results?.length == 0">
                        <td colspan="7">{{'common.noRecords' | translate}}</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>