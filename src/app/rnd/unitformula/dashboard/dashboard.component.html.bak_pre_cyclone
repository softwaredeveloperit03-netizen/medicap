                    <div class="card clickable" routerLink="new" style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
                    >
                      <div class="card-block" style="text-align: center; border-top: solid 3px rgb(0, 102, 153); border-radius: 7px">
                        <img width="75px" height="75px" src="assets/new.png">
                        <p class="card-text"><b>New Formula</b></p>
                      </div>
                    </div>
                </div>
   -->

        <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-6 clr-col-sm-12 clr-col-12">
          <div class="card clickable" routerLink="log"
            style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px">
            <div class="card-block"
              style="text-align: center; border-top: solid 3px rgb(0, 102, 153); border-radius: 7px">
              <img width="75px" height="75px" src="assets/log.png">
              <p class="card-text"><b>Unit Formula</b></p>
            </div>
          </div>
        </div>
        <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-6 clr-col-sm-12 clr-col-12" *ngIf="isApprover">
          <div class="card clickable" routerLink="checking"
            style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px">
            <div class="card-block"
              style="text-align: center; border-top: solid 3px rgb(0, 102, 153); border-radius: 7px">
              <img width="75px" height="75px" src="assets/approval.png">
              <p class="card-text"><b>Formula for Checking</b></p>
            </div>
          </div>
        </div>

        <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-6 clr-col-sm-12 clr-col-12" *ngIf="isApprover">
          <div class="card clickable" routerLink="approval"
            style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px">
            <div class="card-block"
              style="text-align: center; border-top: solid 3px rgb(0, 102, 153); border-radius: 7px">
              <img width="75px" height="75px" src="assets/approval.png">
              <p class="card-text"><b>Formula for Approval</b></p>
            </div>
          </div>
        </div>


      </div>
    </div>
  </div>
</div>