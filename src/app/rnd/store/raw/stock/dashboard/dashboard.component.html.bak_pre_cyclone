<div class="card">
    <div class="card-header" style="text-align: center">
      <div class="clr-row" style="margin-bottom: -10px;">
        <div class="clr-col-lg-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Raw Material Stock Book</div>
        <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
          <button class="btn btn-sm btn-danger" routerLink="/rnd/store/raw"> {{'common.close' | translate}} </button>
        </div>
      </div>
    </div>
    <div class="card-block">
      <div class="card-text">
        <div class="clr-row">
          <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-xs-12">
            <div class="card clickable" routerLink="quarantine" style="background-color: brown; border-color: brown; color: white;">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text" style="color: white;"><b>Quarantine Stock</b></p>
              </div>
            </div>
          </div>
          <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-xs-12">
            <div class="card clickable" routerLink="test" style="background-color: yellow; border-color: yellow; color: black">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text" style="color: black"><b>Under Test Stock</b></p>
              </div>
            </div>
          </div>
          <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-xs-12">
            <div class="card clickable" routerLink="approved" style="background-color: green; border-color: green;">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text" style="color: white;"><b>Approved Stock</b></p>
              </div>
            </div>
          </div>
        </div>
        <br>
        <div class="clr-row">
          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
            <label>Vendor Name:</label>
            <select name="vendor_no" [(ngModel)]="vendor_no" required>
              <option></option>
              <option *ngFor="let vendor of vendors" [value]="vendor.vendor_no">{{ vendor.vendor_name }}</option>
            </select>
          </div>
          <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12">
            <label>Material Type:</label>
            <select name="material_type" [(ngModel)]="material_type" required>
              <option></option>
              <option>Raw Material</option>
              <option>Liquid</option>
              <option>Solvents</option>
              <option>Others</option>
            </select>
          </div>
          <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12">
            <label>Grade:</label>
            <select name="grade" [(ngModel)]="grade" required>
              <option></option>
              <option>IP</option>
              <option>EP</option>
              <option>BP</option>
              <option>USP</option>
              <option>IHS</option>
              <option>JP</option>
              <option>CP</option>
              <option>Commercial</option>
              <option>Analytical</option>
            </select>
          </div>
          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
            <label>Material Name:</label>
            <input type="text" name="material_name" [(ngModel)]="material_name" required>
          </div>
          <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12">
            <label>Status:</label>
            <select name="status" [(ngModel)]="status" required>
              <option></option>
              <option value="quarantine">Quarantine</option>
              <option value="under test">Under Test</option>
              <option value="Approved">{{'common.approved' | translate}}</option>
            </select>
          </div>
          <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12">
            <button class="btn btn-primary" (click)="getAllStock()">{{'common.search' | translate}}</button>
          </div>
        </div>
        <table class="table">
          <tr>
            <th style="text-align: left;">Sr.</th>
            <th style="text-align: left;">GRN No.</th>
            <th style="text-align: left;">Vendor Name</th>
            <th style="text-align: left;">Material Type</th>
            <th style="text-align: left;">Material Code</th>
            <th style="text-align: left;">Material Name</th>
            <th>Grade</th>
            <th style="text-align: left;">Batch No.</th>
            <th style="text-align: right;">Available Qty</th>
            <th>{{'common.status' | translate}}</th>
          </tr>
      
          <tr *ngFor="let stock of stocks; let i = index">
            <td style="text-align: left;">{{ i+1 }}.</td>
            <td style="text-align: left;">{{ stock.grn_no }}</td>
            <td style="text-align: left;">{{ stock.vendor_name }}</td>
            <td style="text-align: left;">{{ stock.material_subtype }}</td>
            <td style="text-align: left;">{{ stock.material_code }}</td>
            <td style="text-align: left;">{{ stock.material_name }}</td>
            <td style="text-align: left;">{{ stock.grade }}</td>
            <td style="text-align: left;">{{ stock.batch_no }}</td>
            <td style="text-align: right;">{{ stock.qty }} {{ stock.unit }}</td>
            <td>
              <button *ngIf="stock.status === 'quarantine'" class="btn btn-sm" style="background-color: brown; border-color: brown; color: white;">Quarantine</button>
              <button *ngIf="stock.status === 'under test'" class="btn btn-sm" style="background-color: yellow; border-color: yellow; color: black">Under Test</button>
              <button *ngIf="stock.status === 'Approved'" class="btn btn-sm btn-success" style="background-color: green; border-color: green;">{{'common.approved' | translate}}</button>
            </td>
          </tr>
          <tr *ngIf="stocks?.length == 0">
            <td colspan="10">{{'common.noRecords' | translate}}</td>
          </tr>
        </table>
      </div>
    </div>
    <div class="card-footer">
      <button class="btn btn-primary" (click)="download()"><clr-icon shape="download"></clr-icon> DOWNLOAD PDF</button>
    </div>
</div>