                <i class="fas fa-truck"></i>
                <span>Receiving</span>
              </div>

              <div class="item-block" routerLink="damage">
                <i class="fas fa-exclamation-triangle"></i>
                <span>Damage Inspection</span>
              </div>

              <div class="item-block" routerLink="weighing">
                <i class="fas fa-balance-scale"></i>
                <span>Weighing</span>
              </div>

              <div class="item-block" routerLink="grn">
                <i class="fas fa-clipboard-check"></i>
                <span>GRN</span>
              </div>

              <div class="item-block" routerLink="retest">
                <i class="fas fa-redo-alt"></i>
                <span>Retest</span>
              </div>

              <div class="item-block" routerLink="spillage">
                <i class="fas fa-trash-alt"></i>
                <span>Spillage / Destruction</span>
              </div>

              <div class="item-block" routerLink="stock">
                <i class="fas fa-book"></i>
                <span>Stock Book</span>
              </div>



            </div>
          </div>
        </div>
        <!-- section1 -->


      </div>
    </div>
  </div>
