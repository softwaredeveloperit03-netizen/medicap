          <h3>Raw Material</h3> <!-- Change Heading -->
          <div routerLink="/rnd/store" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <!-- section1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;"><!-- Repeate this container -->
          <div class="category">
