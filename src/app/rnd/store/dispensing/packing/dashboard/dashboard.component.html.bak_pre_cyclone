<div class="card">
  <div class="card-header" style="text-align: center">
    <div class="clr-row" style="margin-bottom: -10px;">
      <div class="clr-col-lg-6" style="color: aliceblue;margin-top: -2px;text-align: left;">Dispening of Packing Material</div>
      <div class="clr-col-lg-6" style="text-align: right;padding-right: 0px;margin-top: -7px;">
        <button class="btn btn-sm btn-danger" routerLink="/rnd/dispensing">{{'common.close' | translate}}</button>
      </div>
    </div>
  </div>
  <div class="card-block">
    <div class="card-text">
      <div class="clr-row">

        <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
          <div class="card clickable" routerLink="allocation">
            <div class="card-block" style="text-align: center">
              <img width="75px" height="75px" src="assets/allocation.png">
              <p class="card-text"><b>Awaiting Dispensing Requests</b></p>
            </div>
          </div>
        </div>

        <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12" *ngIf="isUser">
          <div class="card clickable" routerLink="dispense">
            <div class="card-block" style="text-align: center">
              <img width="75px" height="75px" src="assets/new.png">
              <p class="card-text"><b>Dispensing Form</b></p>
            </div>
          </div>
        </div>

        <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12" *ngIf="isChecker">
          <div class="card clickable" routerLink="checking">
            <div class="card-block" style="text-align: center">
              <img width="75px" height="75px" src="assets/log.png">
              <p class="card-text"><b>Dispensing for Checking</b></p>
            </div>
          </div>
        </div>

        <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12" *ngIf="isApprover">
          <div class="card clickable" routerLink="approval">
            <div class="card-block" style="text-align: center">
              <img width="75px" height="75px" src="assets/log.png">
              <p class="card-text"><b>Dispensing for Approval</b></p>
            </div>
          </div>
        </div>

        <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
          <div class="card clickable" routerLink="log">
            <div class="card-block" style="text-align: center">
              <img width="75px" height="75px" src="assets/log.png">
              <p class="card-text"><b>Dispensing Log</b></p>
            </div>
          </div>
        </div>

        <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
          <div class="card clickable" routerLink="hold">
            <div class="card-block" style="text-align: center">
              <img width="75px" height="75px" src="assets/allocation.png">
              <p class="card-text"><b>ON Hold Records</b></p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>