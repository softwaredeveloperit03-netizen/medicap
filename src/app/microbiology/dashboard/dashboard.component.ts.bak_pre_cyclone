import { Component, HostListener, OnInit } from '@angular/core';
import { DataAccessService } from 'src/app/data-access.service';
import {
  DashboardSidebarEntry,
  sidebarFromCategories,
  slugifyLabel,
} from 'src/app/shared/dashboard-master-nav';

interface DeptCard {
  id: string;
  title: string;
  route: string;
  icon: string;
  category: string;
  gradient: string;
  showWhenNutraceutical?: boolean;
}

@Component({
  selector: 'app-dashboard',
  templateUrl: './dashboard.component.html',
  styleUrls: ['./dashboard.component.css'],
})
export class DashboardComponent implements OnInit {
  software_type = '';
  searchQuery = '';
  selectedCategory = 'All';
  showPalette = false;
  mobileSidebarOpen = false;
  private readonly sidebarBreakpointPx = 1024;
  rights: any;
  isuser = 'No';
  ischecker = 'No';
  isapprover = 'No';
  qms_approver = 'No';
  dept_head = 'No';
  isauditor = 'No';
  plant_head = 'No';
  shift_allocator = 'No';
  trainig_cordinator = 'No';
  loggedInDept = localStorage.getItem('department');

  cards: DeptCard[] = [
    { id: 'testing', title: 'Testing', route: 'testing/raw', icon: 'fa-vial', category: 'Department', gradient: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)' },
    { id: 'media', title: 'Media Management', route: 'media', icon: 'fa-photo-video', category: 'Department', gradient: 'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)' },
    { id: 'culture', title: 'Culture Management', route: 'culture', icon: 'fa-microscope', category: 'Department', gradient: 'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)' },
    { id: 'autoclaving', title: 'Autoclaving', route: 'autocleave', icon: 'fa-temperature-high', category: 'Department', gradient: 'linear-gradient(135deg, #fa709a 0%, #fee140 100%)' },
    { id: 'incubator', title: 'Incubators', route: 'incubator', icon: 'fa-thermometer-quarter', category: 'Department', gradient: 'linear-gradient(135deg, #30cfd0 0%, #330867 100%)' },
    { id: 'water', title: 'Water Analysis', route: 'water', icon: 'fa-tint', category: 'Department', gradient: 'linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)' },
    { id: 'swap', title: 'SWAB Testing', route: 'swap', icon: 'fa-vial', category: 'Department', gradient: 'linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%)' },
    { id: 'environment', title: 'Envirm Monitoring', route: 'environment', icon: 'fa-microscope', category: 'Department', gradient: 'linear-gradient(135deg, #ff6e7f 0%, #bfe9ff 100%)' },
    { id: 'refrigerator', title: 'Refrigerator', route: 'refrigerator', icon: 'fa-snowflake', category: 'Operation & Cleaning', gradient: 'linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%)' },
    { id: 'colony-counter', title: 'Colony Counter', route: 'colony-counter', icon: 'fa-vial', category: 'Operation & Cleaning', gradient: 'linear-gradient(135deg, #fbc2eb 0%, #a6c1ee 100%)' },
    { id: 'laf', title: 'Laminar Air Flow', route: 'laf', icon: 'fa-wind', category: 'Operation & Cleaning', gradient: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)' },
    { id: 'pressure', title: 'Diff. Pressure Rec', route: 'pressure', icon: 'fa-tachometer-alt', category: 'Operation & Cleaning', gradient: 'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)' },
    { id: 'temperature', title: 'Temp. & Humidity Rec', route: 'temperature', icon: 'fa-thermometer-half', category: 'Operation & Cleaning', gradient: 'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)', showWhenNutraceutical: false },
    { id: 'passbox', title: 'Dynamic Record', route: 'passbox', icon: 'fa-shipping-fast', category: 'Operation & Cleaning', gradient: 'linear-gradient(135deg, #fa709a 0%, #fee140 100%)', showWhenNutraceutical: false },
    { id: 'personnel', title: 'Monitoring', route: 'personnel', icon: 'fa-user-check', category: 'Operation & Cleaning', gradient: 'linear-gradient(135deg, #30cfd0 0%, #330867 100%)', showWhenNutraceutical: false },
    { id: 'lab', title: 'Laboratory Cleaning', route: 'lab', icon: 'fa-flask', category: 'Cleaning', gradient: 'linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)' },
    { id: 'glassware_cleaning', title: 'Glassware Cleaning', route: 'glassware_cleaning', icon: 'fa-glass', category: 'Cleaning', gradient: 'linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%)' },
    { id: 'HDPE', title: 'HDPE Storage Tank', route: 'HDPE', icon: 'fa-archive', category: 'Cleaning', gradient: 'linear-gradient(135deg, #ff6e7f 0%, #bfe9ff 100%)' },
    { id: 'digital', title: 'Digital Colony Calibr', route: 'digital', icon: 'fa-digital-tachograph', category: 'Calibration', gradient: 'linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%)' },
    { id: 'hp', title: 'PH Meter Calibration', route: 'hp', icon: 'fa-ph', category: 'Calibration', gradient: 'linear-gradient(135deg, #fbc2eb 0%, #a6c1ee 100%)' },
    { id: 'micropipette', title: 'Micropipette Calibr', route: 'micropipette', icon: 'fa-microscope', category: 'Calibration', gradient: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)' },
    { id: 'calibration', title: 'Balance Calibration', route: 'calibration', icon: 'fa-balance-scale', category: 'Calibration', gradient: 'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)' },
    { id: 'external', title: 'External Calibration', route: 'external', icon: 'fa-external-link-alt', category: 'Calibration', gradient: 'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)' },
  ];

  paletteOptions: { name: string; swatch: string; background: string; cardShadow: string }[] = [
    { name: 'Aurora', swatch: '#eef2ff', background: 'linear-gradient(135deg, #eef2ff 0%, #f5f7fa 100%)', cardShadow: '0 10px 30px rgba(102,126,234,0.15)' },
    { name: 'Sunrise', swatch: '#fff9f0', background: 'linear-gradient(135deg, #fff9f0 0%, #f7f8fc 100%)', cardShadow: '0 10px 30px rgba(255,183,94,0.18)' },
    { name: 'Seafoam', swatch: '#ccfbf1', background: 'linear-gradient(135deg, #f0fffa 0%, #f4f7ff 100%)', cardShadow: '0 10px 30px rgba(56,189,158,0.16)' },
    { name: 'Slate', swatch: '#f1f5f9', background: 'linear-gradient(135deg, #f7f9fb 0%, #eef2f7 100%)', cardShadow: '0 10px 30px rgba(59,66,82,0.12)' }
  ];
  selectedPalette = this.paletteOptions[0];

  constructor(private service: DataAccessService) {}

  @HostListener('window:resize')
  onResize(): void {
    if (this.windowWidth() >= this.sidebarBreakpointPx) {
      this.mobileSidebarOpen = false;
    }
  }

  private windowWidth(): number {
    return typeof window !== 'undefined' ? window.innerWidth : this.sidebarBreakpointPx;
  }

  get isNarrowViewport(): boolean {
    return this.windowWidth() < this.sidebarBreakpointPx;
  }

  toggleMobileSidebar(): void {
    this.mobileSidebarOpen = !this.mobileSidebarOpen;
  }

  closeMobileSidebar(): void {
    this.mobileSidebarOpen = false;
  }

  get sidebarEntries(): DashboardSidebarEntry[] {
    return sidebarFromCategories(this.getCategories(), (label) =>
      label === 'All' ? 'fa-th-large' : 'fa-folder-open'
    );
  }

  get selectedSidebarId(): string {
    return this.selectedCategory === 'All' ? 'all' : slugifyLabel(this.selectedCategory);
  }

  get currentSidebarEntry(): DashboardSidebarEntry | undefined {
    return this.sidebarEntries.find((e) => e.id === this.selectedSidebarId);
  }

  selectSidebar(entry: DashboardSidebarEntry): void {
    this.selectedCategory = entry.filterKey;
    if (this.isNarrowViewport) {
      this.mobileSidebarOpen = false;
    }
  }

  countForSidebar(filterKey: string): number {
    return this.cards.filter((c) => {
      if (!this.showCard(c)) {
        return false;
      }
      if (filterKey === 'All') {
        return true;
      }
      return c.category === filterKey;
    }).length;
  }

  trackBySidebarId(_index: number, entry: DashboardSidebarEntry): string {
    return entry.id;
  }

  ngOnInit(): void {
    this.software_type = this.service.getPlantConfigFields('software_type') || '';
    this.get_rights();
    const savedPalette = localStorage.getItem('microbiology_dashboard_palette');
    if (savedPalette) {
      const found = this.paletteOptions.find(p => p.name === savedPalette);
      if (found) this.selectedPalette = found;
    }
  }

  get_rights(): void {
    const empId = localStorage.getItem('emp_id');
    if (!empId) return;
    this.service.get(
      'hr/employee.php?type=getrights&emp_id=' + encodeURIComponent(empId) + '&dep_name=' + encodeURIComponent(this.loggedInDept || '')
    ).subscribe((response: any) => {
      this.rights = response;
      const r = Array.isArray(response) && response[0] ? response[0] : {};
      this.isuser = r.isuser || 'No';
      this.ischecker = r.ischecker || 'No';
      this.isapprover = r.isapprover || 'No';
      this.qms_approver = r.qms_approver || 'No';
      this.dept_head = r.dept_head || 'No';
      this.isauditor = r.isauditor || 'No';
      this.plant_head = r.plant_head || 'No';
      this.shift_allocator = r.shift_allocator || 'No';
      this.trainig_cordinator = r.trainig_cordinator || 'No';
    });
  }

  getCategories(): string[] {
    return ['All', ...Array.from(new Set(this.cards.filter(c => this.showCard(c)).map(c => c.category)))];
  }

  showCard(card: DeptCard): boolean {
    if (card.showWhenNutraceutical === false && this.software_type === 'Nutraceutical') return false;
    return true;
  }

  getFilteredCards(): DeptCard[] {
    const q = (this.searchQuery || '').trim().toLowerCase();
    return this.cards.filter(c => {
      if (!this.showCard(c)) return false;
      const matchCategory = this.selectedCategory === 'All' || c.category === this.selectedCategory;
      const matchSearch = !q || c.title.toLowerCase().includes(q) || c.category.toLowerCase().includes(q);
      return matchCategory && matchSearch;
    });
  }

  trackByCardId(_index: number, card: DeptCard): string {
    return card.id;
  }

  togglePalette(): void {
    this.showPalette = !this.showPalette;
  }

  setPalette(palette: { name: string; swatch: string; background: string; cardShadow: string }): void {
    this.selectedPalette = palette;
    this.showPalette = false;
    try {
      localStorage.setItem('microbiology_dashboard_palette', palette.name);
    } catch {}
  }
}
