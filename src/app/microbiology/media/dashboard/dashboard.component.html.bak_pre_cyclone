<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Media Management</h3>
          <div routerLink="/microbiology" class="name-board2"><i class="fas fa-times"></i></div>
        </div>
        <!-- sub1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="block-container"  style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">

              <div *ngIf="isuser == 'Yes'" class="item-block" routerLink="master">
                <i class="fas fa-clipboard"></i>
                <span>MEDIA Master</span>
              </div>

              <div class="item-block" routerLink="stock">
                <i class="fas fa-box"></i>
                <span>Media Receiving</span>
              </div>

              <div class="item-block" routerLink="preparation">
                <i class="fas fa-flask"></i>
                <span>Media Preparation</span>
              </div>

   

              <div class="item-block" routerLink="sterilization">
                <i class="fas fa-burn"></i>
                <span>Autoclaving & Sterilization</span>
              </div>

              <div class="item-block" routerLink="growth">
                <i class="fas fa-microscope"></i>
                <span>Growth Promotion</span>
              </div>

              <div class="item-block" routerLink="decontamination">
                <i class="fas fa-biohazard"></i>
                <span>Decont. Of Media</span>
              </div>

                <div class="item-block" routerLink="disposal">
                  <i class="fas fa-trash-alt"></i>
                  <span>Media Disposal Record</span>
                </div>

                <div class="item-block" routerLink="stockbook">
                  <i class="fas fa-biohazard"></i>
                  <span>Stock Book</span>
                </div>
                <div class="item-block" routerLink="consumption">
                  <i class="fas fa-chart-pie"></i>
                  <span>Media Consumption</span>
                </div>
  
                <div class="item-block" routerLink="stock1">
                  <i class="fas fa-boxes"></i>
                  <span>Prepared Media Stock</span>
                </div>
              

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>