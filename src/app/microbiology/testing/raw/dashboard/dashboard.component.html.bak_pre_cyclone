
<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>RM/PM Microbiology Testing</h3>
          <div routerLink="/microbiology" class="name-board2"><i class="fas fa-times"></i></div>
        </div>
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="block-container">

              <div class="item-block" routerLink="awaiting">
                <i class="fas fa-vial"></i>
                <span>Awaiting RM/PM Testing</span>
              </div>

              <div *ngIf="ischecker == 'Yes'" class="item-block" routerLink="checking">
                <i class="fas fa-clipboard-check"></i>
                <span>Testing for Checking</span>
              </div>
      
              <div *ngIf="isapprover == 'Yes'" class="item-block" routerLink="correction">
                <i class="fas fa-edit"></i>
                <span>Correction</span>
              </div>

              <div class="item-block" routerLink="log">
                <i class="fas fa-book"></i>
                <span>Microbiology Testing Log</span>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>