<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Sampling</h3>
          <div routerLink="/microbiology/sampling" class="name-board2"><i class="fas fa-times"></i></div>
        </div>
        <!-- sub1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="block-container">
              <div class="item-block" routerLink="allocation">
                <i class="fas fa-clipboard-check"></i>
                <span>Sampling Allocation</span>
              </div>
              
              <div class="item-block" routerLink="new">
                <i class="fas fa-flask"></i>
                <span>New Sampling</span>
              </div>
              
              <div class="item-block" *ngIf="ischecker=='Yes'" routerLink="inprocess">
                <i class="fas fa-search"></i>
                <span>Samplings for Check</span>
              </div>
              
              <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="checking">
                <i class="fas fa-tasks"></i>
                <span>Samplings for Aprvl</span>
              </div>
              
              <div class="item-block" routerLink="log">
                <i class="fas fa-book"></i>
                <span>Samplings Report</span>
              </div>
              

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

