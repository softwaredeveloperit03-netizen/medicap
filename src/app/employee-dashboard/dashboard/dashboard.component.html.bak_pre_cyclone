 

<div class="component">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section" style="flex-direction: column;">
        <div class="header-block">
          <h3>Employee Dashboard</h3>
          <div routerLink="/" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>
    
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>Employee DashboardSection</h3>
            </div>
          </div>
          <div class="block-container" style="    
          display: grid;
          grid-template-columns: repeat(6, 150px);
          grid-gap: 35px;
          overflow-x: auto;
          max-width: 100%;">
         
            <div class="item-block" *ngIf="emp_stat==='old'" routerLink="../pending-leavs">
              <i class="fas fa-calendar-alt"></i>
              <span>Leave Application</span>
            </div>
            <div class="item-block" *ngIf="emp_stat==='old'" routerLink="../card_leave">
              <i class="fas fa-id-card"></i>
              <span>Leave Card</span>
            </div>
            <div class="item-block" *ngIf="emp_stat==='old'" routerLink="../leave_status">
              <i class="fas fa-info-circle"></i>
              <span>Leave Status</span>
            </div>
            
            <div class="item-block" routerLink="../payrole">
              <i class="fas fa-money-check-alt"></i>
              <span>Salary</span>
            </div>
            
            <div class="item-block" routerLink="../interview">
              <i class="fas fa-user-tie"></i>
              <span>Interview</span>
            </div>
            
            <!-- <div class="item-block" routerLink="self-certificate">
              <i class="fas fa-bell"></i>
              <span>Notice & Alert</span>
            </div> -->
            
            <div class="item-block" routerLink="/employee-dashboard/visitors">
              <i class="fas fa-calendar-day"></i>
              <span>Visitors</span>
            </div>

            <div class="item-block" routerLink="../outpass">
              <i class="fas fa-id-card"></i>
              <span>Outpass</span>
            </div>
            
            <!-- <div class="item-block" routerLink="self-certificate">
              <i class="fas fa-comments"></i>
              <span>Paperless Chat</span>
            </div>
            
            <div class="item-block" routerLink="self-certificate">
              <i class="fas fa-envelope"></i>
              <span>Emails</span>
            </div> -->
            
            <div class="item-block" routerLink="/employee-dashboard/resignation/acceptance">
              <i class="fas fa-sign-out-alt"></i>
              <span>Resignation</span>
            </div>
            
            <div class="item-block" routerLink="../duty">
              <i class="fas fa-briefcase"></i>
              <span>Outdoor Duty Form</span>
            </div>
            
            <div class="item-block" routerLink="../apprisal">
              <i class="fas fa-chart-line"></i>
              <span>Appraisal Request</span>
            </div>
            <div class="item-block" routerLink="../shifts">
              <i class="fas fa-chart-line"></i>
              <span>Current Shift </span>
            </div>
            <div class="item-block" routerLink="../individual">
              <i class="fas fa-chart-line"></i>
              <span>Attendance </span>
            </div>
            <div class="item-block"  (click)="add_floor=true">
              <i class="fas fa-calendar-day"></i>
              <span>Holidays </span>
            </div>
            
            <div class="item-block" routerLink="../training">
              <i class="fas fa-chart-line"></i>
              <span>Training</span>
            </div>
            <div class="item-block" routerLink="../jobres">
              <i class="fas fa-chart-line"></i>
              <span>Job Responsibility</span>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<clr-modal [(clrModalOpen)]="add_floor" clrModalClosable="false" clrModalSize="lg">
  <h3 class="modal-title">Holiday List </h3>
  <div class="modal-body">
    <div class="card-block">
      <div class="card-title">
    <!--     <input type="button" value="new Qualification" (click)="isNewQualification = true" class="btn btn-sm btn-info-outline"> -->
      </div>
      <div class="card-text">
        <clr-datagrid>
             <clr-dg-column clrDgField="qualification">Holiday Date</clr-dg-column>
             <clr-dg-column>Holiday Name</clr-dg-column>
    
            <clr-dg-row *clrDgItems="let user of holidays; let i = index " [clrDgItem]="user">
                 <clr-dg-cell>{{user.holiday_date | date: 'dd-MM-yyyy'}}</clr-dg-cell>
                <clr-dg-cell>{{user.holiday_name}}</clr-dg-cell>
               
            </clr-dg-row>

      
        </clr-datagrid>
      
      </div>
    </div>
  </div>
 
</clr-modal>

<clr-modal [(clrModalOpen)]="YourRights" clrModalClosable="false" clrModalSize="lg">
  <h3 class="modal-title">Your RIghts</h3>
  <div class="modal-body">
    <div class="card-block">
      <div class="card-title">
       </div>
      <div class="card-text">
        <clr-datagrid>
             <clr-dg-column clrDgField="qualification">Holiday Date</clr-dg-column>
             <clr-dg-column>Holiday Name</clr-dg-column>
    
            <clr-dg-row *clrDgItems="let user of holidays; let i = index " [clrDgItem]="user">
                 <clr-dg-cell>{{user.holiday_date | date: 'dd-MM-yyyy'}}</clr-dg-cell>
                <clr-dg-cell>{{user.holiday_name}}</clr-dg-cell>
            </clr-dg-row>
        </clr-datagrid>
      
      </div>
    </div>
  </div>
 
</clr-modal>
