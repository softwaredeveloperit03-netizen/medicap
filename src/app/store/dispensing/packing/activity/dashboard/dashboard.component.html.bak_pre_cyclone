  <!------------------------------------------------------------------>
  <div class="component store-legacy-dash">
    <div class="subsection">
      <div class="purchase-block">
        <div style="text-align:end" class="exit-section">
          <div class="header-block" style="margin:10px 0px">
            <h3>Activity</h3>
          <div routerLink="/store/dispensing/packing" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>
  
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="block-container">

              <div *ngIf="plant_type=='Formulation' && plant_id=='67'" class="item-block" routerLink="spinprocess">
                <i class="fas fa-cogs"></i> <!-- Icon for Inprocess Activity -->
                <span>Inprocess Activity</span>
              </div>
              
              <div *ngIf="plant_type!='Formulation'" class="item-block" routerLink="inprocess">
                <i class="fas fa-tasks"></i> <!-- Icon for Inprocess Activity -->
                <span>Inprocess Activity</span>
              </div>
              
              <div *ngIf="plant_type=='Formulation' && plant_id!='67'" class="item-block" routerLink="inprocess">
                <i class="fas fa-cogs"></i> <!-- Icon for Inprocess Activity -->
                <span>Inprocess Activity..</span>
              </div>
              
              <div class="item-block" routerLink="complete">
                <i class="fas fa-check-circle"></i> <!-- Icon for Complete Activity -->
                <span>Complete Activity</span>
              </div>
              


            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>
  