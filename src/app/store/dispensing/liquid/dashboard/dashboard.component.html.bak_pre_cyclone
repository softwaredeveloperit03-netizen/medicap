<div class="card">
    <div class="card-header" style="text-align: center">
      <div class="clr-row" style="margin-bottom: -10px;">
        <div class="clr-col-lg-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Dispensing of Liquid Material</div>
        <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
          <button class="btn btn-sm btn-danger" routerLink="/store/dispensing">{{'common.close' | translate}}</button>
        </div>
      </div>
    </div>
    <div class="card-block">
      <div class="card-text">
        <div class="clr-row">
  
          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12">
            <div class="card clickable" routerLink="request">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/raw.png">
                <p class="card-text"><b>Awaiting Dispensing Requests</b></p>
              </div>
            </div>
          </div>
  
          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12">
            <div class="card clickable" routerLink="hold">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/request.png">
                <p class="card-text"><b>On Hold Requests</b></p>
              </div>
            </div>
          </div>
        
          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12">
            <div class="card clickable" routerLink="activity">
           <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/material.png">
                <p class="card-text"><b>Dispensing Activity</b></p>
              </div>
            </div>
          </div>
  
          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12">
            <div class="card clickable" routerLink="log">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text"><b>Dispensing Log</b></p>
              </div>
            </div>
          </div>
  
          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12">
            <div class="card clickable" routerLink="report">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/report.png">
                <p class="card-text"><b>Dispensing Report</b></p>
              </div>
            </div>
          </div>

          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12">
            <div class="card clickable" routerLink="manual">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/new.png">
                <p class="card-text"><b>Manual Dispensing</b></p>
              </div>
            </div>
          </div>
          
        </div>
      </div>
    </div>
  </div>