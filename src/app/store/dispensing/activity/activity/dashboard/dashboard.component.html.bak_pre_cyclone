<div class="card">
    <div class="card-header" style="text-align: center">
      <div class="clr-row" style="margin-bottom: -10px;">
        <div class="clr-col-lg-6" style="color: aliceblue;margin-top: -2px;text-align: left;">Activity</div>
        <div class="clr-col-lg-6" style="text-align: right;padding-right: 0px;margin-top: -7px;">
          <button class="btn btn-sm btn-danger" routerLink="/store/dispensing/raw">{{'common.close' | translate}}</button>
        </div>
      </div>
    </div>
    <div class="card-block">
      <div class="card-text">
        <div class="clr-row">
  
          <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12">
            <div class="card clickable" routerLink="start">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/activity.png">
                <p class="card-text"><b> Start Activity</b></p>
              </div>
            </div>
          </div>

          <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12">
            <div class="card clickable" routerLink="inprocess">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/inprocess.png">
                <p class="card-text"><b> Inprocess Activity</b></p>
              </div>
            </div>
          </div>
  
          <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12">
            <div class="card clickable" routerLink="complete">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/report.png">
                <p class="card-text"><b> Complete Activity</b></p>
              </div>
            </div>
          </div>
  
        </div>
      </div>
    </div>
  </div>