<div class="card">
    <div class="card-header" style="text-align: center">
      <div class="clr-row" style="margin-bottom: -10px;">
        <div class="clr-col-lg-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Raw Material Status</div>
        <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
          <button class="btn btn-sm btn-danger" routerLink="/store/material-status"> {{'common.close' | translate}} </button>
        </div>
      </div>
    </div>
    <div class="card-block">
      <div class="card-text">
        <div class="clr-row">


          <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12">
            <div class="card clickable" routerLink="quarantine" style="background-color: blue; border-color: blue; color: white;">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text" style="color: white;"><b>Quarantine Stock</b></p>
              </div>
            </div>
          </div>

          <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12">
            <div class="card clickable" routerLink="test" style="background-color: yellow; border-color: yellow; color: black">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text" style="color: black"><b>Under Test Stock</b></p>
              </div>
            </div>
          </div>


          <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12">
            <div class="card clickable" routerLink="approved" style="background-color: green; border-color: green;">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text" style="color: white;"><b>Approved Stock</b></p>
              </div>
            </div>
          </div>


          <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12">
            <div class="card clickable" routerLink="approved" style="background-color: brown; border-color: brown;">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text" style="color: white;"><b>On Hold Stock</b></p>
              </div>
            </div>
          </div>


         
          <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12">
            <div class="card clickable" routerLink="quarantine" style="background-color: red; border-color: red; color: white;">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text" style="color: white;"><b>Rejected Stock</b></p>
              </div>
            </div>
          </div>



        </div>
        <br>
        <table class="table">
          <tr>
            <th>Sr.</th>
            <th>Material Name</th>
            <th>Batch No.</th>
            <th>Packaging Slip</th>
            <th>Receiving Dt.</th>
            <th>Challan Qty.</th>
            <th>Received Qty</th>
            <th>{{'common.unit' | translate}}</th>
            <th>Grade</th>
            <th>GRN Dt.</th>
            <th>GRN No.</th>
            <th>GRN Status</th>
         </tr>
      
          <tr *ngFor="let stock of stocks; let i = index">
            <td style="text-align: left;">{{ i+1 }}.</td>
            <td style="text-align: left;">{{ stock.material_name }}</td>
            <td style="text-align: left;">{{ stock.batch_no }}</td>
            <td style="text-align: left;">{{ stock.challan_no }}</td>
            <td style="text-align: left;">{{ stock.receiving_date |date:'dd-MM-yyyy' }}</td>
            <td style="text-align: left;">{{ stock.challan_qty}}</td>
            <td style="text-align: left;">{{ stock.received_qty}}</td>
            <td style="text-align: left;">{{ stock.unit }}</td>
            <td style="text-align: left;">{{ stock.grade }}</td>
            <td style="text-align: left;">{{ stock.grn_date |date:'dd-MM-yyyy' }}</td>
            <td style="text-align: left;">{{ stock.grn_no |date:'dd-MM-yyyy'}}</td>
            <td style="text-align: left;">{{ status }}</td>         
           
          </tr>
          <tr *ngIf="stocks?.length == 0">
            <td colspan="10">{{'common.noRecords' | translate}}</td>
          </tr>
        </table>

