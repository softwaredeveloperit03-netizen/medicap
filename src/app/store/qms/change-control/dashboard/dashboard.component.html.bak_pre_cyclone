<div class="component store-legacy-dash">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Change Control</h3>
        <div routerLink="/store/qms" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="block-container">
            <div class="item-block" routerLink="new" *ngIf="isuser == 'Yes'">
              <i class="fas fa-plus-circle"></i>
              <span>New Initiate</span>
            </div>
            
            <div class="item-block" *ngIf="qms_approver=='Yes'" routerLink="review">
              <i class="fas fa-eye"></i>
              <span>Change Ctrl For Review</span>
            </div>
            
            <div class="item-block" routerLink="implementation">
              <i class="fas fa-check-circle"></i>
              <span>Change Control For Impl</span>
            </div>
            
            <div class="item-block" routerLink="log">
              <i class="fas fa-book"></i>
              <span>Log</span>
            </div>
            
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
</div>