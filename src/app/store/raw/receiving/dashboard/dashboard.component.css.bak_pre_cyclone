:host ::ng-deep button[clrTabLink].solid-tab-btn {
  border: 0 !important;
  color: #ffffff !important;
  font-weight: 700;
  border-radius: 6px 6px 0 0;
  margin-right: 0.35rem;
  padding: 0.45rem 0.9rem !important;
}

:host ::ng-deep button[clrTabLink].receiving-tab-btn {
  background-color: #2563eb !important;
}

:host ::ng-deep button[clrTabLink].audit-tab-btn {
  background-color: #0f766e !important;
}

:host ::ng-deep button[clrTabLink].solid-tab-btn[aria-selected='true'] {
  box-shadow: inset 0 -3px 0 rgba(255, 255, 255, 0.95);
  filter: brightness(1.05);
}

:host ::ng-deep button[clrTabLink].solid-tab-btn[aria-selected='false'] {
  opacity: 0.92;
}

:host .audit-wrap {
  margin-top: 0.6rem;
}

:host .audit-filters {
  display: grid;
  grid-template-columns: 1fr 1fr 2fr 1fr auto;
  gap: 0.6rem;
  align-items: end;
  margin-bottom: 0.6rem;
}

:host .filter-col label {
  display: block;
  margin-bottom: 0.2rem;
  font-size: 0.72rem;
  font-weight: 700;
  color: #0f3f6b;
}

:host .filter-col input,
:host .filter-col select {
  width: 100%;
  min-height: 1.9rem;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  padding: 0.15rem 0.45rem;
  font-size: 0.78rem;
}

:host .small-col {
  max-width: 8rem;
}

:host .action-col {
  display: flex;
  align-items: center;
}

:host .datagrid-wrapper {
  border: 1px solid #dbeafe;
  border-radius: 6px;
  overflow: hidden;
  background: #fff;
}

@media (max-width: 1200px) {
  :host .audit-filters {
    grid-template-columns: 1fr 1fr;
  }
}
