<div class="component store-legacy-dash">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Receiving of Material</h3>
          <div routerLink="/store/raw" class="name-board2"><i class="fas fa-times"></i></div>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <clr-tabs>
          <clr-tab>
            <button clrTabLink class="solid-tab-btn receiving-tab-btn">Receiving</button>
            <clr-tab-content *clrIfActive>
              <div class="category">
                <div class="line-section">
                  <div class="header-div">
                    <h3>Receiving of Material Section</h3>
                  </div>
                </div>
                <div class="block-container">
                  <div class="item-block" routerLink="awaiting">
                    <i class="fas fa-box-open"></i>
                    <span>Awaiting Materials</span>
                  </div>

                  <div class="item-block" *ngIf="ischecker=='Yes' || isapprover=='Yes'" routerLink="checking">
                    <i class="fas fa-check-square"></i>
                    <span>Material Checking</span>
                  </div>

                  <div class="item-block" routerLink="log">
                    <i class="fas fa-book"></i>
                    <span>Log Book</span>
                  </div>

                  <div class="item-block" routerLink="material-log">
                    <i class="fas fa-clipboard-list"></i>
                    <span>Lot No. Assignment Log</span>
                  </div>

                  <div class="item-block" routerLink="rejected">
                    <i class="fas fa-times-circle"></i>
                    <span>Rejected Materials</span>
                  </div>
                </div>
              </div>
            </clr-tab-content>
          </clr-tab>

          <clr-tab>
            <button clrTabLink class="solid-tab-btn audit-tab-btn" (click)="openAuditTab()">Audit Trail</button>
            <clr-tab-content *clrIfActive>
              <div class="audit-wrap">
                <div class="audit-filters">
                  <div class="filter-col">
                    <label>From Date</label>
                    <input type="date" [(ngModel)]="from_date" />
                  </div>
                  <div class="filter-col">
                    <label>To Date</label>
                    <input type="date" [(ngModel)]="to_date" />
                  </div>
                  <div class="filter-col">
                    <label>Search</label>
                    <input type="text" [(ngModel)]="searchQuery" placeholder="Search audit data..." />
                  </div>
                  <div class="filter-col small-col">
                    <label>No. of Rows</label>
                    <select [ngModel]="pageSize" (ngModelChange)="onPageSizeChange($event)">
                      <option *ngFor="let size of pageSizeOptions" [ngValue]="size">{{ size }}</option>
                    </select>
                  </div>
                  <div class="action-col">
                    <button class="btn btn-sm btn-primary" (click)="getAuditTrail()">Get Audit Trail</button>
                  </div>
                </div>

                <div class="datagrid-wrapper">
                  <clr-datagrid [clrDgLoading]="auditLoading" >
                    <clr-dg-column>Sr. No.</clr-dg-column>
                    <clr-dg-column>Activity Module</clr-dg-column>
                    <clr-dg-column>Form</clr-dg-column>
                    <clr-dg-column>Activity</clr-dg-column>
                    <clr-dg-column>Nature</clr-dg-column>
                    <clr-dg-column>Done By</clr-dg-column>
                    <clr-dg-column>{{'common.department' | translate}}</clr-dg-column>
                    <clr-dg-column>Date Time</clr-dg-column>
                    <clr-dg-column>IP Address</clr-dg-column>
                    <clr-dg-column>Duration of Login</clr-dg-column>

                    <clr-dg-row *clrDgItems="let row of filteredAuditRows; let i = index" [clrDgItem]="row">
                      <clr-dg-cell>{{ getSrNo(i) }}</clr-dg-cell>
                      <clr-dg-cell>{{ row.activity_module }}</clr-dg-cell>
                      <clr-dg-cell>{{ row.form }}</clr-dg-cell>
                      <clr-dg-cell>{{ row.activity }}</clr-dg-cell>
                      <clr-dg-cell>{{ row.activity_nature }}</clr-dg-cell>
                      <clr-dg-cell>{{ row.done_by }}</clr-dg-cell>
                      <clr-dg-cell>{{ row.department }}</clr-dg-cell>
                      <clr-dg-cell>{{ row.date_time | date:'dd-MM-yyyy HH:mm:ss' }}</clr-dg-cell>
                      <clr-dg-cell>{{ row.ip_address }}</clr-dg-cell>
                      <clr-dg-cell>{{ row.duration_of_login }}</clr-dg-cell>
                    </clr-dg-row>

                    <clr-dg-footer>
                      <clr-dg-pagination #pagination [(clrDgPage)]="currentPage" [clrDgPageSize]="pageSize">
                        <span>
                          {{ pagination.totalItems ? (pagination.firstItem + 1) : 0 }} -
                          {{ pagination.totalItems ? (pagination.lastItem + 1) : 0 }} of {{ pagination.totalItems }}
                        </span>
                      </clr-dg-pagination>
                    </clr-dg-footer>
                  </clr-datagrid>
                </div>
              </div>
            </clr-tab-content>
          </clr-tab>
        </clr-tabs>
      </div>
    </div>
  </div>
</div>