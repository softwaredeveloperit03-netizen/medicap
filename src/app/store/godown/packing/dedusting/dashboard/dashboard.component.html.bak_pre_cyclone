<div class="card" *ngIf="!isView">
  <div class="card-header" style="text-align: center">
    <div class="clr-row" style="margin-bottom: -10px;">
      <div class="clr-col-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Dedusting of Packing Material
      </div>
      <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
        <button class="btn btn-success btn-sm" routerLink="new">Awaiting</button>
        <button class="btn btn-sm" routerLink="/store/godown/packing" style="background-color: red;color: white;">
          <clr-icon shape="window-close" class="is-solid"></clr-icon> CLOSE
        </button>
      </div>
    </div>
  </div>
  <div class="card-block">
    <div class="card-text">
      <div class="clr-row">
        <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-xs-12">
          <label>Material Type:</label>
          <select name="material_type" [(ngModel)]="material_type"  (change)="filterStock()" required>
            <option>Primary</option>
            <option>Secondary</option>
            <option>Tertiary</option>
          </select>
        </div>
        <!-- <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12">
          <label>Material Name:</label>
          <input type="text" name="material_name" [(ngModel)]="material_name" (keyup)="filterStock()" required>
        </div> -->
        <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12">
          <button class="btn btn-danger" (click)="AllRecord()" style="margin-top: 30px;">Clear Filter</button>
          <!-- <button class="btn btn-danger" style="margin-top:30px;" (click)="getDedustingsLog()">{{'common.search' | translate}}</button> -->
        </div>
      </div>
      <div class="card-text">
        <table class="table table-border">
          <tr>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">Sr.</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Receiving No.</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Receiving Date</th>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">Material Code</th>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">Material Name</th>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">Material Type</th>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">Vendor Name</th>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">Grade</th>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">Containers</th>
            <!-- <th style="text-align: left;">{{'common.status' | translate}}</th> -->
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">{{'common.table.action' | translate}}</th>
          </tr>
          <tr *ngFor="let result of results; let i = index">
            <td style="text-align: left;">{{ i + 1 }}.</td>
            <td>{{result.document_no}}</td>
            <td>{{result.receiving_date | date : 'yyyy-MM-dd'}}</td>
            <td style="text-align: left;">{{ result.material_code }}</td>
            <td style="text-align: left;">{{ result.material_name }}</td>
            <td style="text-align: left;">{{ result.material_subtype }}</td>
            <td style="text-align: left;">{{ result.vendor_name}}</td>
            <td style="text-align: left;">{{ result.grade }}</td>
            <td style="text-align: right;">{{ result.containers }}</td>
            <!-- <td style="text-align: left;">{{ result.dedusting }}</td> -->
            <td>
              <button class="btn btn-sm btn-info" (click)="view(i)">{{'common.view' | translate}}</button>
            </td>
          </tr>
          <tr *ngIf="results?.length == 0">
            <td colspan="10">{{'common.noRecords' | translate}}</td>
          </tr>
        </table>
      </div>
    </div>
  </div>
  <div class="card-footer"><button class="btn btn-primary" (click)="downloadLog()">{{'common.download' | translate}}</button></div>
</div>

<div class="container-fluid" *ngIf="isView">
  <div class="card">
    <div class="card-header">DEDUSTING LOG</div>
    <div class="card-block">
      <div class="card-text">
        <table class="table table-border">
          <tr>
            <td style="text-align: left;"><b>Material Name:</b></td>
            <td colspan="3" style="text-align: left;">{{ selectedReport['material_name'] }}</td>
          </tr>
          <tr>
            <td style="text-align: left;"><b>Vendor Name:</b></td>
            <td colspan="3" style="text-align: left;">{{ selectedReport['vendor_name'] }}</td>
          </tr>
          <tr>
            <td style="text-align: left;">Vendor Type</td>
            <td style="text-align: left;">{{selectedReport['vendor_type']}}</td>
            <td style="text-align: left;">Manufacturer</td>
            <td style="text-align: left;">{{selectedReport['manufacturer']}}</td>
          </tr>
          <tr>
            <td style="text-align: left;"><b>Packaging Slip:</b></td>
            <td style="text-align: left;">{{ selectedReport['challan_no'] }}</td>
            <td style="text-align: left;"><b>Packaging Slip Date:</b></td>
            <td style="text-align: left;">{{ selectedReport['challan_date'] }}</td>
          </tr>
          <tr>
            <td style="text-align: left;"><b>PO No.:</b></td>
            <td style="text-align: left;">{{ selectedReport['po_no'] }}</td>
            <td style="text-align: left;"><b>PO Date:</b></td>
            <td style="text-align: left;">{{ selectedReport['po_date'] }}</td>
          </tr>
          <tr>
            <td style="text-align: left;"><b>Material Type:</b></td>
            <td style="text-align: left;">{{ selectedReport['material_type'] }}</td>
            <td style="text-align: left;"><b>Material Subtype:</b></td>
            <td style="text-align: left;">{{ selectedReport['material_name'] }}</td>
          </tr>
          <tr>
            <td style="text-align: left;"><b>Material Code:</b></td>
            <td style="text-align: left;">{{ selectedReport['material_code'] }}</td>
            <td style="text-align: left;"><b>Material Grade:</b></td>
            <td style="text-align: left;">{{ selectedReport['grade'] }}</td>
          </tr>
          <tr>
            <td style="text-align: left;"><b>Qty:</b></td>
            <td style="text-align: left;" colspan="3">{{ selectedReport['qty'] }}</td>
          </tr>
          <tr>
            <td style="text-align: left;"><b>PO Qty:</b></td>
            <td style="text-align: left;" colspan="3">{{ selectedReport['order_qty'] }} {{
              selectedReport['unit'] }}</td>
          </tr>
        </table>
        <h3 *ngIf="selectedReport['material_subtype'] == 'Primary'">Labeling Details:</h3>
        <table class="table table-border" *ngIf="selectedReport['material_subtype'] == 'Primary'">
          <tr>
            <th style="background-color: rgb(14, 67, 112); color: white;">Sr.</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Batch No</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Qty {{ selectedReport['unit'] }}</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">No Of Packs</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Mfg Date (Optional)</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Exp Date (Optional)</th>
          </tr>
          <tr *ngFor="let list of selectedReport['batches'];let i=index">
            <td>{{i+1}}</td>
            <td>{{list.batch_no}}</td>
            <td>{{list.qty_received}}</td>
            <td>{{list.total_containers}}</td>
            <td>{{list.mfg_date}}</td>
            <td>{{list.exp_date}}</td>
          </tr>
          <tr *ngIf="selectedReport['batches']?.length == 0">
            <td colspan="7">No Record Found!</td>
          </tr>
        </table>
        <h3>Dedusting Details:</h3>
        <table class="table table-border">
          <tr>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">Dedusting</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Equipment Code</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Start Time</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">End Time</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Done By</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Check By</th>
          </tr>
          <tr>
            <td style="text-align: left;">Vaccume Cleaner</td>
            <td>{{ selectedReport['dedusting_details'].equipment_code }}</td>
            <td>{{ selectedReport['dedusting_details'].from_time }}</td>
            <td>{{ selectedReport['dedusting_details'].to_time }}</td>
            <td>{{ selectedReport['dedusting_details'].operator }}</td>
            <td>{{ selectedReport['dedusting_details'].approve_by }}</td>
          </tr>
          <tr>
            <td style="text-align: left;">Equipment Cleaning</td>
            <td>{{ selectedReport['dedusting_details'].equipment_code }}</td>
            <td>{{ selectedReport['dedusting_details'].area_cleaned_from }}</td>
            <td>{{ selectedReport['dedusting_details'].area_cleaned_to }}</td>
            <td>{{ selectedReport['dedusting_details'].area_cleaned_by }}</td>
            <td>{{ selectedReport['dedusting_details'].approve_by }}</td>
          </tr>
          <tr>
            <td style="text-align: left;">Area Cleaning</td>
            <td>{{ selectedReport['dedusting_details'].equipment_code }}</td>
            <td>{{ selectedReport['dedusting_details'].equip_cleaned_from }}</td>
            <td>{{ selectedReport['dedusting_details'].equip_cleaned_to }}</td>
            <td>{{ selectedReport['dedusting_details'].equip_cleaned_by }}</td>
            <td>{{ selectedReport['dedusting_details'].approve_by }}</td>
          </tr>
        </table>
      </div>
    </div>
    <div class="card-footer">
      <button class="btn btn-danger" (click)="isView = false">{{'common.close' | translate}}</button>
    </div>
  </div>
</div>
