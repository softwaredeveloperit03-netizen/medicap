  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Product Release Status</h3> <!-- Change Heading -->
          <div routerLink="/dispatch" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <!-- section1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;"><!-- Repeate this container -->
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Product Release Status Section</h3><!-- Change sub- Heading -->
              </div>
            </div>
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">
              <div class="item-block" routerLink="under-test">
                <i class="fas fa-vial"></i>
                <span>Under Test</span>
              </div>
              
              <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="qc">
                <i class="fas fa-check"></i>
                <span>QC Approved</span>
              </div>
              
              <div class="item-block" routerLink="qa">
                <i class="fas fa-check-double"></i>
                <span>QA Released</span>
              </div>
              

           
            </div>
          </div>
        </div>
        <!-- section1 -->

      </div>
    </div>
  </div>
</div>