<div class="module">
    <div class="subdiv">
      <div class="purchase-container">
        <div style="text-align: end" class="close-block">
          <div class="heading-container" style="margin: 10px 0px">
            <h3>Training </h3>
            <div routerLink="/" class="name-board1">
              <i class="fas fa-times"></i>
            </div>
          </div>
  
  
        </div>
  
        <div class="master-block">
          <div class="section">
            <div class="line-container">
              <div class="heading">
                <h3>Training</h3>
              </div>
            </div>
            <div class="card-block" style="    
              display: grid;
              grid-template-columns: repeat(6, 150px);
              grid-gap: 35px;
              overflow-x: auto;
              max-width: 100%;">
                
  
              <div class="item-block" routerLink="approval">
                <i class="fas fa-clock"></i>
                <span>Training Approval</span>
                <span>Concern HOD</span>
              </div>


              <div *ngIf="department == 'Quality Assurance'" class="item-block" routerLink="QaApproval">
                <i class="fas fa-clock"></i>
                <span>QA Training Approval</span>
               </div>

 
              <div class="item-block" routerLink="induction">
                <i class="fas fa-clock"></i>
                <span>induction Training report</span>
              </div>

              
              <div class="item-block" routerLink="qaInductionApproval" *ngIf="department == 'Quality Assurance'">
                <i class="fas fa-clock"></i>
                <span>Final induction Tr. Appr.</span>
                <span>For Manager QA</span>
              </div>
         
    
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>