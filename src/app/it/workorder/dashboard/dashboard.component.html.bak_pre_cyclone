<div class="component">
    <div class="subsection">
      <div class="purchase-block" >
        <div style="text-align:end" class="exit-section" style="flex-direction: column;">
          <div class="header-block">
            <h3>Work Order</h3>
            <div routerLink="/it" class="name-board2"><i class="fas fa-times"></i>
            </div>
          </div>
          <div class="header-block" style="margin:0px;flex-wrap: wrap;justify-content: center;">  </div>
        </div>

        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Work Order</h3>
              </div>
            </div>
            <div class="block-container" style="display: grid;grid-template-columns: repeat(6, 150px);grid-gap: 35px;overflow-x: auto;max-width: 100%;">


              <div class="item-block" routerLink="receiveWorkOrder" *ngIf="isuser == 'Yes'">
                <i class="fas fa-bug"></i>
                <span>Received Work Order</span>
              </div>

              <div class="item-block" routerLink="summarryOfWorkOrder" *ngIf="isuser == 'Yes'">
                <i class="fas fa-sign-in-alt"></i>
                <span>Summary Of Work Order Done</span>
              </div>

              <div class="item-block" routerLink="workOrderChecking" *ngIf="ischecker == 'Yes'">
                <i class="fas fa-file-signature"></i>
                <span>Checking</span>
              </div>

              <div class="item-block" routerLink="log1" >
                <i class="fas fa-sign-in-alt"></i>
                <span>Log</span>
              </div>


            </div>
          </div>
        </div>
      </div>
    </div>
  </div>