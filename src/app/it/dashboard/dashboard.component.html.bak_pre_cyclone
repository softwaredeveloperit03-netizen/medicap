<div class="dashboard-shell dashboard-shell--pro" [style.background]="selectedPalette.background">
  <ng-container *ngIf="filteredItems as cards">
    <div class="compact-layout">
      <aside class="compact-sidebar">
        <div class="compact-sidebar__head">
          <span class="compact-sidebar__title">{{ 'it.dashboard.modulesTitle' | translate }}</span>
          <span class="compact-sidebar__count">{{ cards.length }}</span>
        </div>
        <nav class="compact-sidebar__tabs" aria-label="IT modules">
          <button
            type="button"
            class="compact-nav-item compact-nav-item--all compact-nav-item--menu"
            [class.active]="selectedSidebarId === 'all'"
            (click)="showAllTabs()"
          >
            <i class="fas fa-layer-group" aria-hidden="true"></i>
            <span>{{ 'common.allTabs' | translate }}</span>
          </button>

          <button
            *ngFor="let entry of categorySidebarEntries; trackBy: trackBySidebarId"
            type="button"
            class="compact-nav-item compact-nav-item--menu"
            [class.active]="entry.id === selectedSidebarId"
            (click)="selectSidebar(entry)"
          >
            <i [class]="entry.icon" aria-hidden="true"></i>
            <span>{{ entry.name }}</span>
          </button>

          <a class="compact-nav-item" routerLink="/indend/raw" title="Purchase Requisition">
            <i class="fas fa-boxes" aria-hidden="true"></i>
            <span>{{ 'it.links.indent' | translate }}</span>
          </a>
          <a class="compact-nav-item" routerLink="/qa/qms" title="QMS">
            <i class="fas fa-clipboard-check" aria-hidden="true"></i>
            <span>{{ 'it.links.qms' | translate }}</span>
          </a>
          <a class="compact-nav-item" routerLink="/preventiveimain" title="PM Intimation">
            <i class="fas fa-tools" aria-hidden="true"></i>
            <span>{{ 'it.links.pmIntimation' | translate }}</span>
          </a>
          <a class="compact-nav-item" routerLink="/breakdown" title="Breakdown">
            <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
            <span>{{ 'it.links.breakdown' | translate }}</span>
          </a>
          <a class="compact-nav-item" routerLink="/hrfordepthead" title="Dept Head">
            <i class="fas fa-user-tie" aria-hidden="true"></i>
            <span>{{ 'it.links.hrDept' | translate }}</span>
          </a>
          <a class="compact-nav-item" routerLink="/training" title="Training">
            <i class="fas fa-user-tie" aria-hidden="true"></i>
            <span>Training</span>
          </a>
        </nav>
      </aside>

      <div class="compact-main">
        <div class="dash-header dash-header--single-line">
          <div class="title-block"><h2>{{ 'it.dashboard.title' | translate }}</h2></div>
          <div class="header-actions-row">
            <div class="search-box dash-header__search">
              <i class="fas fa-search"></i>
              <input type="text" [ngModel]="searchQuery" (ngModelChange)="onSearchModelChange($event)" [placeholder]="'common.searchPlaceholder' | translate" aria-label="Search modules" />
            </div>
            <app-floating-docs-popup class="dash-header__docs"></app-floating-docs-popup>
            <a class="close-btn" routerLink="/" aria-label="Close"><i class="fas fa-times"></i>{{ 'common.close' | translate }}</a>
          </div>
        </div>

        <h3 class="section-label">{{ 'it.dashboard.section' | translate }}</h3>
        <div class="tiles-grid">
          <ng-container *ngFor="let item of cards; trackBy: trackByItemId">
            <a *ngIf="isItemVisible(item.id)" class="tile-card" [routerLink]="item.route" [ngStyle]="{'box-shadow': selectedPalette.cardShadow}">
              <div class="icon-wrap" [style.background]="tileGradient(item)">
                <i [class]="item.icon"></i>
                <span class="badge-count" *ngIf="getPendingCount(item.id) > 0">{{ getPendingCount(item.id) }}</span>
              </div>
              <div class="tile-body"><div class="tile-title">{{ item.name | translate }}</div></div>
            </a>
          </ng-container>

          <div class="empty-state" *ngIf="cards.length === 0"><i class="fas fa-search"></i><p>No modules match your search. Try another keyword or category.</p></div>
        </div>
      </div>
    </div>
  </ng-container>

  <button class="palette-fab" type="button" (click)="togglePalette()" title="Change theme" aria-label="Change theme"><i class="fas fa-palette"></i></button>
  <div class="palette-drawer" *ngIf="showPalette">
    <button *ngFor="let palette of paletteOptions" type="button" class="palette-chip" [class.active]="palette === selectedPalette" [style.background]="palette.background" [title]="palette.name" (click)="setPalette(palette)" [attr.aria-label]="'Theme ' + palette.name"><span class="sr-only">{{ palette.name }}</span></button>
  </div>
</div>
