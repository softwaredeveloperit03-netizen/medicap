  ];
  selectedPalette: { name: string; swatch: string; background: string; cardShadow: string } = this.paletteOptions[0];

  constructor(
    private service: DataAccessService,
    private cdr: ChangeDetectorRef
  ) {
    this.loggedInDept = localStorage.getItem('department');
  }

  ngOnInit(): void {
    this.get_rights();
    const savedPalette = localStorage.getItem('admin_dashboard_palette');
    if (savedPalette) {
      const found = this.paletteOptions.find(p => p.name === savedPalette);
      if (found) {
        this.selectedPalette = found;
        this.cdr.markForCheck();
      }
    }
  }

  get_rights(): void {
    const empId = localStorage.getItem('emp_id');
    if (!empId) { return; }
    this.service.get(
      'hr/employee.php?type=getrights&emp_id=' +
      encodeURIComponent(empId) +
      '&dep_name=' +
      encodeURIComponent(this.loggedInDept || '')
    ).subscribe((response: any) => {
      this.rights = response;
      const r = Array.isArray(response) && response[0] ? response[0] : {};
      this.dept_head = r.dept_head || 'No';
      this.trainig_cordinator = r.trainig_cordinator || 'No';
      this.cdr.markForCheck();
    });
  }

  getFilteredCards(): DeptCard[] {
    const q = (this.searchQuery || '').trim().toLowerCase();
    return this.allCards.filter(c => {
      const matchSidebar =
        this.selectedSidebarModule === 'ALL' ||
        (this.selectedSidebarModule === 'ADMIN_MANAGEMENT' && this.adminManagementIds.has(c.id)) ||
        (this.selectedSidebarModule === 'FACILITIES_MANAGEMENT' && this.facilitiesManagementIds.has(c.id)) ||
        (this.selectedSidebarModule === 'TRANSPORT_MANAGEMENT' && this.transportManagementIds.has(c.id));
      const matchCategory = this.selectedCategory === 'All' || c.category === this.selectedCategory;
      const matchSearch = !q || c.title.toLowerCase().indexOf(q) !== -1 || (c.description && c.description.toLowerCase().indexOf(q) !== -1) || c.category.toLowerCase().indexOf(q) !== -1;
      return matchSidebar && matchCategory && matchSearch;
    });
  }

  getOtherAdminSidebarCards(): DeptCard[] {
    const cardsById = new Map(this.allCards.map(function(c) { return [c.id, c] as [string, DeptCard]; }));
    return Array.from(this.adminOtherIds)
      .map(function(id) { return cardsById.get(id); })
      .filter(function(c): c is DeptCard { return !!c; });
  }

  selectSidebarModule(module: 'ALL' | 'ADMIN_MANAGEMENT' | 'FACILITIES_MANAGEMENT' | 'TRANSPORT_MANAGEMENT'): void {
    this.selectedSidebarModule = module;
    this.selectedCategory = 'All';
    this.searchQuery = '';
  }

  showAllTabs(): void {
    this.selectSidebarModule('ALL');
  }

  trackByCardId(_index: number, card: DeptCard): string {
    return card.id;
  }

  togglePalette(): void {
    this.showPalette = !this.showPalette;
    this.cdr.markForCheck();
  }

  setPalette(palette: { name: string; swatch: string; background: string; cardShadow: string }): void {
    this.selectedPalette = palette;
    this.showPalette = false;
    try {
      localStorage.setItem('admin_dashboard_palette', palette.name);
    } catch (e) {}
    this.cdr.markForCheck();
  }
}
