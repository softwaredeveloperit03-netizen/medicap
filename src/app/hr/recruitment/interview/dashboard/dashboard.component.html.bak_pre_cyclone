<div class="component hr-legacy-dash">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Interview Forms</h3>
          <div routerLink="/hr/recruitment" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Interview Forms Section</h3>
              </div>
            </div>
            <!-- Main-dashboard -->
            <div class="block-container">
              <div class="item-block" routerLink="awaiting">
                <i class="fas fa-hourglass-half"></i>
                <span>Awaiting</span>
                <div class="badge" *ngIf=" unreadrinterview  > 0">{{ unreadrinterview }}</div>

              </div>

              <div class="item-block" routerLink="log">
                <i class="fas fa-book"></i>
                <span>Log</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>