/* Recruitment hub — compact, aligned with HR Department dashboard */

:root {
  --rec-text: #0f172a;
  --rec-muted: #64748b;
  --rec-border: #dbe3ee;
  --rec-card: #ffffff;
}

.recruitment-dashboard {
  min-height: calc(100vh - 40px);
  padding: 16px 18px 72px;
  box-sizing: border-box;
  color: var(--rec-text);
  transition: background 0.25s ease;
}

.recruitment-dashboard__panel {
  max-width: 1200px;
  margin: 0 auto;
  background: var(--rec-card);
  border: 1px solid var(--rec-border);
  border-radius: 14px;
  box-shadow: 0 8px 26px rgba(15, 23, 42, 0.08);
  padding: 0 0 16px;
  overflow: hidden;
}

/* Header bar — same family as HR Department main panel */
.recruitment-dashboard__header {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: nowrap;
  gap: 10px;
  margin: 0 0 0 0;
  padding: 10px 14px;
  background: linear-gradient(135deg, #1e293b 0%, #334155 50%, #0f172a 100%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  overflow-x: auto;
  overflow-y: hidden;
}

.recruitment-dashboard__title {
  flex: 0 0 auto;
}

.recruitment-dashboard__title h2 {
  margin: 0;
  font-size: 1rem;
  font-weight: 700;
  color: #f8fafc;
  letter-spacing: 0.02em;
  white-space: nowrap;
}

.recruitment-dashboard__actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1 1 auto;
  min-width: 0;
  flex-wrap: nowrap;
}

.recruitment-dashboard__search {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 0 0 200px;
  min-width: 160px;
  max-width: 220px;
  height: 30px;
  padding: 3px 8px;
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
}

.recruitment-dashboard__search:focus-within {
  box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.45);
  border-color: rgba(125, 211, 252, 0.6);
}

.recruitment-dashboard__search input {
  border: none;
  outline: none;
  width: 100%;
  font-size: 11px;
  background: transparent;
  color: var(--rec-text);
}

.recruitment-dashboard__search i {
  color: #94a3b8;
  font-size: 11px;
}

.recruitment-dashboard__chips {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 1 1 auto;
  min-width: 0;
  overflow-x: auto;
  flex-wrap: nowrap;
  padding-bottom: 2px;
}

.recruitment-dashboard__chip {
  flex-shrink: 0;
  padding: 5px 10px !important;
  font-size: 10.5px !important;
  font-weight: 600;
  border-radius: 8px !important;
  border: 1px solid rgba(255, 255, 255, 0.35) !important;
  background: rgba(255, 255, 255, 0.12) !important;
  color: #e2e8f0 !important;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.recruitment-dashboard__chip:hover {
  background: rgba(255, 255, 255, 0.2) !important;
  color: #fff !important;
}

.recruitment-dashboard__chip.active {
  background: linear-gradient(135deg, #0ea5e9 0%, #2563eb 100%) !important;
  border-color: transparent !important;
  color: #fff !important;
  box-shadow: 0 4px 12px rgba(14, 165, 233, 0.35);
}

.recruitment-dashboard__close {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  height: 30px;
  min-height: 30px;
  padding: 0 10px !important;
  font-size: 10.5px !important;
  font-weight: 600;
  border-radius: 8px !important;
  background: linear-gradient(135deg, #b91c1c 0%, #dc2626 100%) !important;
  color: #fff !important;
  text-decoration: none;
  box-shadow: 0 3px 10px rgba(185, 28, 28, 0.32);
  border: none;
}

.recruitment-dashboard__close:hover {
  color: #fff !important;
  filter: brightness(1.05);
}

.recruitment-dashboard__close i {
  font-size: 10px;
}

.recruitment-dashboard__section {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--rec-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 14px 16px 10px;
}

.recruitment-dashboard__tiles {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  gap: 12px;
  padding: 0 16px 8px;
}

.recruitment-dashboard__tile {
  position: relative;
  background: var(--rec-card);
  border: 1px solid var(--rec-border);
  border-radius: 12px;
  padding: 12px;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 10px;
  align-items: center;
  text-decoration: none;
  color: inherit;
  overflow: hidden;
  box-shadow: 0 2px 0 rgba(148, 163, 184, 0.12);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.recruitment-dashboard__tile::before {
  content: '';
  position: absolute;
  inset: 0 auto 0 0;
  width: 4px;
  background: linear-gradient(180deg, #0ea5e9 0%, #2563eb 100%);
  border-radius: 12px 0 0 12px;
}

.recruitment-dashboard__tile:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.12);
}

.recruitment-dashboard__tile .icon-wrap {
  width: 46px;
  height: 46px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  color: #fff;
  font-size: 1.05rem;
  box-shadow: 0 6px 14px rgba(15, 23, 42, 0.18);
  position: relative;
  z-index: 1;
}

.recruitment-dashboard__tile .tile-body {
  min-width: 0;
  z-index: 1;
}

.recruitment-dashboard__tile .tile-title {
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--rec-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recruitment-dashboard__tile .tile-description {
  font-size: 0.72rem;
  color: var(--rec-muted);
  margin: 0;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.badge-count {
  position: absolute;
  top: -4px;
  right: -4px;
  background: #ef4444;
  color: #fff;
  border-radius: 999px;
  min-width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 700;
  padding: 0 4px;
  box-shadow: 0 2px 6px rgba(239, 68, 68, 0.45);
}

.recruitment-dashboard__empty {
  grid-column: 1 / -1;
  padding: 24px 12px;
  border-radius: 12px;
  border: 1px dashed var(--rec-border);
  background: #f8fafc;
  color: var(--rec-muted);
}

.recruitment-dashboard__empty i {
  font-size: 1.25rem;
  margin-bottom: 8px;
  color: #94a3b8;
}

.recruitment-dashboard__palette-fab {
  position: fixed;
  right: 18px;
  bottom: 22px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: none;
  background: linear-gradient(135deg, #6366f1 0%, #7c3aed 100%);
  color: #fff;
  font-size: 16px;
  cursor: pointer;
  box-shadow: 0 10px 28px rgba(99, 102, 241, 0.35);
  z-index: 100;
  display: grid;
  place-items: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.recruitment-dashboard__palette-fab:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 32px rgba(99, 102, 241, 0.42);
}

.palette-drawer {
  position: fixed;
  left: 50%;
  bottom: 78px;
  transform: translateX(-50%);
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 8px;
  padding: 8px 12px;
  background: #fff;
  border: 1px solid var(--rec-border);
  border-radius: 999px;
  box-shadow: 0 14px 36px rgba(15, 23, 42, 0.14);
  z-index: 99;
  animation: recSlideUp 0.2s ease;
}

@keyframes recSlideUp {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

.palette-chip {
  width: 26px;
  height: 26px;
  padding: 0;
  border-radius: 50%;
  cursor: pointer;
  border: 2px solid transparent;
  flex-shrink: 0;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.palette-chip.active {
  border-color: #1e293b;
  box-shadow: 0 0 0 2px #fff, 0 3px 10px rgba(0, 0, 0, 0.2);
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@media (max-width: 768px) {
  .recruitment-dashboard__header {
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .recruitment-dashboard__actions {
    flex-wrap: wrap;
    width: 100%;
  }

  .recruitment-dashboard__search {
    flex: 1 1 100%;
    max-width: none;
  }

  .recruitment-dashboard__tiles {
    grid-template-columns: 1fr;
  }

  .recruitment-dashboard__tile {
    grid-template-columns: auto 1fr;
  }
}
