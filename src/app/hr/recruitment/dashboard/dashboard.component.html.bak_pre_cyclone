<div class="recruitment-dashboard" [style.background]="selectedPalette.background">
  <div class="recruitment-dashboard__panel">
    <div class="recruitment-dashboard__header dash-header--single-line">
      <div class="recruitment-dashboard__title">
        <h2>{{ pageTitle }}</h2>
      </div>
      <div class="recruitment-dashboard__actions">
        <div class="recruitment-dashboard__search search-box">
          <i class="fas fa-search" aria-hidden="true"></i>
          <input
            type="text"
            [(ngModel)]="searchQuery"
            placeholder="Search modules…"
            aria-label="Search modules"
          />
        </div>
        <div class="recruitment-dashboard__chips category-bar">
          <button
            *ngFor="let cat of getCategories()"
            type="button"
            class="chip recruitment-dashboard__chip"
            [class.active]="cat === selectedCategory"
            (click)="selectedCategory = cat"
          >
            {{ cat }}
          </button>
        </div>
        <a class="recruitment-dashboard__close close-btn" routerLink="/hr" aria-label="Back to HR">
          <i class="fas fa-times"></i>
          Close
        </a>
      </div>
    </div>

    <h3 class="recruitment-dashboard__section">{{ sectionLabel }}</h3>

    <div class="recruitment-dashboard__tiles tiles-grid">
      <a
        *ngFor="let card of getFilteredCards(); trackBy: trackByCardId"
        class="recruitment-dashboard__tile tile-card"
        [routerLink]="card.route"
        [ngStyle]="{'box-shadow': selectedPalette.cardShadow}"
      >
        <div class="icon-wrap" [style.background]="card.gradient">
          <i class="fas" [ngClass]="card.icon" aria-hidden="true"></i>
          <span class="badge-count" *ngIf="card.badgeCount && card.badgeCount() > 0">{{ card.badgeCount() }}</span>
        </div>
        <div class="tile-body">
          <div class="tile-title">{{ card.title }}</div>
          <p class="tile-description" *ngIf="card.description">{{ card.description }}</p>
        </div>
      </a>

      <div class="empty-state recruitment-dashboard__empty" *ngIf="getFilteredCards().length === 0">
        <i class="fas fa-search"></i>
        <p>No modules match your search. Try another keyword or category.</p>
      </div>
    </div>
  </div>

  <button
    class="recruitment-dashboard__palette-fab palette-fab"
    type="button"
    (click)="togglePalette()"
    title="Change theme"
    aria-label="Change theme"
  >
    <i class="fas fa-palette"></i>
  </button>

  <div class="palette-drawer" *ngIf="showPalette">
    <button
      *ngFor="let palette of paletteOptions"
      type="button"
      class="palette-chip"
      [class.active]="palette === selectedPalette"
      [style.background]="palette.swatch"
      [title]="palette.name"
      (click)="setPalette(palette)"
      [attr.aria-label]="'Theme ' + palette.name"
    >
      <span class="sr-only">{{ palette.name }}</span>
    </button>
  </div>
</div>
