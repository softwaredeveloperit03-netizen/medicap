<div class="component hr-legacy-dash">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Master</h3>
          <div class="name-board2" role="button" tabindex="0" (click)="closeFromMasterHub()" (keydown.enter)="closeFromMasterHub()" title="Close">
            <i class="fas fa-times"></i>
          </div>
        </div>

        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Master Section</h3>
              </div>
            </div>

            <div class="block-container">
              <div class="item-block" routerLink="shift">
                <i class="fas fa-user-clock"></i>
                <span>Shift Master</span>
              </div>

              <div class="item-block" routerLink="log">
                <i class="fas fa-calendar-alt"></i>
                <span>Leave Policy Master</span>
              </div>

              <div class="item-block" routerLink="test-medical">
                <i class="fas fa-stethoscope"></i>
                <span>Medical Test Master</span>
              </div>

              <div class="item-block" routerLink="/master/checklist/new">
                <i class="fas fa-list"></i>
                <span>CheckList Master</span>
              </div>

              <div class="item-block" routerLink="asset" *ngIf="plant_id == '58'">
                <i class="fas fa-cogs"></i>
                <span>Asset Master</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
