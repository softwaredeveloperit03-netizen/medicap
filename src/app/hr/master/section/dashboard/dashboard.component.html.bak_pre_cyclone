<div class="card">
  <div class="card-header" style="text-align: center">
    <div class="clr-row" style="margin-bottom: -10px;">
      <div class="clr-col-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Section Master</div>
      <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
        <button class="btn btn-sm btn-success" routerLink="new" style="color: white;" *ngIf="isuser == 'Yes'"> New </button>
          <button class="btn btn-sm" routerLink="/hr" style="background-color: red;color: white;">
            <clr-icon shape="window-close" class="is-solid"></clr-icon> CLOSE
        </button>
      </div>
    </div>
 
       <!--  <div class="clr-col-lg-5 clr-col-md-5 clr-col-sm-5 clr-col-xs-12">
          <label>Status:</label>
          <select name="status" [(ngModel)]="status" required>
            <option></option>
            <option>Active</option>
            <option>{{'common.pending' | translate}}</option>
          </select>
        </div> -->
        
        <clr-datagrid>
          
            
                <clr-dg-column>{{'common.table.srNo' | translate}}</clr-dg-column>
                <clr-dg-column>{{'common.department' | translate}}</clr-dg-column>
                <clr-dg-column>Room Name</clr-dg-column>
                <clr-dg-column>Room Number</clr-dg-column>
                <!-- <th style="text-align: left; background-color: rgb(14, 67, 112); color: white;">Building No</th>
                <th style="text-align: left; background-color: rgb(14, 67, 112); color: white;">Room No</th>  -->
                <!-- <th style="text-align: left;">{{'common.status' | translate}}</th> -->
            

            <clr-dg-row *clrDgItems="let user of results; let i = index">
                <clr-dg-cell>{{ calculateStartSrNo() + i+1}}</clr-dg-cell>
                <clr-dg-cell>{{user.department}}</clr-dg-cell>
                <clr-dg-cell>{{user.section_name}}</clr-dg-cell>
                <clr-dg-cell>{{user.section_code}}</clr-dg-cell>
                <!-- <td style="text-align: left;">{{user.building_no}}</td>
                <td style="text-align: left;">{{user.room_no}}</td>
                <td style="text-align: left;">{{user.status}}</td> -->
            </clr-dg-row>
            <clr-dg-footer>  
              <clr-dg-pagination #pagination [(clrDgPageSize)]="pageSize" (clrDgPageChange)="onPageChange($event)">
                {{pagination.firstItem + 1}} - {{pagination.lastItem + 1}}
                of {{pagination.totalItems}} 
              </clr-dg-pagination>
            </clr-dg-footer>
        </clr-datagrid>
    </div>
  </div>
