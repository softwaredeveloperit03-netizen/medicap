<div class="card">
  <div class="card-header" style="text-align: center">
    <div class="clr-row" style="margin-bottom: -10px;">
      <div class="clr-col-9" style="color: aliceblue;margin-top: -2px;text-align: left;">{{'common.department' | translate}}</div>
      <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
        <button class="btn btn-sm btn-success" routerLink="new" style="color: white;">{{'common.new' | translate}}</button>
        <button class="btn btn-sm" routerLink="/hr" style="background-color: red;color: white;">
          <clr-icon shape="window-close" class="is-solid"></clr-icon> CLOSE
        </button>
      </div>
    </div>
  </div>  
    <div class="card-block">
    <div class="card-text">
        <div class="clr-row">
            <table class="table">
                <tr>
                    <th>Sr.</th>
                    <th style="text-align: left;"> Department Name</th>
                    <!-- <th style="text-align: left;"> Department Code</th>
                    <th style="text-align: left;"> Building No</th>
                    <th style="text-align: left;"> Entry By</th>
                    <th style="text-align: left;"> Entry Date </th>
                    <th style="text-align: left;">{{'common.status' | translate}}</th> -->
                </tr>
                <tr *ngFor="let res of results ;let i=index">
                    <td> {{ i+1 }}</td>
                    <td style="text-align: left;"> {{ res.department_name}}</td><!-- 
                    <td style="text-align: left;">{{ res.department_code}}</td>
                    <td style="text-align: left;">{{ res.department_building}}</td>
                    <td style="text-align: left;">{{ res.entry_by}}</td>
                    <td style="text-align: left;">{{ res.entry_date}}</td>
                    <td style="text-align: left;">{{ res.status}}</td> -->
                </tr>
            </table>
        </div>
    </div>
</div>
