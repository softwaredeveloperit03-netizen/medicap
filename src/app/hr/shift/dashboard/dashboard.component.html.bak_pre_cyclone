<div class="component hr-legacy-dash">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Shift Management</h3>
          <div routerLink="/hr" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Shift Management Section</h3>
              </div>
            </div>

            <!-- Main-dashboard -->

            <div class="block-container">

              <div class="item-block" routerLink="/hr/master/shift">
                <i class="fas fa-clock"></i> <!-- Updated icon for Shift Master -->
                <span>Shift Master</span>
              </div>
              
              <div  *ngIf="shift_allocator == 'Allocator' || shift_allocator == 'Both'" class="item-block" routerLink="allocation">
                <i class="fas fa-tasks"></i> <!-- Updated icon for Shift Allocation -->
                <span>Shift Initiator</span>
              </div>
              
              <div *ngIf="shift_allocator == 'Reviewer' || shift_allocator == 'Both'" class="item-block" routerLink="schedule">
                <i class="fas fa-calendar-alt"></i> <!-- Updated icon for Schedule -->
                <span>Schedule</span>
              </div>
              
              <div  class="item-block" routerLink="log">
                <i class="fas fa-calendar-alt"></i> <!-- Updated icon for Schedule -->
                <span>Shift Log</span>
              </div>

              <div class="item-block" routerLink="request">
                <i class="fas fa-calendar-alt"></i> <!-- Updated icon for Schedule -->
                <span>Shift Change Request</span>
              </div>
              <div class="item-block" routerLink="seeoff">
                <i class="fas fa-calendar-alt"></i>  
                <span>C Off</span>
              </div>
              <div class="item-block" routerLink="checkshift">
                <i class="fas fa-calendar-alt"></i>  
                <span>Check Shift</span>
              </div>
              
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>