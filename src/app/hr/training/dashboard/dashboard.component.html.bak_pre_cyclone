 

<div class="component hr-legacy-dash">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Induction Training Dashboard</h3>
        <div routerLink="/hr" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>
      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>Induction Training Dashboard</h3>
            </div>
          </div>
          <div  class="block-container">
            <div *ngIf="dept_head == 'Yes' || isTrainingCordi == 'Yes'" class="item-block" routerLink="induction">
              <i class="fas fa-clipboard-check"></i> <!-- Font Awesome icon for Training Need Identification -->
              <span>Induction Train. Initiation</span>
            </div>
          
            <div *ngIf="dept_head == 'Yes' || isTrainingCordi == 'Yes'" class="item-block" routerLink="identification">
              <i class="fas fa-bullhorn"></i> <!-- Font Awesome icon for Training Announcement -->
              <span>Induction Training.</span>
            </div>

            <div *ngIf="dept_head == 'Yes' || isTrainingCordi == 'Yes'" class="item-block" routerLink="hreval">
              <i class="fas fa-bullhorn"></i> <!-- Font Awesome icon for Training Announcement -->
              <span>Induction Train. Evaluation</span>
            </div>
            
            <div class="item-block" routerLink="log">
              <i class="fas fa-file-alt"></i> <!-- Font Awesome icon for Training Log -->
              <span>Induction Training Log</span>
            </div>
            <div class="item-block" routerLink="/hr/training/evaluate/log">
              <i class="fas fa-file-alt"></i> <!-- Font Awesome icon for Training Log -->
              <span>Induction Training</span>
              <span>Status Log</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>