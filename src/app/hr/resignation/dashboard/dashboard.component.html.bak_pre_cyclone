<div class="component hr-legacy-dash">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Resignation & Releaving</h3>
          <div routerLink="/hr" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Resignation & Releaving Section</h3>
              </div>
            </div>

            <!-- Main-dashboard -->

            <div class="block-container">


              <div class="item-block" routerLink="res">
                <i class="fas fa-user-times"></i> <!-- Updated icon for Resignation -->
                <span>Resignation</span>
              </div>
              
              <div class="item-block" routerLink="acceptance" *ngIf="ischecker=='Yes' || isapprover=='Yes'">
                <i class="fas fa-check-circle"></i> <!-- Updated icon for Resignation Acceptance -->
                <span>Resign. Acceptance</span>
              </div>
              
              <!-- <div class="item-block" routerLink="clearance">
                <i class="fas fa-user-lock"></i> 
                 <span>Employee Clearance</span>
              </div> -->
              
              <div class="item-block" routerLink="interview">
                <i class="fas fa-comments"></i> <!-- Updated icon for Exit Interview -->
                <span>Exit Interview</span>
              </div>
              
              <div class="item-block" routerLink="letter">
                <i class="fas fa-file-alt"></i> <!-- Updated icon for Experience Letter -->
                <span>Experience Letter</span>
              </div>
              





            


            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
