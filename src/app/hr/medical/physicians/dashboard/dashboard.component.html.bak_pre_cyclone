<div class="component hr-legacy-dash">
  <div class="subsection">
      <div class="purchase-block">
          <div style="text-align:end" class="exit-section">
              <div class="header-block" style="margin:10px 0px">
                  <h3>Physicians Management</h3>
                  <div routerLink="/hr/medical" class="name-board2"><i class="fas fa-times"></i>
                  </div>
              </div>

              <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
                  <div class="category">
                      <div class="line-section">
                          <div class="header-div">
                              <h3>Physicians Management Section</h3>
                          </div>
                      </div>
                      <!-- Main-dashboard -->
                      <div class="block-container">
                        <div class="item-block" routerLink="new" *ngIf="isuser == 'Yes'"
                        >
                          <i class="fas fa-user-md"></i>
                          <span>New Physician</span>
                        </div>
                        
                        <div class="item-block" routerLink="approval" *ngIf="isapprover=='Yes'">
                          <i class="fas fa-user-check"></i>
                          <span>Physician for Approval</span>
                        </div>
                        
                        <div class="item-block" routerLink="log">
                          <i class="fas fa-list-alt"></i>
                          <span>Physicians List</span>
                        </div>
                        
                        
                          
                      </div>
                  </div>
              </div>
          </div>
      </div>
  </div>
</div>