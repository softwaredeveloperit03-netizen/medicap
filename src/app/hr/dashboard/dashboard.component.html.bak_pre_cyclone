<div class="dashboard-shell dashboard-shell--pro" [style.background]="selectedPalette.background">
  <ng-container *ngIf="getFilteredCards() as cards">
    <div class="compact-layout">
      <aside class="compact-sidebar">
        <div class="compact-sidebar__head">
          <span class="compact-sidebar__title">{{ 'hr.dashboard.modulesTitle' | translate }}</span>
          <span class="compact-sidebar__count">{{ cards.length }}</span>
        </div>
        <nav class="compact-sidebar__tabs" aria-label="HR modules">
          <button
            type="button"
            class="compact-nav-item compact-nav-item--all compact-nav-item--menu"
            [class.active]="selectedSidebarModule === 'ALL'"
            (click)="showAllTabs()"
          >
            <i class="fas fa-layer-group" aria-hidden="true"></i>
            <span>{{ 'common.allTabs' | translate }}</span>
          </button>

          <button
            type="button"
            class="compact-nav-item compact-nav-item--menu"
            [class.active]="selectedSidebarModule === 'EMPLOYEE_MANAGEMENT'"
            (click)="selectSidebarModule('EMPLOYEE_MANAGEMENT')"
          >
            <i class="fas fa-users-cog" aria-hidden="true"></i>
            <span>{{ 'hr.sidebar.employeeManagement' | translate }}</span>
          </button>

          <button
            type="button"
            class="compact-nav-item compact-nav-item--menu"
            [class.active]="selectedSidebarModule === 'RECRUITMENT'"
            (click)="selectSidebarModule('RECRUITMENT')"
          >
            <i class="fas fa-users" aria-hidden="true"></i>
            <span>{{ 'hr.sidebar.recruitment' | translate }}</span>
          </button>

          <button
            type="button"
            class="compact-nav-item compact-nav-item--menu"
            [class.active]="selectedSidebarModule === 'HR_MASTER'"
            (click)="selectSidebarModule('HR_MASTER')"
          >
            <i class="fas fa-folder-tree" aria-hidden="true"></i>
            <span>{{ 'hr.sidebar.hrMaster' | translate }}</span>
          </button>

          <button
            type="button"
            class="compact-nav-item compact-nav-item--menu"
            [class.active]="selectedSidebarModule === 'LABOUR_MANAGEMENT'"
            (click)="selectSidebarModule('LABOUR_MANAGEMENT')"
          >
            <i class="fas fa-hard-hat" aria-hidden="true"></i>
            <span>{{ 'hr.sidebar.labourManagement' | translate }}</span>
          </button>

          <a
            *ngFor="let card of getOtherHrSidebarCards(); trackBy: trackByCardId"
            class="compact-nav-item"
            [routerLink]="card.route"
            [title]="card.title"
          >
            <i class="fas" [ngClass]="card.icon" aria-hidden="true"></i>
            <span>{{ card.title }}</span>
          </a>
        </nav>
      </aside>

      <div class="compact-main">
        <div class="dash-header dash-header--single-line">
          <div class="title-block">
            <h2>{{ 'hr.dashboard.title' | translate }}</h2>
          </div>
          <div class="header-actions-row">
            <div class="search-box dash-header__search">
              <i class="fas fa-search"></i>
              <input
                type="text"
                [(ngModel)]="searchQuery"
                [placeholder]="'common.searchPlaceholder' | translate"
                aria-label="Search modules"
              />
            </div>
            <app-floating-docs-popup
              class="dash-header__docs"
              [showSoftwareFlow]="false"
              [showOperationGuide]="false"
            ></app-floating-docs-popup>
            <div class="quick-links">
              <a class="quick-link-btn" routerLink="/indend/raw">{{ 'qc.links.indent' | translate }}</a>
              <a class="quick-link-btn" routerLink="/hrfordepthead" *ngIf="dept_head==='Yes'">{{ 'qc.links.deptHead' | translate }}</a>
              <a class="quick-link-btn" routerLink="/qa/qms">{{ 'qc.links.qms' | translate }}</a>
              <a class="quick-link-btn" routerLink="/training" *ngIf="trainig_cordinator==='Yes'">{{ 'qc.links.training' | translate }}</a>
              <a class="quick-link-btn" routerLink="/breakdown">{{ 'qc.links.breakdown' | translate }}</a>
            </div>
            <a class="close-btn" routerLink="/" aria-label="Close">
              <i class="fas fa-times"></i>
              {{ 'common.close' | translate }}
            </a>
          </div>
        </div>

        <h3 class="section-label">{{ 'hr.dashboard.section' | translate }}</h3>
        <div class="tiles-grid">
          <a
            *ngFor="let card of cards; trackBy: trackByCardId"
            class="tile-card"
            [routerLink]="card.route"
            [ngStyle]="{'box-shadow': selectedPalette.cardShadow}"
          >
            <div class="icon-wrap" [style.background]="card.gradient">
              <i class="fas" [ngClass]="card.icon"></i>
              <span class="badge-count" *ngIf="card.badgeCount && card.badgeCount() > 0">{{ card.badgeCount() }}</span>
            </div>
            <div class="tile-body">
              <div class="tile-title">{{ card.title }}</div>
              <p class="tile-description" *ngIf="card.description">{{ card.description }}</p>
            </div>
          </a>

          <div class="empty-state" *ngIf="cards.length === 0">
            <i class="fas fa-search"></i>
            <p>No modules match your search. Try another keyword or category.</p>
          </div>
        </div>
      </div>
    </div>
  </ng-container>

  <button class="palette-fab" type="button" (click)="togglePalette()" title="Change theme" aria-label="Change theme">
    <i class="fas fa-palette"></i>
  </button>

  <div class="palette-drawer" *ngIf="showPalette">
    <button
      *ngFor="let palette of paletteOptions"
      type="button"
      class="palette-chip"
      [class.active]="palette === selectedPalette"
      [style.background]="palette.swatch"
      [title]="palette.name"
      (click)="setPalette(palette)"
      [attr.aria-label]="'Theme ' + palette.name"
    >
      <span class="sr-only">{{ palette.name }}</span>
    </button>
  </div>
</div>
