  togglePalette(): void {
    this.showPalette = !this.showPalette;
  }

  setPalette(palette: { name: string; swatch: string; background: string; cardShadow: string }): void {
    this.selectedPalette = palette;
    this.showPalette = false;
    try {
      localStorage.setItem('hr_dashboard_palette', palette.name);
    } catch (e) {}
  }

  selectSidebarModule(module: 'ALL' | 'EMPLOYEE_MANAGEMENT' | 'RECRUITMENT' | 'LABOUR_MANAGEMENT' | 'HR_MASTER'): void {
    this.selectedSidebarModule = module;
    this.selectedCategory = 'All';
    this.searchQuery = '';
  }

  getOtherHrSidebarCards(): HrCard[] {
    const cardsById = new Map(this.hrCards.map(function(c) { return [c.id, c] as [string, HrCard]; }));
    return Array.from(this.hrOtherIds)
      .map(function(id) { return cardsById.get(id); })
      .filter((c): c is HrCard => !!c && this.isCardVisibleOnDashboard(c));
  }

  showAllTabs(): void {
    this.selectSidebarModule('ALL');
  }

  checkLogin(formData: any): void {
    const data = formData.value;
    this.service.post(
      'checkLogin.php?type=newLogin&username=' + encodeURIComponent(data['username']) + '&password=' + encodeURIComponent(data['password']),
      JSON.stringify(data)
    ).subscribe((response: any) => {
      if (response['status'] === 'success') {
        localStorage.setItem('token', response['token']);
        localStorage.setItem('department', response['department']);
        localStorage.setItem('designation', response['designation']);
        localStorage.setItem('user', response['user']);
        localStorage.setItem('checker', response['checker']);
        localStorage.setItem('approver', response['approver']);
        localStorage.setItem('username', response['username']);
        this.service.username = response['username'];
        this.service.userChange();
        if (response['department'] === 'Human Resource') {
          this.isLogin = true;
        }
      } else {
        this.isLogin = false;
      }
    });
  }

  validateUser(): void {
    const token = localStorage.getItem('token');
    const dept = localStorage.getItem('department');
    this.isLogin = !!(token && dept === 'Human Resource');
  }
