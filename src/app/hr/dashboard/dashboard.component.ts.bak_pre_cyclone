  ngOnInit(): void {
    this.get_rights();
    this.validateUser();
    this.getNotification();
    const savedPalette = localStorage.getItem('hr_dashboard_palette');
    if (savedPalette) {
      const found = this.paletteOptions.find(function(p) { return p.name === savedPalette; });
      if (found) {
        this.selectedPalette = found;
      }
    }
  }

  goToDeptHomePage(): void {
    const loggedInDept = localStorage.getItem('department');
    this.service.navigateToSpecificDeptHome(loggedInDept);
  }

  getNotification(): void {
    this.getPendingreqman();
    this.getPendingInterview();
  }

  getPendingreqman(): void {
    this.service.get('notification.php?type=getRequisitionrevisionNotification').subscribe((response: any) => {
      this.unreadrmanreq = Number(response['Pending_req']);
      if (this.unreadrmanreq > 0 && alertify) {
        alertify.warning(response['text']);
      }
    });
  }

  getPendingInterview(): void {
    this.service.get('notification.php?type=getPendingInterviews').subscribe((response: any) => {
      this.unreadrinterview = Number(response['Pending_interview']);
      if (this.unreadrinterview > 0 && alertify) {
        alertify.warning(response['text']);
      }
    });
  }

  get_rights(): void {
    const empId = localStorage.getItem('emp_id');
    if (!empId) { return; }
    this.service.get(
      'hr/employee.php?type=getrights&emp_id=' +
      encodeURIComponent(empId) +
      '&dep_name=' +
      encodeURIComponent(this.loggedInDept || '')
    ).subscribe((response: any) => {
      this.rights = response;
      const r = Array.isArray(response) && response[0] ? response[0] : {};
      this.isuser = r.isuser || 'No';
      this.ischecker = r.ischecker || 'No';
      this.isapprover = r.isapprover || 'No';
      this.qms_approver = r.qms_approver || 'No';
      this.dept_head = r.dept_head || 'No';
      this.isauditor = r.isauditor || 'No';
      this.isTrainingCordi = r.trainig_cordinator || 'No';
      this.plant_head = r.plant_head || 'No';
      this.shift_allocator = r.shift_allocator || 'No';
      this.trainig_cordinator = r.trainig_cordinator || 'No';
    });
  }

  getCategories(): string[] {
    return ['All'].concat(Array.from(new Set(this.hrCards.map(function(c) { return c.category; }))));
  }

  private isCardVisibleOnDashboard(c: HrCard): boolean {
    const employeeSidebarActive =
      this.selectedSidebarModule === 'EMPLOYEE_MANAGEMENT' && this.employeeManagementIds.has(c.id);
    const labourSidebarActive =
      this.selectedSidebarModule === 'LABOUR_MANAGEMENT' && this.labourManagementIds.has(c.id);
    const masterSidebarActive =
      this.selectedSidebarModule === 'HR_MASTER' && this.hrMasterIds.has(c.id);
    if (this.dashboardHiddenIds.has(c.id) && !employeeSidebarActive && !labourSidebarActive && !masterSidebarActive) {
      return false;
    }
    if (this.software_type === 'Pharma ERP' && this.pharmaHiddenIds.has(c.id)) {
      return false;
    }
    if (c.showWhen === 'dept_head' && this.dept_head !== 'Yes') {
      return false;
    }
    if (c.showWhen === 'isuser' && this.isuser !== 'Yes') {
      return false;
    }
    if (c.showWhen === 'trainig_cordinator' && this.trainig_cordinator !== 'Yes') {
      return false;
    }
    return true;
  }

  getFilteredCards(): HrCard[] {
    const q = (this.searchQuery || '').trim().toLowerCase();
    return this.hrCards.filter((c: HrCard) => {
      if (!this.isCardVisibleOnDashboard(c)) {
        return false;
      }
      const matchSidebar =
        this.selectedSidebarModule === 'ALL' ||
        (this.selectedSidebarModule === 'EMPLOYEE_MANAGEMENT' && this.employeeManagementIds.has(c.id)) ||
        (this.selectedSidebarModule === 'RECRUITMENT' && this.recruitmentManagementIds.has(c.id)) ||
        (this.selectedSidebarModule === 'LABOUR_MANAGEMENT' && this.labourManagementIds.has(c.id)) ||
        (this.selectedSidebarModule === 'HR_MASTER' && this.hrMasterIds.has(c.id));
      const matchCategory = this.selectedCategory === 'All' || c.category === this.selectedCategory;
      const matchSearch = !q || c.title.toLowerCase().indexOf(q) !== -1 || (c.description && c.description.toLowerCase().indexOf(q) !== -1) || c.category.toLowerCase().indexOf(q) !== -1;
      return matchSidebar && matchCategory && matchSearch;
    });
  }

  trackByCardId(_index: number, card: HrCard): string {
    return card.id;
