<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Marketing Department</h3> <!-- Change Heading -->
          <div routerLink="/export" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <!-- section1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;"><!-- Repeate this container -->
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Marketing Department Section</h3><!-- Change sub- Heading -->
              </div>
            </div>
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">


              <div class="item-block" routerLink="customer" *ngIf="isuser == 'Yes'">
                <i class="fas fa-user"></i>
                <span>Customer Registration</span>
              </div>
              
              <div class="item-block" routerLink="order-receiving">
                <i class="fas fa-shopping-basket"></i>
                <span>Order Receiving</span>
              </div>
              
              <div class="item-block" routerLink="order-review">
                <i class="fas fa-chart-bar"></i>
                <span>Order Analy. & Prev.</span>
              </div>
              
              <div class="item-block" routerLink="confirmation">
                <i class="fas fa-check"></i>
                <span>Order Confirmation</span>
              </div>
              
              <div class="item-block" routerLink="log">
                <i class="fas fa-book"></i>
                <span>Order Log</span>
              </div>
              
              <div class="item-block" routerLink="status">
                <i class="fas fa-clipboard-check"></i>
                <span>Order Status</span>
              </div>

            </div>
          </div>
        </div>
        <!-- section1 -->

      </div>
    </div>
  </div>
</div>