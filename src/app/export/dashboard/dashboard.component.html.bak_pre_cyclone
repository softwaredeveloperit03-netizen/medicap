<!-- Export sales DepartMent Start-->
<div class="module">
  <div class="subdiv">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="flex-direction: column;">
          <h3>Marketing  Department</h3>
        <div routerLink="/" class="name-board1">
          <i class="fas fa-times"></i>
        </div>
      </div>

        <div class="header-block">
          <button class="btn btn-sm btn-success" routerLink="/qa/qms">QMS</button>
          <button *ngIf="trainig_cordinator=='Yes'" class="btn btn-sm btn-success" routerLink="/training">Training</button>
          <button class="btn btn-sm btn-success" routerLink="/qms/maintenance">Maintenance</button>
          <button class="btn btn-sm btn-success custom-btn" routerLink="/hrfordepthead" *ngIf="dept_head=='Yes'">Dept Head</button>
        </div>
      </div>

      <div class="master-block">
        <div class="section">
          <div class="line-container" >
            <div class="heading">
              <h3>Marketing  Department Section</h3>
            </div>
          </div>
          <div class="card-block"style="    
          display: grid;
          grid-template-columns: repeat(6, 150px);
          grid-gap: 35px;
          overflow-x: auto;
          max-width: 100%;">
          <div class="item-block" routerLink="../marketing">
            <i class="fas fa-bullhorn"></i>
            <span>Marketing</span>
          </div>
          
          <div class="item-block" routerLink="thirdparty1">
            <i class="fas fa-handshake"></i>
            <span>Third Party Sales</span>
          </div>
          


          
          </div>
        </div>
      </div>




    </div>
  </div>
</div>
<!--  DepartMent End-->
