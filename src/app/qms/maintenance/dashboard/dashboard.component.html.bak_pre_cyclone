<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Maintenance Note</h3> <!-- Change Heading -->
          <div routerLink="/qms" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <!-- section1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;"><!-- Repeate this container -->
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Maintenance Note Section</h3><!-- Change sub- Heading -->
              </div>
            </div>
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">
              <div class="item-block" routerLink="new" *ngIf="isuser == 'Yes'">
                <i class="fas fa-plus-circle"></i>
                <span>New Maint. Note</span>
              </div>

              <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="approval">
                <i class="fas fa-check-circle"></i>
                <span>Maint. Note for Appr.</span>
              </div>

              <div class="item-block" routerLink="reject">
                <i class="fas fa-times-circle"></i>
                <span>Maint. for Rejection</span>
              </div>

              <div class="item-block" routerLink="log">
                <i class="fas fa-clipboard"></i>
                <span>Maint. Log</span>
              </div>


            </div>
          </div>
        </div>
        <!-- section1 -->

      </div>
    </div>
  </div>
</div>