<div class="container-fluid">
  <div class="card">
    <div class="card-header" style="text-align: center">
      <div class="clr-row" style="margin-bottom: -10px;">
        <div class="clr-col-9" style="color: aliceblue;margin-top: -2px;text-align: left;">SOP Management</div>
        <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
          <button class="btn btn-sm" routerLink="/" style="background-color: red;color: white;">
            <clr-icon shape="window-close" class="is-solid"></clr-icon> CLOSE
          </button>
        </div>
      </div>
    </div>
    <div class="card-block">
      <div class="card-text">
        <h3>SOP Initiation:</h3>
        <div class="clr-row">

          <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12" *ngIf="isChecker || isUser">
            <div class="card clickable"
              style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
              routerLink="initiate">
              <div class="card-block"
                style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                <img width="50px" height="50px" src="assets/new.png">
                <p class="card-text"><b>New SOP Request</b></p>
              </div>
            </div>
          </div>

          <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12" *ngIf="isChecker || isUser">
            <div class="card clickable"
              style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
              routerLink="draft/0">
              <div class="card-block"
                style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                <img width="50px" height="50px" src="assets/prepare.png">
                <p class="card-text"><b>Prepare Draft</b></p>
              </div>
            </div>
          </div>

          <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12" *ngIf="isChecker || isUser">
            <div class="card clickable"
              style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
              routerLink="changecontrol/0">
              <div class="card-block"
                style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                <img width="50px" height="50px" src="assets/change-control.png">
                <p class="card-text"><b>Raise Change Control</b></p>
              </div>
            </div>
          </div>

          <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12" *ngIf="isApprover">
            <div class="card clickable"
              style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
              routerLink="initiate-checking">
              <div class="card-block"
                style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                <img width="50px" height="50px" src="assets/checking.png">
                <p class="card-text"><b>Initiated SOPs for Checking</b></p>
              </div>
            </div>
          </div>

          <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
            <div class="card clickable"
              style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
              routerLink="initiate-log">
              <div class="card-block"
                style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text"><b>Initiated SOPs Log</b></p>
              </div>
            </div>
          </div>

        </div>

        <h3>New SOP & Revision:</h3>
        <div class="clr-row">

          <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12" *ngIf="isUser || isChecker">
            <div class="card clickable"
              style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
              routerLink="new">
              <div class="card-block"
                style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                <img width="50px" height="50px" src="assets/completed.png">
                <p class="card-text"><b>Prepare final SOP</b></p>
              </div>
            </div>
          </div>

          <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12" *ngIf="isApprover">
            <div class="card clickable"
              style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
              routerLink="checking">
              <div class="card-block"
                style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                <img width="50px" height="50px" src="assets/checking.png">
                <p class="card-text"><b>SOP for Checking</b></p>
              </div>
            </div>
          </div>

          <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
            <div class="card clickable"
              style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
              routerLink="log">
              <div class="card-block"
                style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text"><b>SOP Log</b></p>
              </div>
            </div>
          </div>
        </div>

        <div *ngIf="isApprover">
          <h3>Training & Implementation:</h3>
          <div class="clr-row">
            <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12">
              <div class="card clickable"
                style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
                routerLink="training">
                <div class="card-block"
                  style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                  <img width="50px" height="50px" src="assets/sop_training.png">
                  <p class="card-text"><b>Training of SOP</b></p>
                </div>
              </div>
            </div>

            <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12">
              <div class="card clickable"
                style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
                routerLink="implementation">
                <div class="card-block"
                  style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                  <img width="50px" height="50px" src="assets/implementation.png">
                  <p class="card-text"><b>Implementation of SOP</b></p>
                </div>
              </div>
            </div>

            <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-12">
              <div class="card clickable"
                style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
                routerLink="distribution">
                <div class="card-block"
                  style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                  <img width="50px" height="50px" src="assets/distribution.png">
                  <p class="card-text"><b>SOP Distribution Record</b></p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <h3>Receive & Revision SOPs:</h3>
        <div class="clr-row">
          <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
            <div class="card clickable"
              style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
              routerLink="revision">
              <div class="card-block"
                style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                <img width="50px" height="50px" src="assets/recovery.png">
                <p class="card-text"><b>Revision of SOP</b></p>
              </div>
            </div>
          </div>

          <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
            <div class="card clickable"
              style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
              routerLink="receive">
              <div class="card-block"
                style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                <img width="50px" height="50px" src="assets/sop_index.png">
                <p class="card-text"><b>Receive Hard Copies</b></p>
              </div>
            </div>
          </div>

          <div class="clr-col-xl-3 clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-12">
            <div class="card clickable"
              style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"
              routerLink="receive">
              <div class="card-block"
                style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
                <img width="50px" height="50px" src="assets/obsolate.png">
                <p class="card-text"><b>Obsolete SOPs</b></p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>