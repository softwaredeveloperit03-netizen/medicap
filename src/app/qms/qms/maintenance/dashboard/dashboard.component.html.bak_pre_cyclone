<div class="card">
  <div class="card-header" style="text-align: center">
    <div class="clr-row" style="margin-bottom: -10px;">
      <div class="clr-col-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Maintenance Note</div>
      <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
        <button class="btn btn-sm" routerLink="/" style="background-color: red;color: white;">{{'common.close' | translate}}</button>
      </div>
    </div>
  </div>
  <div class="card-block">
    <div class="card-text">
      <div class="clr-row">

        <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-6 clr-col-sm-12 clr-col-12">
          <div class="card clickable"style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"

          routerLink="new">
            <div class="card-block" style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
              <img width="60px" height="60px" src="assets/new.png">
              <p class="card-text"><b>New Maintenance Note</b></p>
            </div>
          </div>
        </div>

        <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-6 clr-col-sm-12 clr-col-12">
          <div class="card clickable"style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"

          routerLink="approval">
            <div class="card-block" style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
              <img width="60px" height="60px" src="assets/approval.png">
              <p class="card-text"><b>Maintenance Note for Approval</b></p>
            </div>
          </div>
        </div>
        <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-6 clr-col-sm-12 clr-col-12">
          <div class="card clickable"style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"

          routerLink="reject">
            <div class="card-block" style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
              <img width="60px" height="60px" src="assets/reject.png">
              <p class="card-text"><b>Maintenance for Rejection</b></p>
            </div>
          </div>
        </div>
        
        <div class="clr-col-xl-4 clr-col-lg-4 clr-col-md-6 clr-col-sm-12 clr-col-12">
          <div class="card clickable"style="height: auto; border: none; border-radius: 7px; box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, rgba(0, 0, 0, 0.07) 0px 2px 4px, rgba(0, 0, 0, 0.07) 0px 4px 8px, rgba(0, 0, 0, 0.07) 0px 8px 16px, rgba(0, 0, 0, 0.07) 0px 16px 32px, rgba(0, 0, 0, 0.07) 0px 32px 64px"

          routerLink="log">
            <div class="card-block" style="text-align: center; border-top: solid 3px rgb(50, 168, 149); border-radius: 7px;">
              <img width="60px" height="60px" src="assets/log.png">
              <p class="card-text"><b>Maintenance Log</b></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>