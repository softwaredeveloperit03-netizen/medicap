<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Change Control</h3> <!-- Change Heading -->
          <div routerLink="/" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <!-- section1 -->
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;"><!-- Repeate this container -->
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Change Control Section</h3><!-- Change sub- Heading -->
              </div>
            </div>
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">
              <div *ngIf="isuser == 'Yes'" class="item-block" routerLink="../new">
                <i class="fas fa-plus-circle"></i>
                <span>New Change Control</span>
              </div>

              <div class="item-block" routerLink="../checking" *>
                <i class="fas fa-search"></i>
                <span>Change Ctrl for Check</span>
              </div>

              <div class="item-block" routerLink="../review">
                <i class="fas fa-clipboard-check"></i>
                <span>Change Ctrl For Rev</span>
              </div>

              <div class="item-block" routerLink="../implementation">
                <i class="fas fa-tasks"></i>
                <span>Change Ctrl Impl.</span>
              </div>

              <div class="item-block" routerLink="../log">
                <i class="fas fa-chart-line"></i>
                <span>Change Ctrl Trend/Log</span>
              </div>

              <div class="item-block" routerLink="correction">
                <i class="fas fa-wrench"></i>
                <span>Correction</span>
              </div>



            </div>
          </div>
        </div>
        <!-- section1 -->

      </div>
    </div>
  </div>
</div>