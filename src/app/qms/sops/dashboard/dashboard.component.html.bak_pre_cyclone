   
<!-- ============================================ -->
<div class="component">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>SOP Management</h3>
        <div routerLink="/" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>SOP Initiation:</h3>
            </div>
          </div>
          <div class="block-container">
            <div class="item-block" *ngIf="isuser == 'Yes'" routerLink="initiate">
              <i class="fas fa-file"></i>
              <span>New SOP</span>
            </div>
            
            <div class="item-block" routerLink="initiate_check">
              <i class="fas fa-file"></i>
              <span>SOP </span>
            </div>
            
            <div class="item-block" routerLink="draft/0">
              <i class="fas fa-pencil-alt"></i>
              <span>Prepare Draft</span>
            </div>
            
            <div class="item-block" *ngIf="ischecker == 'Yes'" routerLink="initiate-checking">
              <i class="fas fa-check"></i>
              <span>Initiatd SOPs for Check</span>
            </div>
            
            <div class="item-block" routerLink="changecontrol/0">
              <i class="fas fa-exclamation-triangle"></i>
              <span>Raise Change Control</span>
            </div>
            
            <div class="item-block" routerLink="initiate-log">
              <i class="fas fa-book"></i>
              <span>Initiated SOPs Log</span>
            </div>
            
            <div class="item-block" routerLink="correction">
              <i class="fas fa-edit"></i>
              <span>Correction</span>
            </div>
            

            
          </div>
          
        </div>
      </div>


          
      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>New SOP & Revision:</h3>
            </div>
          </div>
          <div class="block-container">

            <div class="item-block" *ngIf="isuser == 'Yes'" routerLink="new">
              <i class="fas fa-file-alt"></i>
              <span>Prepare final SOP</span>
            </div>
            <div class="item-block" *ngIf="ischecker == 'Yes'" routerLink="checking">
              <i class="fas fa-check-circle"></i>
              <span>SOP for Checking</span>
            </div>
            <div class="item-block" routerLink="log">
              <i class="fas fa-book"></i>
              <span>SOP Log</span>
            </div>
          </div>
        </div>
      </div>
      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>Receive & Revision SOPs:</h3>
            </div>
          </div>
          <div class="block-container">
            <div class="item-block" routerLink="revision">
              <i class="fas fa-sync-alt"></i>
              <span>Revision of SOP</span>
            </div>   
            <div class="item-block" routerLink="receive">
              <i class="fas fa-file-import"></i>
              <span>Receive Hard Copies</span>
            </div>       
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
