<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Unit Formula</h3>
        </div>
        <div routerLink="/master" class="name-board1"><i class="fas fa-times"></i>
      </div>

      <div class="master-block" style="margin: 0px 10px 10px 10px !important;">
        <div class="section">
          <div class="line-container">
            <div class="heading">
              <h3>Unit Formula Section</h3>
            </div>
          </div>
          <!-- Main-dashboard -->
          <div class="card-block" style="    
          display: grid;
          grid-template-columns: repeat(6, 150px);
          grid-gap: 35px;
          overflow-x: auto;
          max-width: 100%;">
            <div class="icon-container" routerLink="log">
              <i class="fas fa-book"></i> 
              <span>Master Formula</span>
            </div>
            
            <div class="icon-container" routerLink="checking" *ngIf="ischecker == 'Yes'">
              <i class="fas fa-check-circle"></i> 
              <span>Formula for Checking</span>
            </div>

            <div class="icon-container" routerLink="approval" *ngIf="isapprover == 'Yes'">
              <i class="fas fa-check"></i> <!-- Changed the icon to a checkmark -->
              <span>Formula for Approval</span>
            </div>      
          </div>
        </div>
      </div>
    </div>
  </div>
</div>