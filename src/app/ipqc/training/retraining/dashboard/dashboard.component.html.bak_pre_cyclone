<div class="module">
  <div class="subdiv">
    <div class="purchase-container" >
      <div style="text-align:end" class="close-block">
        <div class="heading-container" style="margin:10px 0px">
          <h3>Retraining</h3>
        </div>
        <div routerLink="/ipqc/training/" class="name-board1"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="master-block" style="margin: 0px 10px 10px 10px !important;">
        <div class="section">
          <div class="line-container">
            <div class="heading">
              <h3>Retraining</h3>
            </div>
          </div>
          <!-- Main-dashboard -->
          <div class="card-block">
            <div class="item-block" routerLink="awaiting">
              <i class="fas fa-chalkboard-teacher"></i>
              <span>Awaiting</span>
            </div>
            
            <div class="item-block" routerLink="approval" *ngIf="ischecker || isapprover">
              <i class="fas fa-user-check"></i>
              <span>Retrain for Approval</span>
            </div>
            
            <div class="item-block" routerLink="log">
              <i class="fas fa-book"></i>
              <span>Retraining Log</span>
            </div>
            
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
  