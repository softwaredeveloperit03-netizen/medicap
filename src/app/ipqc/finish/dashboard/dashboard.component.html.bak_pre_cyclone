  <div class="module">
    <div class="subdiv">
      <div class="purchase-container" >
        <div style="text-align:end" class="close-block">
          <div class="heading-container" style="margin:10px 0px">
            <h3>Finish Product Testing</h3>
          </div>
          <div routerLink="/ipqc" class="name-board1"><i class="fas fa-times"></i>
          </div>
        </div>
  
        <div class="master-block" style="margin: 0px 10px 10px 10px !important;">
          <div class="section">
            <div class="line-container">
              <div class="heading">
                <h3>Training Section</h3>
              </div>
            </div>
            <!-- Main-dashboard -->
            <div class="card-block">
              <div class="item-block" routerLink="awaiting">
                <i class="fas fa-clock"></i>
                <span>Awaiting Testing</span>
              </div>
              
              <div class="item-block" routerLink="checking" *ngIf="ischecker == 'Yes'">
                <i class="fas fa-file-alt"></i>
                <span>Test Report Checking</span>
              </div>
              
              <div class="item-block" routerLink="ar">
                <i class="fas fa-file-alt"></i>
                <span>A. R. Report</span>
              </div>
              
              <div class="item-block" routerLink="coa">
                <i class="fas fa-file-alt"></i>
                <span>COA Report</span>
              </div>
              
            </div>
          </div>
        </div>
      </div>
    </div>