 

<!-- ============================================ -->

<!-- IPQC DepartMent Start-->
<div class="module">
  <div class="subdiv">
    <div class="purchase-container">
      <div style="text-align:end" class="close-block">
        <div class="heading-container" style="margin:10px 0px">
          <h3>IPQC</h3>
          <div routerLink="/" class="name-board1">
            <i class="fas fa-times"></i>
          </div>
        </div>
      </div>

      <div class="header-block" style="margin:10px 0px" style="margin:0px;flex-wrap: wrap;justify-content: center;">
        <button class="btn btn-sm btn-success" routerLink="/qa/qms">QMS</button>
        <button *ngIf="trainig_cordinator=='Yes'" class="btn btn-sm btn-success" routerLink="/training">Training</button>
        <button class="btn btn-sm btn-success" routerLink="/hrfordepthead" *ngIf="dept_head=='Yes'">Dept Head</button>
        <!-- <button class="btn btn-sm btn-success" routerLink="/qms/maintenance">Maintenance</button> -->
        <button class="btn btn-sm btn-success" routerLink="/breakdown">Breakdown</button>

      </div>
    </div>

    <div class="master-block">
      <div class="section">
        <div class="line-container">
          <div class="heading">
            <h3>IPQC Department Section</h3>
          </div>
        </div>
        <div class="card-block" style="    
        display: grid;
        grid-template-columns: repeat(6, 150px);
        grid-gap: 35px;
        overflow-x: auto;
        max-width: 100%;" *ngIf="plant_id!='67'">

          <div class="item-block" routerLink="inprocess">
            <i class="fas fa-cog"></i>
            <span>Product Inprocess</span>
          </div>

          <div class="item-block" routerLink="cleaning" *ngIf="isuser == 'Yes'">
            <i class="fas fa-broom"></i>
            <span>Cleaning Inprocess</span>
          </div>

          <div class="item-block" routerLink="etp">
            <i class="fas fa-filter"></i>
            <span>ETP Water Inproc</span>
          </div>

          <div class="item-block" routerLink="finish">
            <i class="fas fa-flask"></i>
            <span>Finish Prod Testing</span>
          </div>

          <!-- <div class="item-block" routerLink="qms">
            <i class="fas fa-book"></i>
            <span>QMS</span>
          </div> -->

          <div class="item-block" routerLink="training">
            <i class="fas fa-chalkboard-teacher"></i>
            <span>Training</span>
          </div>

        </div>
        <div class="card-block" style="    
        display: grid;
        grid-template-columns: repeat(6, 150px);
        grid-gap: 35px;
        overflow-x: auto;
        max-width: 100%;" *ngIf="plant_id=='67' || plant_id=='86'">

          <div class="item-block" routerLink="/qc/sampling-erp/raw/intimation">
            <i class="fas fa-envelope"></i>
            <span>INTIMATION RECEIVING</span>
          </div>

          <div class="item-block" routerLink="/qc/sampling-erp/raw/sp_check"
            *ngIf="ischecker=='Yes' || isapprover=='Yes'">
            <i class="fas fa-search"></i>
            <span>Sample Checking</span>
          </div>

          <div class="item-block" routerLink="/qc/sampling-erp/raw/sp_approve" *ngIf="isapprover=='Yes'">
            <i class="fas fa-thumbs-up"></i>
            <span>Sample Approved</span>
          </div>

          <div class="item-block" routerLink="FGTesting">
            <i class="fas fa-file-alt"></i>
            <span>FG COA</span>
          </div>

        </div>

        <div style="    
        display: grid;
        grid-template-columns: repeat(6, 150px);
        grid-gap: 35px;
        overflow-x: auto;
        max-width: 100%;" *ngIf="plant_id=='67' || plant_id=='86'">

          <div class="item-block" routerLink="labelapproval">
            <i class="fas fa-tags"></i>
            <span>Label Approval</span>
          </div>
        </div>
      </div>


 


    </div>
  </div>
</div>
<!-- IPQC DepartMent End-->