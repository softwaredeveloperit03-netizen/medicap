.land-featurearea {
  background: #1fb6ff none repeat scroll 0 0;
  color: #fff;
  float: left;
  height: 100vh;
  position: relative;
  text-align: center;
  vertical-align: middle;
  width: 100%;
}
.land-meta {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
}

.land-meta > h1 {
  font-family: hobo std;
  color: #fff;
}
.land-meta > p {
  color: #fff;
  letter-spacing: 0.5px;
}
.login-reg-bg {
  background: #f4f7f6 none repeat scroll 0 0;
  float: left;
  width: 100%;
}
.log-reg-area {
  background: #fff none repeat scroll 0 0;
  box-shadow: 0 0 35px #e2e2e2;
  display: block;
  float: none;
  left: 50%;
  padding: 35px 55px;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 505px;
}
/* ==================== */
.subdiv {
  background: antiquewhite;
  border-radius: 20px;
}

.heading-container {
  text-align: center;
  display: flex;
  margin: 0 auto;
  align-items: center;
}

.heading-container h3{
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 10px 0px 0px 0px;
  font-weight: 700;
  border: 1px solid blue;
  border-radius: 5px;
  padding: 3px;
  background: #31318b78;
  color: white;
  font-size: 17px;
}

.module {
  width: 100%;
  max-height: 100%;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 10px;
}

.close-block {
  display: flex;
  position: relative;
  justify-content: center;
}
.name-board1 {
  font-size: 24px;
  cursor: pointer;
  border-radius: 3px;
  z-index: 1;
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  background: red;
  width: 25px;
  padding: 3px;
  min-width: 29px;
  height: 30px;
  position: absolute;
  top: 0;
  right: 0;
}

/* Master DashBoard Design Start*/
.master-block {
  background: #abbedf;
  border-radius: 10px;
  margin: 10px 10px 10px 10px;
}

/* Line With the heading */
.line-container {
  display: flex;
  align-items: center;
}

.line-div {
  flex-grow: 1;
  height: 1px;
  background-color: green;
}

.heading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 2px 5px;
  background: aliceblue;
  font-weight: 800;
  border-bottom-right-radius: 10px;
  border-top: 2px solid #007bff;
}

.heading h3{
  margin: 0px;
  padding: 2px 5px;
  font-size: 15px;
  font-weight: 700;
}

/* Line With the heading */
.line-container,
.card-block {
  display: flex;
}
.card-block {
  overflow: auto;
}
.icon-container {
  width: 140px;
  height: 70px;
  background-color: #f0f0f0;
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease-in-out;
  box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
  margin: 10px;
  border-bottom: 3px solid #007bff;
  min-width: 140px;
  min-height: 70px;
}

.icon-container:hover {
  transform: scale(1.05);
  box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
  cursor: pointer;
}

.icon-container i {
  font-size: 1.2em;
  color: #007bff;
}

.icon-container span {
  font-size: 0.9em;
  margin-top: 2px;
  color: black;
  font-weight: 500;
}

/* Graph Section Start*/
.graph-container {
  border: 2px solid #ccc;
  border-radius: 5px;
  padding: 10px;
  -webkit-border-radius: 5px;
  -moz-border-radius: 5px;
  -ms-border-radius: 5px;
  -o-border-radius: 5px;
}

.graph-row {
  display: flex;
  flex-wrap: wrap;
  column-gap: 10px;
  justify-content: center;
}

.graph-col {
  flex-basis: 45%;
  background: #fff;
  border-radius: 10px;
  margin-top: 10px;
}

/* For mobile view, set 100% width */
@media (max-width: 768px) {
  .graph-col {
    flex-basis: 100%;
  }
}

/* Graph Section End*/
