<div class="component qc-legacy-dash">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Calibrations</h3>
          <div routerLink="/qc" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Calibrations Section</h3>
              </div>
            </div>
            <!-- Main-dashboard -->
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">
              <div class="item-block" routerLink="calender">
                <i class="fas fa-calendar-alt"></i>
                <span>Calibration Calender</span>
              </div>
              
              <div class="item-block" routerLink="balance">
                <i class="fas fa-balance-scale"></i>
                <span>Balance Calibration</span>
              </div>
              
              <div class="item-block" routerLink="visible">
                <i class="fas fa-microscope"></i>
                <span>UV Visibl Spectromtr</span>
              </div>
              
              <div class="item-block" routerLink="bulk">
                <i class="fas fa-weight-hanging"></i>
                <span>Bulk Densitometer</span>
              </div>
              
              <div class="item-block" routerLink="electromagnate">
                <i class="fas fa-magnet"></i>
                <span>Electromagnate</span>
              </div>
              
              <div class="item-block" routerLink="spectrophoto">
                <i class="fas fa-camera"></i>
                <span>Spectrophoto Meter</span>
              </div>
              
              <div class="item-block" routerLink="conductivity">
                <i class="fas fa-wave-square"></i>
                <span>Conductivity Meter</span>
              </div>
              
              <div class="item-block" routerLink="meter">
                <i class="fas fa-flask"></i>
                <span>PH Meter Calibration</span>
              </div>
              
            </div>


          </div>
        </div>
      </div>
    </div>
  </div>
</div>