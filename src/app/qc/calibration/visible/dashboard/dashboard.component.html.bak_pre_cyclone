<div class="component qc-legacy-dash">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>UV Visible Spectrophotometer</h3>
          <div routerLink="/qc/calibration" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>UV Visible Spectrophotometer Section</h3>
              </div>
            </div>
            <!-- Main-dashboard -->
            <div class="block-container">
              <div class="item-block" routerLink="new">
                <i class="fas fa-plus-circle"></i>
                <span>New</span>
              </div>
              
              <div class="item-block" routerLink="checking" *ngIf="ischecker == 'Yes'">
                <i class="fas fa-check-circle"></i>
                <span>Checking</span>
              </div>
              
              <div class="item-block" routerLink="log">
                <i class="fas fa-book"></i>
                <span>Log</span>
              </div>
              
            </div>


          </div>
        </div>
      </div>
    </div>
  </div>
</div>