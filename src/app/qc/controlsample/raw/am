<div class="card"*ngIf="!isView">
    <div class="card-header" style="text-align: center">
        <div class="clr-row" style="margin-bottom: -10px;">
            <div class="clr-col-lg-4" style="color: aliceblue;margin-top: -2px;text-align: left;">Raw Material Control Sample Register</div>
            <div class="clr-col-lg-8" style="text-align: right;padding-right: 0px;margin-top: -7px;">
                <!-- <button class="btn btn-sm btn-success" routerLink="new">New Entry</button> -->
                <!-- <button class="btn btn-sm btn-success" routerLink="approval">Contral Sampple For Approval</button> -->
                <button class="btn btn-sm btn-danger" routerLink="/qa/controlsample">CLOSE</button>
            </div>
        </div>
    </div>
    <div class="card-block">
        <div class="card-text">
            <div class="clr-row">
                <div class="clr-col-4">
                <label>Material Type:</label>
                <select name="material_type" [(ngModel)]="material_type" required>
                    <option></option>
                    <option value="API">API</option>
                    <option value="Excipient">Excipient</option>
                    <option value="Liquid">Liquid</option>
                </select>
                </div>
                <div class="clr-col-3">
                <label>From Date:</label>
                <input type="date" name="from_date" [(ngModel)]="from_date" required>
                </div>
                <div class="clr-col-3">
                <label>To Date:</label>
                <input type="date" name="to_date" [(ngModel)]="to_date" required>
                </div>
                <div class="clr-col-1">
                <button class="btn btn-danger" (click)="getRawControlSamples()" style="margin-top: 30px;">SEARCH</button>
                </div>
            </div>
            <table class="table">
                <tr>
                <th>Sr.</th>
                <th style="text-align: left;">Material type</th>
                <th style="text-align: left;">Material Name</th>
                <th style="text-align: left;">Material Code</th>
                <th>AR No</th>
                <th>Sampling No</th>
                <th>Action</th>
                </tr>
                <tr *ngFor="let result of results; let i = index">
                <td>{{ i + 1 }}.</td>
                <td style="text-align: left;">{{ result.material_name }}</td>
                <td style="text-align: left;">{{ result.material_subtype }}</td>
                <td style="text-align: left;">{{ result.material_code }}</td>
                <td>{{ result.ar_no }}</td>
                <td>{{ result.ar_no }}</td>
                <td><button class="btn btn-sm btn-info"(click)="view(i)">View</button></td>
                </tr>
                <tr *ngIf="results?.length == 0">
                <td colspan="12">No Records Found!</td>
                </tr>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <button class="btn btn-primary" (click)="download()">DOWNLOAD REPORT</button>
    </div>
</div>







<div class="card" *ngIf="isView">
    <div class="card-header" style="text-align: center">
        <div class="clr-row" style="margin-bottom: -10px;">
            <div class="clr-col-lg-4" style="color: aliceblue;margin-top: -2px;text-align: left;">Raw Material Control Sample Log</div>
            <div class="clr-col-lg-8" style="text-align: right;padding-right: 0px;margin-top: -7px;">
                <button class="btn btn-sm btn-danger" (click)="isView=false">CLOSE</button>
            </div>
        </div>
    </div>
    <div class="card-block">
        <div class="card-text">
            <table class="table">
                <tr>
                    <td style="text-align: left;"><b>Material Name:</b></td>
                    <td style="text-align: left;">{{selectedResult['material_name']}}</td>
                    <td style="text-align: left;"><b>Material Type</b></td>
                    <td style="text-align: left;">{{selectedResult['material_subtype']}}</td>
                </tr>
                <tr>
                    <td style="text-align: left;"><b>Material Code:</b></td>
                    <td style="text-align: left;">{{selectedResult['material_code']}}</td>
                    <td style="text-align: left;"><b>Batch No:</b></td>
                    <td style="text-align: left;">{{selectedResult['batch_no']}}</td>
                </tr>
                <tr>
                    <td style="text-align: left;"><b>Grade:</b></td>
                    <td style="text-align: left;">{{selectedResult['grade']}}</td>
                    <td style="text-align: left;"><b>A.R. No:</b></td>
                    <td style="text-align: left;">{{selectedResult['ar_no']}}</td>
                </tr>
                <tr>
                    <td style="text-align: left;"><b>Mfg Date:</b></td>
                    <td style="text-align: left;">{{selectedResult['mfg_date']}}</td>
                    <td style="text-align: left;"><b>Exp Date:</b></td>
                    <td style="text-align: left;">{{selectedResult['exp_date']}}</td>
                </tr>
                <tr>
                    <td style="text-align: left;"><b>Stored Qty:</b></td>
                    <td style="text-align: left;">{{selectedResult['sample_quantity']}} {{selectedResult['unit']}}</td>
                    <td style="text-align: left;"><b>Available Qty:</b></td>
                    <td style="text-align: left;">{{selectedResult['avl_qty']}}</td>
                </tr>
                <tr>
                    <td style="text-align: left;"><b>Withdrawal Qty:</b></td>
                    <td style="text-align: left;">{{selectedResult['withdrawal_qty']}} </td>
                    <td style="text-align: left;"><b>Room Temperature(℃):</b></td>
                    <td style="text-align: left;">{{selectedResult['room_temp']}} </td>
                </tr>
                <tr>
                    <td style="text-align: left;"><b>Sampling BY</b></td>
                    <td style="text-align: left;">{{selectedResult['sample_by']}} </td>
                    <td style="text-align: left;"><b>Humidity (% RH):</b></td>
                    <td style="text-align: left;">{{selectedResult['humidity']}}</td>
                </tr>
             
                <tr>
                    <td style="text-align: left;"><b>Rack No</b></td>
                    <td style="text-align: left;">{{selectedResult['rack_no']}} </td>
                    <td style="text-align: left;"><b>Material Subtype:</b></td>
                    <td style="text-align: left;">{{selectedResult['material_subtype']}}</td>
                </tr>

            </table>
        </div>
    </div>
    <div class="card-footer">
        <button class="btn btn-primary" (click)="isView=false">close</button>
    </div>
</div>