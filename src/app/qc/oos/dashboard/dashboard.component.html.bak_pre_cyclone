<div class="component qc-legacy-dash">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Preperation of Cleaning Solution</h3>
          <div routerLink="/qc" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Preperation of Cleaning Solution Section</h3>
              </div>
            </div>
            <!-- Main-dashboard -->
            <div class="block-container">
              <div class="item-block" routerLink="primary" *ngIf="ischecker == 'Yes'">
                <i class="fas fa-check-circle"></i>
                <span>Primary Checking</span>
              </div>
              
              <div class="item-block" routerLink="secondary" *ngIf="ischecker == 'Yes'">
                <i class="fas fa-check-double"></i>
                <span>Secondary Checking</span>
              </div>
              
              <div class="item-block" routerLink="approval" *ngIf="isapprover == 'Yes'">
                <i class="fas fa-thumbs-up"></i>
                <span>Approval</span>
              </div>
              

            </div>


          </div>
        </div>
      </div>
    </div>
  </div>
</div>