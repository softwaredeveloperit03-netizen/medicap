<div class="component qc-legacy-dash">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Reagent</h3>
          <div routerLink="/qc" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>

        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Reagent Section</h3>
              </div>
            </div>
            <!-- Main-dashboard -->
            <div class="block-container">
              <div class="item-block" routerLink="challan_reagent">
                <i class="fas fa-clipboard"></i>
                <span>Challan Entry</span>
              </div>
              
              <div class="item-block" routerLink="receiving">
                <i class="fas fa-truck"></i>
                <span>Receiving of Reagents</span>
              </div>
              
              <div class="item-block" routerLink="weighing">
                <i class="fas fa-balance-scale"></i>
                <span>Weighing of Reagents</span>
              </div>
              
              <div class="item-block" routerLink="grn">
                <i class="fas fa-check-double"></i>
                <span>GRN</span>
              </div>
              
              <div class="item-block" routerLink="stock">
                <i class="fas fa-book"></i>
                <span>Stock Book</span>
              </div>
              

            </div>

            <div class="block-container">
              <!-- Graph Section -->
              <div class="graph-container" style="width:100%">
                <div style="text-align:end" class="close-block">
                  <div class="main-heading-container">
                    <h3>Analytical Avenue</h3>
                  </div>
                </div>
                <div class="graph-block">
                  <div class="graph-row">
                    <div class="graph-col">
                      <!-- <h5><b> Monthly purchase Chart</b></h5> -->
                      <div class="line-container">
                        <div class="heading">
                          <h3>Material Wise Monthly purchase Chart</h3>
                        </div>
                      </div>
                      <canvas id="MaterialWiseMonthlyChart">{{ rawMaterialmonthly }} </canvas>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- Graph Section -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>