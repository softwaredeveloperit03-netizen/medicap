<div class="card">
    <div class="card-header" style="text-align: center">
      <div class="clr-row" style="margin-bottom: -10px;">
        <div class="clr-col-lg-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Standard's Stock Book</div>
        <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
          <button class="btn btn-sm btn-danger" routerLink="/qc/standard"> {{'common.close' | translate}} </button>
        </div>
      </div>
    </div>
    <div class="card-block">
      <div class="card-text">
        <div class="clr-row">
          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
            <div class="card clickable" routerLink="quarantine" style="background-color: blue; border-color: blue; color: white;">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text" style="color: white;"><b>Reference Standard Stock</b></p>
              </div>
            </div>
          </div>
          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
            <div class="card clickable" routerLink="working" style="background-color: yellow; border-color: yellow; color: black">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text" style="color: black"><b>Working Standard Stock</b></p>
              </div>
            </div>
          </div>

          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
            <div class="card clickable" routerLink="approved" style="background-color: green; border-color: green;">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text" style="color: white;"><b>Primary Standard Stock</b></p>
              </div>
            </div>
          </div>
          <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
            <div class="card clickable" routerLink="expired" style="background-color: red; border-color: red;">
              <div class="card-block" style="text-align: center">
                <img width="50px" height="50px" src="assets/log.png">
                <p class="card-text" style="color: white;"><b>Expired Standards</b></p>
              </div>
            </div>
          </div>

        </div>
        <br>
        <div class="clr-row">
            <div class="clr-col-lg-3 clr-col-md-3 clr-col-sm-12 clr-col-xs-12">
            <label>Standard Type:</label>
            <select name="material_type" [(ngModel)]="material_type" required>
              <option></option>
              <option>Referance Standard</option>
              <option>Working Standard</option>
              <option>Primary Standard</option>
             
            </select>
          </div>
          <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12">
            <label>Grade:</label>
            <select name="grade" [(ngModel)]="grade" required>
              <option>IP</option>
              <option>BP</option>
              <option>UsP</option>
              <option>Ph.Eur</option>
              <option>CP</option>
              <option>JP</option>
              <option>IHS</option>
            </select>
          </div>
          <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12">
            <label>Standard Name:</label>
            <input type="text" name="standard_name" [(ngModel)]="standard_name" required>
          </div>
         
          <div class="clr-col-lg-2 clr-col-md-2 clr-col-sm-12 clr-col-xs-12" style="margin-top: 30px;">
            <button class="btn btn-danger" (click)="getAllStock()">{{'common.search' | translate}}</button>
          </div>
        </div>


        <table class="table table-border">
          <tr>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">{{'common.table.srNo' | translate}}</th>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">Standard Name</th>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">Standard Code</th>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">Date Of Entry</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Grade</th>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">Batch No.</th>
            <th style="text-align: right; background-color: rgb(14, 67, 112); color: white">Available Qty</th>
            <!-- <th style="background-color: rgb(14, 67, 112); color: white;">View Cerificate</th> -->
            <th style="background-color: rgb(14, 67, 112); color: white;">{{'common.table.action' | translate}}</th>
          </tr>
      
          <tr *ngFor="let stock of stocks; let i = index">
            <td style="text-align: left;">{{ i+1 }}.</td>
            <td style="text-align: left;">{{ stock.s_title }}</td>
            <td style="text-align: left;">{{ stock.s_identifier }}</td>
            <td style="text-align: left;">{{ stock.record_date }}</td>
            <td style="text-align: left;">{{ stock.grade }}</td>
            <td style="text-align: left;">{{ stock.batch_no }}</td>
            <td style="text-align: right;">{{ stock.available_qty }} </td>
           
            <!-- <td>
                <button class="btn btn-sm btn-info">{{'common.view' | translate}}</button>
            </td> -->
            <td>
                <button class="btn btn-sm btn-info"(click)="view(i)">{{'common.view' | translate}}</button>
            </td>
          </tr>
          <tr *ngIf="stocks?.length == 0">
            <td colspan="10">{{'common.noRecords' | translate}}</td>
          </tr>
        </table>
