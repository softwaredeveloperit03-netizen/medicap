<div class="card" *ngIf="isView">
  <div class="card-header">Standard's Stock Log</div>
  <div class="card-block">
    <div class="card-text">
      <table class="table table-border">
        <tr>
          <td style="text-align: left;"><b>Standard Name:</b></td>
          <td style="text-align: left; width: 330px;" >{{ selectedReport['s_title'] }}</td>
          <td style="text-align: left;"><b>Standard Identifier Number/Code:</b></td>
          <td style="text-align: left; width: 330px;">{{ selectedReport['s_identifier'] }}</td>
        </tr>
       
        <tr>
          <td style="text-align: left;"><b>Grade.:</b></td>
          <td style="text-align: left;">{{ selectedReport['grade'] }}</td>
          <td style="text-align: left;"><b>Batch No:</b></td>
          <td style="text-align: left;">{{ selectedReport['batch_no'] }}</td>
        </tr>
        <tr >
          <td style="text-align: left;"><b>Record Keeping Details:</b></td>
          <td style="text-align: left;">{{ selectedReport['record_details'] }}</td>
          <td style="text-align: left;"><b>Date Of Entry:</b></td>
          <td  style="text-align: left;">{{ selectedReport['record_date'] | date: 'dd-MM-yyyy'}}</td>
        </tr>
        <tr >
          <td style="text-align: left;"><b>Received Qty.:</b></td>
          <td style="text-align: left;">{{ selectedReport['received_qty'] }}</td>
          <td style="text-align: left;"><b>Available Qty.:</b></td>
          <td  style="text-align: left;">{{ selectedReport['available_qty'] }}</td>
        </tr>
        <tr>
          <td style="text-align: left;"><b>UOM:</b></td>
          <td style="text-align: left;">{{ selectedReport['umo'] }}</td>
          <td style="text-align: left;"><b>Storage Location:</b></td>
          <td style="text-align: left;">{{ selectedReport['storage_location'] }}</td>
        </tr>
        <tr>
          <td style="text-align: left;"><b>Prepared By:</b></td>
          <td style="text-align: left;">{{ selectedReport['prepared_by'] }}</td>
          <td style="text-align: left;"><b>Prepared Date:</b></td>
          <td style="text-align: left;">{{ selectedReport['prepared_date'] }}  </td>
        </tr>
        <tr>
          <td style="text-align: left;"><b>Review By:</b></td>
          <td style="text-align: left;">{{ selectedReport['review_by'] }}</td>
          <td style="text-align: left;"><b>Review Date:</b></td>
          <td style="text-align: left;">{{ selectedReport['review_date'] }} </td>
        </tr>
        <button class="btn btn-primary" (click)="download()">DOWNLOAD PDF</button>

        <button class="btn btn-secondary" style="background-color: red;" (click)="CLOSEView()">{{'common.close' | translate}}</button>

      </table>
    </div>
  </div>
</div>
      </div>
    </div>
    <!-- <div class="card-footer">
      <button class="btn btn-primary" (click)="download()">DOWNLOAD PDF</button>
    </div> -->
</div>