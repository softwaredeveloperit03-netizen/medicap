    { name: 'Light', background: '#f8fafc', cardShadow: '0 8px 24px rgba(15, 23, 42, 0.06)' },
    { name: 'Cool gray', background: 'linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%)', cardShadow: '0 8px 24px rgba(51, 65, 85, 0.1)' },
    { name: 'Warm white', background: 'linear-gradient(180deg, #fffdfb 0%, #f8fafc 100%)', cardShadow: '0 8px 24px rgba(180, 83, 9, 0.08)' },
  ];
  selectedPalette = this.paletteOptions[0];

  constructor(private service: DataAccessService) {
    this.software_type = this.service.getPlantConfigFields('software_type');
  }

  @HostListener('window:resize')
  onResize(): void {
    if (this.windowWidth() >= this.sidebarBreakpointPx) {
      this.mobileSidebarOpen = false;
    }
  }

  private windowWidth(): number {
    return typeof window !== 'undefined' ? window.innerWidth : this.sidebarBreakpointPx;
  }

  get isNarrowViewport(): boolean {
    return this.windowWidth() < this.sidebarBreakpointPx;
  }

  get currentCategory(): QcCategory | undefined {
    return this.categories.find((category) => category.id === this.selectedCategoryId);
  }

  private isCardVisible(card: DeptCard): boolean {
    return !(card.id === 'water' && this.software_type === 'Nutraceutical');
  }

  private cardsForCategory(categoryId: string): DeptCard[] {
    const category = this.categories.find((item) => item.id === categoryId);
    if (!category) {
      return [];
    }
    return this.qcCards.filter((card) => this.isCardVisible(card) && card.category === category.sourceCategory);
  }

  countForCategory(categoryId: string): number {
    return this.cardsForCategory(categoryId).length;
  }

  selectCategory(categoryId: string): void {
    this.selectedCategoryId = categoryId;
    if (this.isNarrowViewport) {
      this.mobileSidebarOpen = false;
    }
    try {
      localStorage.setItem('qc_dashboard_category', categoryId);
    } catch {
      // Ignore storage errors.
    }
  }

  toggleMobileSidebar(): void {
    this.mobileSidebarOpen = !this.mobileSidebarOpen;
  }

  closeMobileSidebar(): void {
    this.mobileSidebarOpen = false;
  }

  get filteredCards(): DeptCard[] {
    const q = (this.searchQuery || '').trim().toLowerCase();
    return this.cardsForCategory(this.selectedCategoryId).filter((card) => {
      return (
        !q ||
        card.title.toLowerCase().includes(q) ||
        (card.description && card.description.toLowerCase().includes(q)) ||
        card.category.toLowerCase().includes(q)
      );
    });
  }

  ngOnInit(): void {
    const savedPalette = localStorage.getItem('qc_dashboard_palette_master_style');
    if (savedPalette) {
      const found = this.paletteOptions.find((palette) => palette.name === savedPalette);
      if (found) {
        this.selectedPalette = found;
      }
    }

    try {
      const savedCategory = localStorage.getItem('qc_dashboard_category');
      if (savedCategory && this.categories.some((category) => category.id === savedCategory)) {
        this.selectedCategoryId = savedCategory;
      }
    } catch {
      // Ignore storage errors.
    }
  }

  trackByCardId(_index: number, card: DeptCard): string {
    return card.id;
  }

  trackByCategoryId(_index: number, category: QcCategory): string {
    return category.id;
  }

  togglePalette(): void {
    this.showPalette = !this.showPalette;
  }

  setPalette(palette: { name: string; background: string; cardShadow: string }): void {
    this.selectedPalette = palette;
    this.showPalette = false;
    try {
      localStorage.setItem('qc_dashboard_palette_master_style', palette.name);
    } catch {
      // Ignore storage errors.
    }
  }
}
