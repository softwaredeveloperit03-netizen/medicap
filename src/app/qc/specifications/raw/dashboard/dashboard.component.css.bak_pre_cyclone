/* QC Specifications (Raw & Pack) — classic header, aligned, responsive */
:host {
  display: block !important;
  width: 100% !important;
  max-width: 100% !important;
}

:host .qcspec {
  --h1: #0e7490;
  --h2: #0f766e;
  --text: #0f172a;
  --muted: #64748b;
  --border: #dbe3ea;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  min-height: calc(100vh - 48px);
  padding: 14px 16px 36px;
  background: #e8f4f2;
  color: var(--text);
}

:host .qcspec *,
:host .qcspec *::before,
:host .qcspec *::after {
  box-sizing: border-box;
}

:host .qcspec__layout {
  display: grid !important;
  grid-template-columns: 200px minmax(0, 1fr) !important;
  gap: 14px !important;
  width: 100% !important;
  align-items: start !important;
}

/* ----- Sidebar ----- */
:host .qcspec__side {
  background: #fff !important;
  border: 1px solid var(--border) !important;
  border-radius: 10px !important;
  padding: 10px !important;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
  position: sticky;
  top: 12px;
}

:host .qcspec__side-head {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 8px !important;
  margin-bottom: 8px !important;
  padding: 2px 4px 8px !important;
  border-bottom: 1px solid #eef2f7 !important;
}

:host .qcspec__side-title {
  font-size: 0.78rem !important;
  font-weight: 700 !important;
  color: var(--text) !important;
}

:host .qcspec__side-count {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-width: 22px;
  height: 20px;
  padding: 0 6px;
  border-radius: 999px;
  background: #ccfbf1;
  color: #0f766e;
  font-size: 0.7rem;
  font-weight: 700;
}

:host .qcspec__side-nav {
  display: flex !important;
  flex-direction: column !important;
  gap: 6px !important;
}

:host .qcspec__nav-btn {
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
  width: 100% !important;
  margin: 0 !important;
  padding: 8px 10px !important;
  border: 1px solid #e5e7eb !important;
  border-radius: 8px !important;
  background: #fff !important;
  color: var(--text) !important;
  font-size: 0.78rem !important;
  font-weight: 650 !important;
  cursor: pointer;
  text-align: left;
}

:host .qcspec__nav-btn i {
  color: #64748b;
  width: 14px;
  text-align: center;
}

:host .qcspec__nav-btn--on,
:host .qcspec__nav-btn:hover {
  background: linear-gradient(135deg, #0f766e 0%, #0e7490 100%) !important;
  border-color: transparent !important;
  color: #fff !important;
}

:host .qcspec__nav-btn--on i,
:host .qcspec__nav-btn:hover i {
  color: #fff !important;
}

/* ----- Main panel ----- */
:host .qcspec__main {
  min-width: 0 !important;
}

:host .qcspec__panel {
  overflow: hidden !important;
  background: #fff !important;
  border: 1px solid var(--border) !important;
  border-radius: 10px !important;
  box-shadow: 0 4px 14px rgba(15, 118, 110, 0.1);
}

:host .qcspec__header {
  display: flex !important;
  flex-wrap: wrap !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 10px 14px !important;
  width: 100% !important;
  padding: 12px 16px !important;
  background: linear-gradient(135deg, var(--h1) 0%, var(--h2) 55%, #115e59 100%) !important;
  border-bottom: 2px solid #134e4a !important;
}

:host .qcspec__title {
  margin: 0 !important;
  font-size: 1.15rem !important;
  font-weight: 700 !important;
  line-height: 1.25 !important;
  color: #fff !important;
  letter-spacing: 0.02em;
  text-shadow: 0 1px 1px rgba(0, 0, 0, 0.15);
}

:host .qcspec__close {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 6px !important;
  margin-left: auto !important;
  flex-shrink: 0 !important;
  min-height: 32px !important;
  padding: 0 14px !important;
  border-radius: 6px !important;
  background: #dc2626 !important;
  color: #fff !important;
  font-size: 0.78rem !important;
  font-weight: 700 !important;
  text-decoration: none !important;
  white-space: nowrap !important;
}

:host .qcspec__close:hover {
  background: #b91c1c !important;
  color: #fff !important;
  text-decoration: none !important;
}

:host .qcspec__body {
  display: flex !important;
  flex-direction: column !important;
  gap: 12px !important;
  padding: 14px 16px 18px !important;
  background: #f8fafc !important;
}

/* Toolbar: search + docs in one aligned row */
:host .qcspec__toolbar {
  display: flex !important;
  flex-wrap: wrap !important;
  align-items: center !important;
  gap: 10px !important;
  width: 100% !important;
}

:host .qcspec__search {
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
  flex: 1 1 220px !important;
  min-width: 180px !important;
  max-width: 340px !important;
  height: 36px !important;
  padding: 0 12px !important;
  margin: 0 !important;
  background: #fff !important;
  border: 1px solid #cbd5e1 !important;
  border-radius: 8px !important;
}

:host .qcspec__search i {
  color: #94a3b8;
  font-size: 13px;
}

:host .qcspec__search input {
  width: 100% !important;
  min-width: 0 !important;
  border: 0 !important;
  outline: none !important;
  background: transparent !important;
  font-size: 13px !important;
  color: var(--text) !important;
}

:host .qcspec__docs {
  display: flex !important;
  align-items: center !important;
  flex-wrap: wrap !important;
  gap: 8px !important;
  min-width: 0 !important;
}

:host .qcspec__docs ::ng-deep .docs-icons-bar {
  display: flex !important;
  flex-wrap: wrap !important;
  align-items: center !important;
  gap: 8px !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* Quick links — wrapping row with real gaps */
:host .qcspec__links {
  display: flex !important;
  flex-wrap: wrap !important;
  align-items: center !important;
  gap: 8px !important;
  width: 100% !important;
}

:host .qcspec__link {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-height: 30px !important;
  padding: 4px 12px !important;
  border-radius: 6px !important;
  background: #0f766e !important;
  color: #fff !important;
  font-size: 12px !important;
  font-weight: 650 !important;
  text-decoration: none !important;
  white-space: nowrap !important;
}

:host .qcspec__link:hover {
  background: #115e59 !important;
  color: #fff !important;
}

:host .qcspec__section-head {
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
  margin-top: 2px !important;
  padding-top: 10px !important;
  border-top: 1px solid #e2e8f0 !important;
}

:host .qcspec__section-title {
  margin: 0 !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--muted) !important;
}

:host .qcspec__count {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-width: 22px;
  height: 20px;
  padding: 0 6px;
  border-radius: 999px;
  background: #ccfbf1;
  color: #0f766e;
  font-size: 11px;
  font-weight: 700;
}

/* Cards: 3 cols → 2 → 1; text wraps, no crush */
:host .qcspec__grid {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 12px !important;
  width: 100% !important;
}

:host .qcspec__tile {
  display: flex !important;
  align-items: flex-start !important;
  gap: 12px !important;
  min-width: 0 !important;
  min-height: 92px !important;
  padding: 14px !important;
  background: #fff !important;
  border: 1px solid #e2e8f0 !important;
  border-radius: 10px !important;
  text-decoration: none !important;
  color: var(--text) !important;
  box-shadow: 0 1px 4px rgba(15, 23, 42, 0.04);
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}

:host .qcspec__tile:hover {
  transform: translateY(-2px);
  border-color: #99f6e4 !important;
  box-shadow: 0 8px 18px rgba(15, 118, 110, 0.12);
  color: var(--text) !important;
  text-decoration: none !important;
}

:host .qcspec__icon {
  flex: 0 0 44px !important;
  width: 44px !important;
  height: 44px !important;
  display: grid !important;
  place-items: center !important;
  border-radius: 10px !important;
  color: #fff !important;
  font-size: 16px !important;
}

:host .qcspec__tile-text {
  display: flex !important;
  flex-direction: column !important;
  gap: 4px !important;
  min-width: 0 !important;
  flex: 1 1 auto !important;
}

:host .qcspec__tile-title {
  font-size: 0.88rem !important;
  font-weight: 700 !important;
  line-height: 1.3 !important;
  color: #0f172a !important;
  white-space: normal !important;
  overflow: visible !important;
  word-break: break-word;
}

:host .qcspec__tile-desc {
  font-size: 0.75rem !important;
  line-height: 1.4 !important;
  color: var(--muted) !important;
  white-space: normal !important;
}

:host .qcspec__empty {
  grid-column: 1 / -1 !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  gap: 8px !important;
  padding: 28px 12px !important;
  text-align: center !important;
  color: var(--muted) !important;
  background: #fff !important;
  border: 1px dashed #cbd5e1 !important;
  border-radius: 10px !important;
}

:host .qcspec__empty p {
  margin: 0 !important;
  font-size: 0.85rem !important;
}

@media (max-width: 1100px) {
  :host .qcspec__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }

  :host .qcspec__search {
    max-width: none !important;
  }
}

@media (max-width: 900px) {
  :host .qcspec__layout {
    grid-template-columns: 1fr !important;
  }

  :host .qcspec__side {
    position: static;
  }

  :host .qcspec__side-nav {
    flex-direction: row !important;
    flex-wrap: wrap !important;
  }

  :host .qcspec__nav-btn {
    width: auto !important;
    flex: 0 1 auto !important;
  }
}

@media (max-width: 640px) {
  :host .qcspec {
    padding: 10px !important;
  }

  :host .qcspec__grid {
    grid-template-columns: 1fr !important;
  }

  :host .qcspec__header {
    flex-direction: column !important;
    align-items: stretch !important;
  }

  :host .qcspec__close {
    margin-left: 0 !important;
    width: 100% !important;
  }

  :host .qcspec__search {
    flex: 1 1 100% !important;
  }

  :host .qcspec__link {
    flex: 1 1 calc(50% - 8px) !important;
  }
}
