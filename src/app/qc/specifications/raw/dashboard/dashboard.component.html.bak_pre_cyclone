<div class="qcspec">
  <div class="qcspec__layout">
    <aside class="qcspec__side">
      <div class="qcspec__side-head">
        <span class="qcspec__side-title">Specification Tabs</span>
        <span class="qcspec__side-count">{{ getFilteredCards().length }}</span>
      </div>
      <nav class="qcspec__side-nav" aria-label="Specification categories">
        <button
          *ngFor="let cat of getCategories()"
          type="button"
          class="qcspec__nav-btn"
          [class.qcspec__nav-btn--on]="cat === selectedCategory"
          (click)="selectedCategory = cat"
        >
          <i class="fas fa-layer-group" aria-hidden="true"></i>
          <span>{{ cat }}</span>
        </button>
      </nav>
    </aside>

    <div class="qcspec__main">
      <div class="qcspec__panel">
        <div class="qcspec__header">
          <h2 class="qcspec__title">{{ dashboardTitle }}</h2>
          <a class="qcspec__close" href="#" (click)="closeFromMasterHub(); $event.preventDefault()" aria-label="Close">
            <i class="fas fa-times" aria-hidden="true"></i>
            Close
          </a>
        </div>

        <div class="qcspec__body">
          <div class="qcspec__toolbar">
            <label class="qcspec__search">
              <i class="fas fa-search" aria-hidden="true"></i>
              <input
                type="text"
                [(ngModel)]="searchQuery"
                placeholder="Search by name or category"
                aria-label="Search modules"
              />
            </label>
            <div class="qcspec__docs">
              <app-floating-docs-popup></app-floating-docs-popup>
            </div>
          </div>

          <div class="qcspec__links">
            <a class="qcspec__link" routerLink="/calibration">Calibration</a>
            <a class="qcspec__link" routerLink="/training" *ngIf="trainig_cordinator==='Yes'">Training</a>
            <a class="qcspec__link" routerLink="/preventiveimain">PM Intimation</a>
            <a class="qcspec__link" routerLink="/hrfordepthead" *ngIf="dept_head==='Yes'">Dept Head</a>
            <a class="qcspec__link" routerLink="/indend/raw">Purchase Requisition</a>
            <a class="qcspec__link" routerLink="/qa/qms">QMS</a>
            <a class="qcspec__link" routerLink="/breakdown">Breakdown</a>
          </div>

          <div class="qcspec__section-head">
            <h3 class="qcspec__section-title">{{ sectionLabel }}</h3>
            <span class="qcspec__count">{{ getFilteredCards().length }}</span>
          </div>

          <div class="qcspec__grid">
            <a
              *ngFor="let card of getFilteredCards(); trackBy: trackByCardId"
              class="qcspec__tile"
              [routerLink]="card.route"
            >
              <span class="qcspec__icon" [style.background]="card.gradient">
                <i class="fas" [ngClass]="card.icon" aria-hidden="true"></i>
              </span>
              <span class="qcspec__tile-text">
                <span class="qcspec__tile-title">{{ card.title }}</span>
                <span class="qcspec__tile-desc" *ngIf="card.description">{{ card.description }}</span>
              </span>
            </a>

            <div class="qcspec__empty" *ngIf="getFilteredCards().length === 0">
              <i class="fas fa-search" aria-hidden="true"></i>
              <p>No modules match your search. Try another keyword or category.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
