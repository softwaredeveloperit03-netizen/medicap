              </div>
              
              <div class="item-block" routerLink="/master/specification/raw/checking/2" *ngIf="!(plant_id=== '67' || plant_id=== '72')">
                <i class="fas fa-eye"></i>
                <span>Secondary Review</span>
              </div>
              
              <div class="item-block" routerLink="/master/specification/raw/checking/3">
                <i class="fas fa-eye"></i>
                <span>QA Review</span>
              </div>
              
            </div>
          </div>
        </div>
      </div>
    </div>
