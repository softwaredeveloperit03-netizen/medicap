<div class="component qc-legacy-dash">
  <div class="subsection">
    <div class="purchase-block" >
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Specifications</h3>
        <div routerLink="/qc" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>Specifications Section</h3>
            </div>
          </div>
          <div class="block-container" style="    
          display: grid;
          grid-template-columns: repeat(6, 150px);
          grid-gap: 35px;
          overflow-x: auto;
          max-width: 100%;">

          <div class="item-block" routerLink="/master/specification/raw/log">
            <i class="fas fa-file-alt"></i>
            <span>New Specification</span>
          </div>

          <div class="item-block" routerLink="/qc/specifications/master/checklist">
            <i class="fas fa-clipboard-check"></i>
            <span>Checklist</span>
          </div>
          
          <div class="item-block" routerLink="/qc/specifications/checking" *ngIf="ischecker == 'Yes'">
            <i class="fas fa-search"></i>
            <span>Specif. Checking</span>
          </div>
          
          <div class="item-block" routerLink="/master/specification/raw/approval" *ngIf="isapprover == 'Yes'">
            <i class="fas fa-edit"></i>
            <span>Specif. For Apprpval</span>
          </div>
          
          <div class="item-block" routerLink="/master/specification/raw/log">
            <i class="fas fa-file-alt"></i>
            <span>RM Specification Log</span>
          </div>
          
          <div class="item-block" routerLink="/master/specification/raw/pm-report">
            <i class="fas fa-file-alt"></i>
            <span>PM Specification Log</span>
          </div>
          
          <div class="item-block" routerLink="/master/specification/raw/fgreport">
            <i class="fas fa-file-alt"></i>
            <span>FG Specif. Report</span>
          </div>
          
          <div class="item-block" routerLink="inprocess">
            <i class="fas fa-cogs"></i>
            <span>Inprocess</span>
          </div>
        
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
