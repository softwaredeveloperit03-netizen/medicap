<div class="dashboard-shell qc-sub-hub" [style.background]="selectedPalette.background">
  <ng-container *ngIf="getFilteredCards() as cards">
    <div class="compact-layout">
      <aside class="compact-sidebar">
        <div class="compact-sidebar__head">
          <span class="compact-sidebar__title">{{ 'qc.testing.modulesTitle' | translate }}</span>
          <span class="compact-sidebar__count">{{ cards.length }}</span>
        </div>
        <nav class="compact-sidebar__tabs" aria-label="Testing modules">
          <button
            type="button"
            class="compact-nav-item compact-nav-item--all compact-nav-item--menu"
            [class.active]="selectedCategory === 'All'"
            (click)="showAllTabs()"
          >
            <i class="fas fa-layer-group" aria-hidden="true"></i>
            <span>{{ 'common.allTabs' | translate }}</span>
          </button>

          <button
            *ngFor="let category of categorySidebarEntries"
            type="button"
            class="compact-nav-item compact-nav-item--menu"
            [class.active]="selectedCategory === category"
            (click)="selectCategory(category)"
          >
            <i class="fas fa-vials" aria-hidden="true"></i>
            <span>{{ category }}</span>
          </button>

          <a class="compact-nav-item" routerLink="/calibration" title="Calibration">
            <i class="fas fa-balance-scale" aria-hidden="true"></i>
            <span>{{ 'qc.links.calibration' | translate }}</span>
          </a>
          <a class="compact-nav-item" routerLink="/training" title="Training" *ngIf="trainig_cordinator==='Yes'">
            <i class="fas fa-user-graduate" aria-hidden="true"></i>
            <span>{{ 'qc.links.training' | translate }}</span>
          </a>
          <a class="compact-nav-item" routerLink="/preventiveimain" title="PM Intimation">
            <i class="fas fa-tools" aria-hidden="true"></i>
            <span>{{ 'qc.links.pmIntimation' | translate }}</span>
          </a>
          <a class="compact-nav-item" routerLink="/hrfordepthead" title="Dept Head" *ngIf="dept_head==='Yes'">
            <i class="fas fa-user-tie" aria-hidden="true"></i>
            <span>{{ 'qc.links.deptHead' | translate }}</span>
          </a>
          <a class="compact-nav-item" routerLink="/indend/raw" title="Purchase Requisition">
            <i class="fas fa-boxes" aria-hidden="true"></i>
            <span>{{ 'qc.links.indent' | translate }}</span>
          </a>
          <a class="compact-nav-item" routerLink="/qa/qms" title="QMS">
            <i class="fas fa-clipboard-check" aria-hidden="true"></i>
            <span>{{ 'qc.links.qms' | translate }}</span>
          </a>
          <a class="compact-nav-item" routerLink="/breakdown" title="Breakdown">
            <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
            <span>{{ 'qc.links.breakdown' | translate }}</span>
          </a>
        </nav>
      </aside>

      <div class="compact-main">
        <div class="dash-header dash-header--single-line">
          <div class="title-block">
            <h2>{{ dashboardTitle | translate }}</h2>
          </div>
          <div class="header-actions-row">
            <div class="search-box">
              <i class="fas fa-search"></i>
              <input
                type="text"
                [(ngModel)]="searchQuery"
                [placeholder]="'common.searchPlaceholder' | translate"
                aria-label="Search modules"
              />
            </div>
            <app-floating-docs-popup class="dash-header__docs"></app-floating-docs-popup>
            <a class="close-btn" [routerLink]="closeRouterLink" aria-label="Close">
              <i class="fas fa-times"></i>
              {{ 'common.close' | translate }}
            </a>
          </div>
        </div>

        <h3 class="section-label">{{ sectionLabel | translate }}</h3>
        <div class="tiles-grid">
          <a
            *ngFor="let card of cards; trackBy: trackByCardId"
            class="tile-card"
            [routerLink]="card.route"
            [ngStyle]="{'box-shadow': selectedPalette.cardShadow}"
          >
            <div class="icon-wrap" [style.background]="card.gradient">
              <i class="fas" [ngClass]="card.icon"></i>
            </div>
            <div class="tile-body">
              <div class="tile-header">
                <div class="tile-title">{{ card.title | translate }}</div>
                <div class="tile-desc" *ngIf="card.description">{{ card.description }}</div>
              </div>
            </div>
          </a>

          <div class="empty-state" *ngIf="cards.length === 0">
            <i class="fas fa-search"></i>
            <p>No modules match your search. Try another keyword or category.</p>
          </div>
        </div>
      </div>
    </div>
  </ng-container>

  <button class="palette-fab" type="button" (click)="togglePalette()" title="Change theme" aria-label="Change theme">
    <i class="fas fa-palette"></i>
  </button>

  <div class="palette-drawer" *ngIf="showPalette">
    <button
      *ngFor="let palette of paletteOptions"
      type="button"
      class="palette-chip"
      [class.active]="palette === selectedPalette"
      [style.background]="palette.swatch"
      [title]="palette.name"
      (click)="setPalette(palette)"
      [attr.aria-label]="'Theme ' + palette.name"
    >
      <span class="sr-only">{{ palette.name }}</span>
    </button>
  </div>
</div>
