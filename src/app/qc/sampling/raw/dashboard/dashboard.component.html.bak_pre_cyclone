
<div class="component hr-legacy-dash">
  <div class="subsection">
    <div class="purchase-block">
      <div class="exit-section">
        <div class="header-block">
          <div class="header-titles">
            <h3>{{ dashboardTitle }}</h3>
            <p class="header-subtitle">{{ dashboardSubtitle }}</p>
          </div>
          <div [routerLink]="closeRouterLink" class="name-board2">
            <i class="fas fa-times"></i>
          </div>
        </div>

        <div class="main-section">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>{{ sectionLabel }}</h3>
              </div>
            </div>
            <div class="block-container">
              <div
                *ngFor="let card of getFilteredCards(); trackBy: trackByCardId"
                class="item-block"
                [routerLink]="card.route"
              >
                <i class="fas" [ngClass]="card.icon"></i>
                <span>{{ card.title }}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
