<div class="container-fluid">
    <div class="card">
        <div class="card-header" style="text-align: center">
          <div class="clr-row" style="margin-bottom: -10px;">
            <div class="clr-col-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Finish Material Sampling</div>
            <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
              <button class="btn btn-sm" routerLink="/qc/sampling/" style="background-color: red;color: white;">
                CLOSE
              </button>
            </div>
          </div>
        </div>
        <div class="card-block">
            <div class="card-text">
              <div class="clr-row">
                <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-xs-12" *ngIf="isChecker || isApprover">
                  <div class="card clickable" routerLink="allocation">
                    <div class="card-block" style="text-align: center">
                      <img width="50px" height="50px" src="assets/pending.png">
                      <p class="card-text"><b>Sampling Allocation</b></p>
                    </div>
                  </div>
                </div>
  
                <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-xs-12" *ngIf="isUser">
                  <div class="card clickable" routerLink="new">
                    <div class="card-block" style="text-align: center">
                      <img width="50px" height="50px" src="assets/new.png">
                      <p class="card-text"><b>New Sampling</b></p>
                    </div>
                  </div>
                </div>
  
                <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-xs-12" *ngIf="isChecker">
                  <div class="card clickable" routerLink="inprocess">
                    <div class="card-block" style="text-align: center">
                      <img width="50px" height="50px" src="assets/approval.png">
                      <p class="card-text"><b>Samplings for Checking</b></p>
                    </div>
                  </div>
                </div>
  
                <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-xs-12" *ngIf="isApprover">
                  <div class="card clickable" routerLink="checking">
                    <div class="card-block" style="text-align: center">
                      <img width="50px" height="50px" src="assets/approval.png">
                      <p class="card-text"><b>Samplings for Approval</b></p>
                    </div>
                  </div>
                </div>
  
                <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-xs-12">
                  <div class="card clickable" routerLink="log">
                    <div class="card-block" style="text-align: center">
                      <img width="50px" height="50px" src="assets/report.png">
                      <p class="card-text"><b>Samplings Report</b></p>
                    </div>
                  </div>
                </div>

                <div class="clr-col-lg-4 clr-col-md-4 clr-col-sm-12 clr-col-xs-12">
                  <div class="card clickable" routerLink="sample_quantity">
                    <div class="card-block" style="text-align: center">
                      <img width="50px" height="50px" src="assets/report.png">
                      <p class="card-text"><b>Sampling Quantity Master</b></p>
                    </div>
                  </div>
                </div>

              </div>
            </div>
        </div>
    </div>
</div>