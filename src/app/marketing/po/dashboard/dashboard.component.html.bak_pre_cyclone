 

<div class="component">
    <div class="subsection">
      <div class="purchase-block">
        <div style="text-align:end" class="exit-section">
          <div class="header-block" style="margin:10px 0px">
            <h3>Received Purchase Orders</h3>
          <div routerLink="/marketing" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>
  
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="line-section">
              <div class="header-div">
                <h3>Received Purchase Orders section  </h3>
              </div>
            </div>
            <div class="block-container">
                <div class="item-block" *ngIf="isuser=='Yes'" routerLink="new">
                    <i class="fas fa-plus-circle"></i> <!-- Font Awesome icon for New PO Entry -->
                    <span>New PO/FO Entry</span>
                </div>
                <div class="item-block" *ngIf="isuser=='Yes'" routerLink="processing">
                    <i class="fas fa-plus-circle"></i> <!-- Font Awesome icon for New PO/FO Entry -->
                    <span>Processing PO/FO Entry</span>
                </div>
                
                <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="approval">
                    <i class="fas fa-check-circle"></i> <!-- Font Awesome icon for PO Approval -->
                    <span>PO Approval</span>
                </div>
                
                <div class="item-block"   routerLink="log">
                    <i class="fas fa-book"></i> <!-- Font Awesome icon for PO Log -->
                    <span>PO Log</span>
                </div>
                <!-- <div class="item-block"   routerLink="fo">
                    <i class="fas fa-book"></i>  
                    <span>Forcast</span>
                </div> -->
                <div class="item-block"   routerLink="summery">
                    <i class="fas fa-book"></i> <!-- Font Awesome icon for PO Log -->
                    <span>Order Summery</span>
                </div>
                 
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
