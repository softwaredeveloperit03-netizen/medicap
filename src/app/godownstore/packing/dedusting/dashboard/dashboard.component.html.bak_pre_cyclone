<div class="card" *ngIf="!isView">
  <div class="card-header" style="text-align: center">
    <div class="clr-row" style="margin-bottom: -10px;">
      <div class="clr-col-9" style="color: aliceblue;margin-top: -2px;text-align: left;">Dedusting / Cleaning of Packing Material
      </div>
      <div class="clr-col-lg-3" style="text-align: right;padding-right: 0px;margin-top: -7px;">
        <button class="btn btn-success btn-sm" routerLink="new">Awaiting</button>
        <button class="btn btn-sm" routerLink="/godownStore/packing" style="background-color: red;color: white;">
          <clr-icon shape="window-close" class="is-solid"></clr-icon> CLOSE
        </button>
      </div>
    </div>
  </div>
 
        <clr-datagrid>
          
            <clr-dg-column>Sr.</clr-dg-column>
            <clr-dg-column clrDgField="document_no">Receiving No.</clr-dg-column>
            <clr-dg-column>Receiving Date</clr-dg-column>
            <clr-dg-column clrDgField="material_code">Material Code</clr-dg-column>
            <clr-dg-column clrDgField="material_name">Material Name</clr-dg-column>
            <clr-dg-column clrDgField="material_subtype">Material Type</clr-dg-column>
            <clr-dg-column clrDgField="vendor_name">Vendor Name</clr-dg-column>
            <clr-dg-column clrDgField=".grade">Grade</clr-dg-column>
            <!-- <clr-dg-column>Containers</clr-dg-column> -->
            <!-- <th style="text-align: left;">{{'common.status' | translate}}</th> -->
            <clr-dg-column>{{'common.table.action' | translate}}</clr-dg-column>
          
          <clr-dg-row *clrDgItems="let result of results; let i = index" [clrDgItem]="result">
            <clr-dg-cell>{{ i + 1 }}.</clr-dg-cell>
            <clr-dg-cell>{{result.receiving_no}}</clr-dg-cell>
            <clr-dg-cell>{{result.receiving_date | date : 'dd-MM-yyyy'}}</clr-dg-cell>
            <clr-dg-cell>{{ result.material_code }}</clr-dg-cell>
            <clr-dg-cell>{{ result.material_name }}</clr-dg-cell>
            <clr-dg-cell>{{ result.material_subtype }}</clr-dg-cell>
            <clr-dg-cell>{{ result.vendor_name}}</clr-dg-cell>
            <clr-dg-cell>{{ result.grade || 'NA' }}</clr-dg-cell>
            <!-- <clr-dg-cell>{{ result.containers }}</clr-dg-cell> -->
            <!-- <td style="text-align: left;">{{ result.dedusting }}</td> -->
            <clr-dg-cell>
              <button class="btn btn-sm btn-info" (click)="view(i)">{{'common.view' | translate}}</button>
            </clr-dg-cell>
          </clr-dg-row>
          <clr-dg-footer>
            <clr-dg-pagination #pagination [clrDgPageSize]="10">
              <clr-dg-page-size [clrPageSizeOptions]="[10,20,50,100]">Users per page</clr-dg-page-size>
              {{pagination.firstItem + 1}} - {{pagination.lastItem + 1}}
              of {{pagination.totalItems}} Dashboard
            </clr-dg-pagination>
          </clr-dg-footer>
        </clr-datagrid>

        <br>
        <div class="card-footer"><button class="btn btn-primary" (click)="downloadLog()">{{'common.download' | translate}}</button></div>

</div>
 
 


<div class="container-fluid" *ngIf="isView">
  <div class="card">
    <div class="card-header">DEDUSTING /CLEANING LOG</div>
    <div class="card-block">
      <div class="card-text">
        <table class="table table-border">
          <tr>
            <td style="text-align: left;"><b>Material Name:</b></td>
            <td colspan="3" style="text-align: left;">{{ selectedReport['material_name'] }}</td>
          </tr>
          <tr>
            <td style="text-align: left;"><b>Vendor Name:</b></td>
            <td colspan="3" style="text-align: left;">{{ selectedReport['vendor_name'] }}</td>
          </tr>
         
          <tr>
            <td style="text-align: left;"><b>Packaging Slip:</b></td>
            <td style="text-align: left;">{{ selectedReport['challan_no'] }}</td>
            <td style="text-align: left;"><b>Packaging Slip Date:</b></td>
            <td style="text-align: left;">{{ selectedReport['challan_date'] | date : 'dd-MM-yyyy' }}</td>
          </tr>
          <tr>
            <td style="text-align: left;"><b>PO No.:</b></td>
            <td style="text-align: left;">{{ selectedReport['po_no'] }}</td>
            <td style="text-align: left;"><b>PO Date:</b></td>
            <td style="text-align: left;">{{ selectedReport['po_date'] | date : 'dd-MM-yyyy' }}</td>
          </tr>
          <tr>
            <td style="text-align: left;"><b>Material Type:</b></td>
            <td style="text-align: left;">{{ selectedReport['material_type'] }}</td>
            <td style="text-align: left;"><b>Material Subtype:</b></td>
            <td style="text-align: left;">{{ selectedReport['material_name'] }}</td>
          </tr>
          <tr>
            <td style="text-align: left;"><b>Material Code:</b></td>
            <td style="text-align: left;">{{ selectedReport['material_code'] }}</td>
            <td style="text-align: left;"><b>Material Grade:</b></td>
            <td style="text-align: left;">{{ selectedReport['grade']  || 'NA'}}</td>
          </tr>
          <tr>
            <td style="text-align: left;"><b>PO Qty:</b></td>
            <td style="text-align: left; font-weight: bolder;"  >{{ selectedReport['qty'] }} {{selectedReport['unit'] }}</td>
            <td style="text-align: left;"><b>Material For</b></td>
            <td style="text-align: left;" >{{ selectedReport['materialForName'] }} </td>
          </tr>
        </table>
       
        <h3>Dedusting Details:</h3>
        <table class="table table-border">
          <tr>
            <th style="text-align: left; background-color: rgb(14, 67, 112); color: white">Dedusting</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Equipment Code</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Start Time</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">End Time</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Done By</th>
            <th style="background-color: rgb(14, 67, 112); color: white;">Checked By</th>
           </tr>
          <tr>
            <td style="text-align: left;">Vaccume Cleaner</td>
            <td>{{ selectedReport['dedusting_details'].equipment_code }}</td>
            <td>{{ selectedReport['dedusting_details'].from_time }}</td>
            <td>{{ selectedReport['dedusting_details'].to_time }}</td>
            <td>{{ selectedReport['dedusting_details'].operator }}</td>
            <td>{{ selectedReport['dedusting_by'] }} ( {{ selectedReport['dustBy'] || 'NA' }} )</td>
          </tr>
          <tr>
            <td style="text-align: left;">Equipment Cleaning</td>
            <td>{{ selectedReport['dedusting_details'].equipment_code }}</td>
            <td>{{ selectedReport['dedusting_details'].area_cleaned_from }}</td>
            <td>{{ selectedReport['dedusting_details'].area_cleaned_to }}</td>
            <td>{{ selectedReport['dedusting_details'].area_cleaned_by }}</td>
            <td>{{ selectedReport['dedusting_by'] }} ( {{ selectedReport['dustBy'] || 'NA' }} )</td>

           </tr>
          <tr>
            <td style="text-align: left;">Area Cleaning</td>
            <td>{{ selectedReport['dedusting_details'].equipment_code }}</td>
            <td>{{ selectedReport['dedusting_details'].equip_cleaned_from }}</td>
            <td>{{ selectedReport['dedusting_details'].equip_cleaned_to }}</td>
            <td>{{ selectedReport['dedusting_details'].equip_cleaned_by }}</td>
            <td>{{ selectedReport['dedusting_by'] }} ( {{ selectedReport['dustBy'] || 'NA' }} )</td>

           </tr>
        </table>
      </div>
    </div>
    <div class="card-footer">
      <button class="btn btn-danger" (click)="isView = false">{{'common.close' | translate}}</button>
    </div>
  </div>
</div>
