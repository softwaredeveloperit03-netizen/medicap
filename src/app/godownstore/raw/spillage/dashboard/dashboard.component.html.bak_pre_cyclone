  <!------------------------------------------------------------------>
  <div class="component">
    <div class="subsection">
      <div class="purchase-block">
        <div style="text-align:end" class="exit-section">
          <div class="header-block" style="margin:10px 0px">
            <h3>Spillage and Destruction of Raw Material</h3>
          <div routerLink="/godownStore/raw" class="name-board2"><i class="fas fa-times"></i>
          </div>
        </div>
  
        <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
          <div class="category">
            <div class="block-container" style="    
            display: grid;
            grid-template-columns: repeat(6, 150px);
            grid-gap: 35px;
            overflow-x: auto;
            max-width: 100%;">

                <div class="item-block" routerLink="new" *ngIf="isuser == 'Yes'">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>New Spillage</span>
                  </div>
                  
                  <div class="item-block" *ngIf="ischecker=='Yes'" routerLink="checking">
                    <i class="fas fa-check"></i>
                    <span>Checking</span>
                  </div>
                  
                  <div class="item-block" *ngIf="isapprover=='Yes'" routerLink="approval">
                    <i class="fas fa-thumbs-up"></i>
                    <span>Approval</span>
                  </div>
                  
                  <div class="item-block" routerLink="log">
                    <i class="fas fa-book"></i>
                    <span>Spillages Report</span>
                  </div>
                  
                        
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
  