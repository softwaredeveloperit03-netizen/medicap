/* Graph Section Start*/
.line-container {
    display: flex;
    align-items: center;
    width: 90vw;
    overflow-x: auto;
  }
  
  .main-heading-container {
    text-align: center;
    display: flex;
    margin: 0 auto;
    align-items: center;
    justify-content: center;
  }
  
  .main-heading-container h3{
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 10px 0px 0px 0px;
    font-weight: 700;
    border: 1px solid blue;
    border-radius: 5px;
    padding: 3px;
    background: #31318b78;
    color: white;
    font-size: 17px;
  }
  
.heading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 2px 5px;
  background: aliceblue;
  font-weight: 800;
  border-bottom-right-radius: 10px;
  border-top: 2px solid #007bff;
}

.heading h3{
  margin: 0px;
  padding: 2px 5px;
  font-size: 15px;
  font-weight: 700;
}
  
  .graph-container {
    border: 2px solid #ccc;
    border-radius: 5px;
    padding: 10px;
    -webkit-border-radius: 5px;
    -moz-border-radius: 5px;
    -ms-border-radius: 5px;
    -o-border-radius: 5px;
  }
  
  .graph-row {
    display: flex;
    flex-wrap: wrap;
    column-gap: 10px;
    justify-content: center;
  }
  
  .graph-col {
    flex-basis: 45%;
    background: #fff;
    border-radius: 10px;
    margin-top: 10px;
    padding: 0px 10px 10px 10px;
  }
  
  /* For mobile view, set 100% width */
  @media (max-width: 768px) {
    .graph-col {
      flex-basis: 100%;
    }
  }
  /* Graph Section Start*/