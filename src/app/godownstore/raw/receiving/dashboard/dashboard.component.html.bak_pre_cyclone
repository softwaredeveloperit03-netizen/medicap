 

<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>Receiving of Material</h3>
        <div routerLink="/godownStore/raw" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>Receiving of Material Section</h3>
            </div>
          </div>
          <div class="block-container">
            <div class="item-block" routerLink="awaiting">
              <i class="fas fa-box-open"></i>
              <span>Awaiting Materials</span>
            </div>
            
            <div class="item-block" *ngIf="ischecker=='Yes' || isapprover=='Yes'" routerLink="checking">
              <i class="fas fa-check-square"></i>
              <span>Material Checking</span>
            </div>
            
            <div class="item-block" *ngIf="ischecker=='Yes' || isapprover=='Yes'" routerLink="hold">
              <i class="fas fa-pause-circle"></i>
              <span>Hold Material</span>
            </div>
            
            <div class="item-block" routerLink="log">
              <i class="fas fa-book"></i>
              <span>Log Book</span>
            </div>
            
            <div class="item-block" routerLink="rejected">
              <i class="fas fa-times-circle"></i>
              <span>Rejected Materials</span>
            </div>
            
            <div class="item-block" routerLink="label">
              <i class="fas fa-tag"></i>
              <span>Label Printing</span>
            </div>
            
            <!-- <div class="item-block" routerLink="correction">
              <i class="fas fa-pencil-alt"></i>
              <span>Correction</span>
            </div> -->
                          
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>
