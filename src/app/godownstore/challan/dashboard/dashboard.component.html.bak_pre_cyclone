 

<div class="component">
  <div class="subsection">
    <div class="purchase-block">
      <div style="text-align:end" class="exit-section">
        <div class="header-block" style="margin:10px 0px">
          <h3>challan</h3>
        <div routerLink="/godownStore" class="name-board2"><i class="fas fa-times"></i>
        </div>
      </div>

      <div class="main-section" style="margin: 0px 10px 10px 10px !important;">
        <div class="category">
          <div class="line-section">
            <div class="header-div">
              <h3>challan Section</h3>
            </div>
          </div>
          <div class="block-container" style="    
          display: grid;
          grid-template-columns: repeat(6, 150px);
          grid-gap: 35px;
          overflow-x: auto;
          max-width: 100%;">
            <div class="item-block" routerLink="approval">
              <i class="fas fa-sign-in-alt"></i>
              <span>Inwards From Security</span>
            </div>
            
            <div class="item-block"  routerLink="verification">
              <i class="fas fa-clipboard-check"></i>
              <span>Challans Verification</span>
              <div class="badge" *ngIf="challanVeri > 0">{{ challanVeri }}</div>
            </div>
            
            <div class="item-block" routerLink="hold">
              <i class="fas fa-pause-circle"></i>
              <span>On Hold</span>
            </div>
            
            <div class="item-block" routerLink="log">
              <i class="fas fa-clipboard-list"></i>
              <span>Log</span>
            </div>
            <!-- <div class="item-block" routerLink="correction">
              <i class="far fa-edit"></i>
              <span>Correction</span>
            </div>      -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>
