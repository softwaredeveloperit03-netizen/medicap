                        echo "{\"status\":\"'SomeThing Went Wrong Please Try Again After Some Time..'\"}";
                    }
                    
                }else{
                      echo "{\"status\":\"'Your Account not yet approved. Please contact HR'\"}";   
                }
    	    }
        }else{
            echo "{\"status\":\"'Invalid Username Or Password'\"}";
        }
  
}



